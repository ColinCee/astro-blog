---
// Blog post reading layout. Uses the shared terminal Base shell (dark, Nav +
// SiteFooter) so posts match the rest of the site, then styles the rendered
// Markdown as terminal-native prose. Fenced code is handled by Expressive Code.
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"] & { minutesRead?: number };
const { title, description, pubDate, updatedDate, minutesRead } = Astro.props;
---

<Base title={`${title} · Colin Cheung`} description={description} ogType="article">
  <article class="post">
    <header class="post__head">
      <a class="post__back" href="/blog">// writing</a>
      <h1 class="post__title">{title}</h1>
      <p class="post__meta">
        <FormattedDate date={pubDate} />
        {
          minutesRead && (
            <>
              <span class="post__dot" aria-hidden="true">·</span>
              <span>{minutesRead} min read</span>
            </>
          )
        }
        {
          updatedDate && (
            <>
              <span class="post__dot" aria-hidden="true">·</span>
              <span>updated <FormattedDate date={updatedDate} /></span>
            </>
          )
        }
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post__foot">
      <a class="post__more" href="/blog"><span aria-hidden="true">←</span> more writing</a>
    </footer>
  </article>
</Base>

<style>
  .post {
    max-width: var(--w-prose);
    margin: 0 auto;
  }
  .post__head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .post__back {
    display: inline-block;
    margin-bottom: 1.4rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-soft);
    transition: color 0.16s ease;
  }
  .post__back:hover {
    color: var(--accent);
  }
  .post__title {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 800;
    font-size: clamp(2rem, 5.5vw, 3.1rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .post__meta {
    margin: 1.1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.7rem;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }
  .post__dot {
    color: var(--line);
  }
  .post__foot {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .post__more {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--accent-soft);
    transition: color 0.16s ease;
  }
  .post__more:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .post__head,
    .prose,
    .post__foot {
      animation: rise 0.5s ease-out both;
    }
    .prose {
      animation-delay: 0.05s;
    }
    .post__foot {
      animation-delay: 0.1s;
    }
  }
</style>

<style is:global>
  /* Prose: terminal-native long-form, scoped under .prose. Slotted Markdown is
     not reachable by scoped styles, so these are global but namespaced. */
  .prose {
    --prose-ink: oklch(0.87 0.012 95);
    font-size: 1.06rem;
    line-height: 1.72;
    color: var(--prose-ink);
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose p {
    margin: 1.15rem 0;
    text-wrap: pretty;
  }
  .prose h2 {
    margin: 2.6rem 0 0.85rem;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: clamp(1.35rem, 3vw, 1.6rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .prose h3 {
    margin: 2rem 0 0.7rem;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
  }
  .prose a {
    color: var(--accent-soft);
    border-bottom: 1px solid color-mix(in oklch, var(--accent) 40%, transparent);
    transition:
      color 0.16s ease,
      border-color 0.16s ease;
  }
  .prose a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .prose strong {
    color: var(--ink);
    font-weight: 700;
  }
  .prose em {
    font-style: italic;
  }
  .prose ul,
  .prose ol {
    margin: 1.15rem 0;
    padding-left: 1.35rem;
  }
  .prose li {
    margin: 0.45rem 0;
  }
  .prose li::marker {
    color: var(--accent-soft);
  }
  .prose blockquote {
    margin: 1.5rem 0;
    padding: 0.3rem 0 0.3rem 1.15rem;
    border-left: 2px solid color-mix(in oklch, var(--accent) 45%, transparent);
    color: var(--muted);
  }
  .prose hr {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  /* Inline code only. Fenced blocks are styled by Expressive Code. */
  .prose :not(pre) > code {
    font-family: var(--mono);
    font-size: 0.86em;
    padding: 0.1em 0.38em;
    border-radius: 4px;
    background: color-mix(in oklch, var(--ink) 10%, transparent);
    color: var(--ink);
  }
  .prose .expressive-code {
    margin: 1.6rem 0;
  }
</style>
