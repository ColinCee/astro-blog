---
// The shell every page sits in: the shared head, nav and footer around the
// page's content, on the site's surface, dark unless the visitor chose light
// (Head.astro sets it before paint, the nav button toggles it). `home` widens the frame to the poster width for the homepage.
import "../styles/tokens.css";
import Footer from "../components/site/Footer.astro";
import Head from "../components/site/Head.astro";
import Nav from "../components/site/Nav.astro";

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  ogType?: string;
  article?: { headline: string; published: Date; modified?: Date };
  home?: boolean;
}
const { home = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...head} person={home} />
  </head>

  <body>
    <div class:list={["shell", { "shell--home": home }]}>
      <Nav home={home} />
      <main class="shell__main">
        <slot />
      </main>
      <Footer home={home} />
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }

  .shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    /* biome-ignore lint/suspicious/noDuplicateProperties: 100vh above is the fallback where svh is unsupported */
    min-height: 100svh;
    padding: 1.1rem clamp(1rem, 4vw, 3rem) 3rem;
    background: var(--wash), var(--bg);
    color: var(--ink);
    font-family: var(--grotesk);
    font-feature-settings: "ss01";
    -webkit-font-smoothing: antialiased;
  }
  /* Push the footer to the bottom when content is short. */
  .shell__main {
    flex: 1 0 auto;
  }
  /* The homepage: its backdrop is drawn behind the whole shell, and it ends
     with more room under the footer. */
  .shell--home {
    position: relative;
    isolation: isolate;
    padding-bottom: clamp(5rem, 9vw, 6.5rem);
  }

  :where(.shell) :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .shell *,
    .shell *::before,
    .shell *::after {
      animation-duration: 0.001ms !important;
      animation-delay: 0s !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
