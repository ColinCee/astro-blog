---
// Ambient LED-dot background. A fixed, full-viewport <canvas> painted behind
// all page content (no card/border — it blends into the background). Runs one
// of three binary dot animations (Life / Snake / Tetris), chosen at random on
// load and rotated every ~20s with a soft fade. Dim + aria-hidden + decorative.
interface Props {
  /** dim opacity of lit dots (0..1) */
  opacity?: number;
  /** grid pitch in CSS px */
  pitch?: number;
  /** ms between animation swaps */
  rotateMs?: number;
}
const { opacity = 0.15, pitch = 15, rotateMs = 20000 } = Astro.props;
---

<canvas
  class="ledbg"
  data-ledfield
  data-opacity={opacity}
  data-pitch={pitch}
  data-rotate={rotateMs}
  aria-hidden="true"></canvas>

<style>
  .ledbg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<style is:global>
  /* Move the page backdrop to <html> so the fixed z-index:-1 canvas shows
     above it, and let the shell/content be transparent on top of the dots. */
  html {
    background:
      radial-gradient(
        48rem 36rem at 88% -8%,
        color-mix(in oklch, var(--accent) 12%, transparent),
        transparent 60%
      ),
      var(--bg);
  }
  .shell {
    background: transparent !important;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-ledfield]");
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const opacity = Number(canvas.dataset.opacity) || 0.15;
    const pitch = Number(canvas.dataset.pitch) || 15;
    const rotateMs = Number(canvas.dataset.rotate) || 20000;
    const dot = Math.max(3, Math.round(pitch * 0.5));

    const resolve = (v: string): [number, number, number] => {
      const c = document.createElement("canvas");
      c.width = c.height = 1;
      const x = c.getContext("2d")!;
      x.fillStyle = "#000";
      x.fillStyle = v.trim();
      x.fillRect(0, 0, 1, 1);
      const d = x.getImageData(0, 0, 1, 1).data;
      return [d[0], d[1], d[2]];
    };
    const A = resolve(getComputedStyle(document.documentElement).getPropertyValue("--accent"));

    const ANIMS = ["life", "snake", "tetris"] as const;
    type Anim = (typeof ANIMS)[number];
    let anim: Anim = ANIMS[Math.floor(Math.random() * ANIMS.length)];

    let gw = 0,
      gh = 0,
      cssW = 0,
      cssH = 0;
    let grid = new Uint8Array(0);
    let scratch = new Uint8Array(0);
    let board = new Uint8Array(0);
    const idx = (x: number, y: number) => y * gw + x;
    const ri = (n: number) => Math.floor(Math.random() * n);

    // ---- Life ----
    let lifeStable = 0;
    const lifeSeed = () => {
      for (let i = 0; i < grid.length; i++) grid[i] = Math.random() < 0.3 ? 1 : 0;
      lifeStable = 0;
    };
    const lifeStep = () => {
      let pop = 0,
        changes = 0;
      for (let y = 0; y < gh; y++)
        for (let x = 0; x < gw; x++) {
          let n = 0;
          for (let dy = -1; dy <= 1; dy++)
            for (let dx = -1; dx <= 1; dx++) {
              if (!dx && !dy) continue;
              n += grid[idx((x + dx + gw) % gw, (y + dy + gh) % gh)];
            }
          const a = grid[idx(x, y)];
          const next = a ? (n === 2 || n === 3 ? 1 : 0) : n === 3 ? 1 : 0;
          scratch[idx(x, y)] = next;
          if (next) pop++;
          if (next !== a) changes++;
        }
      const t = grid;
      grid = scratch;
      scratch = t;
      if (changes < gw * gh * 0.01 || pop < gw * gh * 0.02) lifeStable++;
      else lifeStable = 0;
      if (lifeStable > 10) {
        const rx = ri(Math.max(1, gw - 10)),
          ry = ri(Math.max(1, gh - 10));
        for (let y = 0; y < Math.min(10, gh); y++)
          for (let x = 0; x < Math.min(10, gw); x++)
            grid[idx((rx + x) % gw, (ry + y) % gh)] = Math.random() < 0.5 ? 1 : 0;
        lifeStable = 0;
      }
    };

    // ---- Snake ----
    let snake: { x: number; y: number }[] = [];
    let sdir = { x: 1, y: 0 };
    let food = { x: 0, y: 0 };
    let sdead = 0;
    let stick = 0;
    const placeFood = () => {
      const b = new Set(snake.map((s) => idx(s.x, s.y)));
      let n = 0;
      do {
        food = { x: ri(gw), y: ri(gh) };
        n++;
      } while (b.has(idx(food.x, food.y)) && n < 300);
    };
    const snakeSeed = () => {
      const cy = (gh / 2) | 0,
        cx = (gw / 2) | 0;
      snake = [
        { x: cx, y: cy },
        { x: cx - 1, y: cy },
        { x: cx - 2, y: cy },
        { x: cx - 3, y: cy },
      ];
      sdir = { x: 1, y: 0 };
      sdead = 0;
      placeFood();
    };
    const snakeStep = () => {
      stick++;
      if (sdead > 0) {
        sdead--;
        if (sdead === 0) snakeSeed();
        return;
      }
      const head = snake[0],
        tail = snake[snake.length - 1];
      const body = new Set(snake.map((s) => idx(s.x, s.y)));
      const dist = (x: number, y: number) => {
        let dx = Math.abs(x - food.x);
        dx = Math.min(dx, gw - dx);
        let dy = Math.abs(y - food.y);
        dy = Math.min(dy, gh - dy);
        return dx + dy;
      };
      const opts = [
        { x: 1, y: 0 },
        { x: -1, y: 0 },
        { x: 0, y: 1 },
        { x: 0, y: -1 },
      ];
      let best: { d: { x: number; y: number }; nx: number; ny: number } | null = null;
      let bd = Infinity;
      for (const d of opts) {
        if (d.x === -sdir.x && d.y === -sdir.y) continue;
        const nx = (head.x + d.x + gw) % gw,
          ny = (head.y + d.y + gh) % gh;
        if (body.has(idx(nx, ny)) && !(nx === tail.x && ny === tail.y)) continue;
        const dd = dist(nx, ny);
        if (dd < bd) {
          bd = dd;
          best = { d, nx, ny };
        }
      }
      if (!best) {
        sdead = 6;
        return;
      }
      sdir = best.d;
      snake.unshift({ x: best.nx, y: best.ny });
      if (best.nx === food.x && best.ny === food.y) placeFood();
      else snake.pop();
      grid.fill(0);
      for (const s of snake) grid[idx(s.x, s.y)] = 1;
      if (stick % 6 < 4) grid[idx(food.x, food.y)] = 1;
    };

    // ---- Tetris (auto-player) ----
    let wellX = 0,
      WELL = 12;
    const tet = { type: "T", rot: 0, x: 0, y: 0, tRot: 0, tX: 0, over: false };
    const PIECES: Record<string, number[][][]> = {
      I: [[[0, 1], [1, 1], [2, 1], [3, 1]], [[2, 0], [2, 1], [2, 2], [2, 3]]],
      O: [[[1, 0], [2, 0], [1, 1], [2, 1]]],
      T: [
        [[1, 0], [0, 1], [1, 1], [2, 1]],
        [[1, 0], [1, 1], [2, 1], [1, 2]],
        [[0, 1], [1, 1], [2, 1], [1, 2]],
        [[1, 0], [0, 1], [1, 1], [1, 2]],
      ],
      S: [[[1, 0], [2, 0], [0, 1], [1, 1]], [[1, 0], [1, 1], [2, 1], [2, 2]]],
      Z: [[[0, 0], [1, 0], [1, 1], [2, 1]], [[2, 0], [1, 1], [2, 1], [1, 2]]],
      J: [
        [[0, 0], [0, 1], [1, 1], [2, 1]],
        [[1, 0], [2, 0], [1, 1], [1, 2]],
        [[0, 1], [1, 1], [2, 1], [2, 2]],
        [[1, 0], [1, 1], [0, 2], [1, 2]],
      ],
      L: [
        [[2, 0], [0, 1], [1, 1], [2, 1]],
        [[1, 0], [1, 1], [1, 2], [2, 2]],
        [[0, 1], [1, 1], [2, 1], [0, 2]],
        [[0, 0], [1, 0], [1, 1], [1, 2]],
      ],
    };
    const TYPES = ["I", "O", "T", "S", "Z", "J", "L"];
    const cellsOf = (ty: string, rot: number, px: number, py: number) =>
      PIECES[ty][rot % PIECES[ty].length].map(
        ([cx, cy]) => [px + cx, py + cy] as [number, number],
      );
    const hits = (cells: [number, number][]) => {
      for (const [x, y] of cells) {
        if (x < wellX || x >= wellX + WELL || y >= gh) return true;
        if (y >= 0 && board[idx(x, y)]) return true;
      }
      return false;
    };
    const dropY = (ty: string, rot: number, px: number) => {
      let py = -4;
      while (!hits(cellsOf(ty, rot, px, py + 1))) py++;
      return py;
    };
    const score = (cells: [number, number][]) => {
      const tmp = new Uint8Array(board);
      for (const [x, y] of cells) {
        if (y < 0) return -1e9;
        tmp[idx(x, y)] = 1;
      }
      const h = new Array(WELL).fill(0);
      let holes = 0;
      for (let c = 0; c < WELL; c++) {
        let seen = false;
        for (let y = 0; y < gh; y++) {
          if (tmp[idx(wellX + c, y)]) {
            if (!seen) {
              seen = true;
              h[c] = gh - y;
            }
          } else if (seen) holes++;
        }
      }
      let lines = 0;
      for (let y = 0; y < gh; y++) {
        let full = true;
        for (let c = 0; c < WELL; c++)
          if (!tmp[idx(wellX + c, y)]) {
            full = false;
            break;
          }
        if (full) lines++;
      }
      let agg = 0,
        bump = 0;
      for (let c = 0; c < WELL; c++) {
        agg += h[c];
        if (c < WELL - 1) bump += Math.abs(h[c] - h[c + 1]);
      }
      return -0.51 * agg + 0.76 * lines - 0.36 * holes - 0.18 * bump;
    };
    const bestMove = (ty: string) => {
      let best: { rot: number; x: number } | null = null;
      let bs = -Infinity;
      for (let rot = 0; rot < PIECES[ty].length; rot++)
        for (let px = wellX - 3; px < wellX + WELL; px++) {
          const flat = cellsOf(ty, rot, px, 0);
          if (flat.some(([x]) => x < wellX || x >= wellX + WELL)) continue;
          const s = score(cellsOf(ty, rot, px, dropY(ty, rot, px)));
          if (s > bs) {
            bs = s;
            best = { rot, x: px };
          }
        }
      return best;
    };
    const tetSpawn = () => {
      tet.type = TYPES[ri(TYPES.length)];
      tet.rot = 0;
      tet.x = wellX + ((WELL / 2) | 0) - 2;
      tet.y = 0;
      const b = bestMove(tet.type);
      if (!b || hits(cellsOf(tet.type, 0, tet.x, tet.y))) tet.over = true;
      else {
        tet.tRot = b.rot;
        tet.tX = b.x;
      }
    };
    const tetCompose = () => {
      grid.fill(0);
      grid.set(board);
      for (const [x, y] of cellsOf(tet.type, tet.rot, tet.x, tet.y))
        if (x >= 0 && x < gw && y >= 0 && y < gh) grid[idx(x, y)] = 1;
    };
    const tetLock = () => {
      for (const [x, y] of cellsOf(tet.type, tet.rot, tet.x, tet.y)) {
        if (y < 0) {
          tet.over = true;
          return;
        }
        board[idx(x, y)] = 1;
      }
      let w = gh - 1;
      for (let y = gh - 1; y >= 0; y--) {
        let full = true;
        for (let c = 0; c < WELL; c++)
          if (!board[idx(wellX + c, y)]) {
            full = false;
            break;
          }
        if (!full) {
          if (w !== y)
            for (let c = 0; c < WELL; c++)
              board[idx(wellX + c, w)] = board[idx(wellX + c, y)];
          w--;
        }
      }
      for (; w >= 0; w--) for (let c = 0; c < WELL; c++) board[idx(wellX + c, w)] = 0;
      tetSpawn();
    };
    const tetSeed = () => {
      board.fill(0);
      WELL = Math.min(gw, 14);
      wellX = ((gw - WELL) / 2) | 0;
      tet.over = false;
      tetSpawn();
      tetCompose();
    };
    const tetStep = () => {
      if (tet.over) {
        board.fill(0);
        tet.over = false;
        tetSpawn();
        tetCompose();
        return;
      }
      if (tet.rot !== tet.tRot) tet.rot = (tet.rot + 1) % PIECES[tet.type].length;
      else if (tet.x < tet.tX) tet.x++;
      else if (tet.x > tet.tX) tet.x--;
      else if (!hits(cellsOf(tet.type, tet.rot, tet.x, tet.y + 1))) tet.y++;
      else tetLock();
      tetCompose();
    };

    const seed = () => {
      grid.fill(0);
      if (anim === "life") lifeSeed();
      else if (anim === "snake") snakeSeed();
      else tetSeed();
    };
    const step = () => {
      const a = anim as string;
      if (a === "life") lifeStep();
      else if (a === "snake") snakeStep();
      else tetStep();
    };
    const interval = () => (anim === "life" ? 110 : anim === "snake" ? 90 : 70);

    let fade = 1;
    const draw = () => {
      ctx.clearRect(0, 0, cssW, cssH);
      ctx.fillStyle = `rgba(${A[0]},${A[1]},${A[2]},${(opacity * fade).toFixed(3)})`;
      const pad = (pitch - dot) / 2;
      for (let y = 0; y < gh; y++)
        for (let x = 0; x < gw; x++)
          if (grid[idx(x, y)])
            ctx.fillRect(Math.round(x * pitch + pad), Math.round(y * pitch + pad), dot, dot);
    };

    const resize = () => {
      cssW = Math.max(1, window.innerWidth);
      cssH = Math.max(1, window.innerHeight);
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      gw = Math.max(8, Math.floor(cssW / pitch));
      gh = Math.max(8, Math.floor(cssH / pitch));
      grid = new Uint8Array(gw * gh);
      scratch = new Uint8Array(gw * gh);
      board = new Uint8Array(gw * gh);
      seed();
      draw();
    };

    window.addEventListener("resize", resize);
    resize();

    if (reduce) {
      for (let i = 0; i < 30; i++) step();
      draw();
    } else {
      let acc = 0,
        last = performance.now(),
        nextSwap = last + rotateMs,
        phase: "run" | "out" | "in" = "run";
      const loop = (t: number) => {
        const dt = Math.min(48, t - last);
        last = t;
        if (phase === "run" && t > nextSwap) phase = "out";
        if (phase === "out") {
          fade -= dt / 600;
          if (fade <= 0) {
            fade = 0;
            const others = ANIMS.filter((x) => x !== anim);
            anim = others[Math.floor(Math.random() * others.length)];
            seed();
            phase = "in";
          }
        } else if (phase === "in") {
          fade += dt / 600;
          if (fade >= 1) {
            fade = 1;
            phase = "run";
            nextSwap = t + rotateMs;
          }
        }
        acc += dt;
        const iv = interval();
        while (acc >= iv) {
          step();
          acc -= iv;
        }
        draw();
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
