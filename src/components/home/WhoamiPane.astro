---
// The terminal's left pane: who I am, as a real shell session that types
// itself out on load. Everything is in the HTML; without JS or with reduced
// motion the finished session shows.
import { getCollection } from "astro:content";
import Pane from "./Pane.astro";
import BrandIcon from "./BrandIcon.astro";
import links from "../../data/links.json";

const name = "Colin Cheung";
const nameCjk = "張志權";
const whoLine = "Open to remote · UK-based";
const nowLine = "Tech lead @ EDF Energy, leading AI adoption across the team.";

// Core skills as a `top` process list. TIME+ is years of experience (now −
// since), highest first: a real number, no invented scores.
const nowYear = new Date().getFullYear();
const procs = (await getCollection("skills"))
  .map((s) => ({
    name: s.id,
    since: s.data.since,
    years: nowYear - s.data.since,
  }))
  .sort((a, b) => b.years - a.years);

// Classic shell greeting, at build time.
const at = new Date();
const days = "Sun Mon Tue Wed Thu Fri Sat".split(" ");
const months = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(" ");
const hh = String(at.getHours()).padStart(2, "0");
const mm = String(at.getMinutes()).padStart(2, "0");
const lastLogin = `${days[at.getDay()]} ${months[at.getMonth()]} ${at.getDate()} ${hh}:${mm}`;
---

<Pane idx={0} name="whoami" area="who">
  <div class="who__session" aria-label="Colin, as a terminal session">
    <p class="who__login">Last login: {lastLogin} on ttys001</p>
    <!-- prettier-ignore -->
    <p class="term-cmd">
      <span class="who__prompt">$</span>
      <span class="who__typed js-cmd">whoami</span><span class="who__caret"></span>
    </p>
    <div class="term-out js-out">
      <p class="who__name">
        {name}
        <span class="cjk" lang="zh-Hant">
          {nameCjk}
        </span>
      </p>
      <p class="who__sub">{whoLine}</p>
    </div>

    <!-- prettier-ignore -->
    <p class="term-cmd">
      <span class="who__prompt">$</span>
      <span class="who__typed js-cmd">top -u colin</span><span class="who__caret"></span>
    </p>
    <div class="term-out js-out who__mon">
      <div class="who__cols">
        <span>COMMAND</span>
        <span>SINCE</span>
        <span>TIME+</span>
      </div>
      {procs.map((p) => (
        <div class="who__proc">
          <span class="who__pname">{p.name}</span>
          <span class="who__psince">{p.since}</span>
          <span class="who__ptime">{p.years}y</span>
        </div>
      ))}
    </div>

    <!-- prettier-ignore -->
    <p class="term-cmd">
      <span class="who__prompt">$</span>
      <span class="who__typed js-cmd">cat now.md</span><span class="who__caret"></span>
    </p>
    <div class="term-out js-out">
      <p class="who__now">{nowLine}</p>
    </div>

    <!-- prettier-ignore -->
    <p class="term-cmd">
      <span class="who__prompt">$</span>
      <span class="who__typed js-cmd">weather</span><span class="who__caret"></span>
    </p>
    <div class="term-out js-out">
      <p class="who__wx" data-weather>
        Glasgow
      </p>
    </div>

    <!-- prettier-ignore -->
    <p class="term-cmd">
      <span class="who__prompt">$</span>
      <span class="who__typed js-cmd">ls ~/contact</span><span class="who__caret"></span>
    </p>
    <div class="term-out js-out who__links">
      <a href={links.github}>
        <BrandIcon name="github" class="ico" />
        github.com/ColinCee
      </a>
      <a href={links.linkedin}>
        <BrandIcon name="linkedin" class="ico" />
        linkedin.com/in/colin-cheung
      </a>
    </div>

    <p class="term-cmd term-cmd--rest">
      <span class="who__prompt">$</span>
      <span class="who__caret"></span>
    </p>
  </div>
</Pane>

<style>
  .who__session {
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.55;
  }
  .who__login {
    margin: 0 0 0.7rem;
    color: var(--faint);
  }
  .term-cmd {
    margin: 0;
    white-space: nowrap;
    color: var(--ink);
    transition: opacity 0.25s ease;
  }
  .is-booting .term-cmd {
    opacity: 0;
  }
  .term-cmd.is-in {
    opacity: 1;
  }
  .who__prompt {
    color: var(--accent);
    margin-right: 0.5ch;
  }
  .who__typed {
    color: var(--muted);
  }
  .who__caret {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    margin-left: 1px;
    vertical-align: -0.13em;
    background: var(--accent);
    animation: caret 1.05s steps(1, end) infinite;
  }
  .term-cmd .who__caret {
    display: none;
  }
  .term-cmd--rest .who__caret,
  .term-cmd.is-typing .who__caret {
    display: inline-block;
  }
  @keyframes caret {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }
  .term-out {
    margin: 0.25rem 0 0.95rem;
  }
  .who__name {
    margin: 0;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .who__name .cjk {
    font-family: var(--cjk);
    color: var(--accent-soft);
    margin-left: 0.45ch;
    letter-spacing: 0.04em;
  }
  .who__sub {
    margin: 0.12rem 0 0;
    color: var(--muted);
  }
  .who__mon {
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .who__cols,
  .who__proc {
    display: grid;
    grid-template-columns: 9.4rem 3.2rem auto;
    gap: 0.6rem;
    align-items: baseline;
  }
  .who__cols {
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }
  .who__proc {
    padding: 0.06rem 0;
  }
  .who__pname {
    color: var(--ink);
  }
  .who__psince,
  .who__ptime {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .who__now {
    margin: 0;
    color: var(--ink);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .who__wx {
    margin: 0;
    color: var(--ink);
  }
  .who__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.4rem;
  }
  .who__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.55ch;
    color: var(--accent);
    transition: color var(--dur-fast) var(--ease);
  }
  .who__links :global(.ico) {
    width: 0.95em;
    height: 0.95em;
    fill: currentColor;
    flex: none;
  }
  .who__links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* boot choreography — enhances the SSR-visible default */
  .js-out {
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .is-booting .js-out {
    opacity: 0;
    transform: translateY(3px);
  }
  .js-out.is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .who__caret {
      animation: none;
    }
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Live Glasgow weather (open-meteo, no API key).
  const wxEl = document.querySelector<HTMLElement>("[data-weather]");
  if (wxEl) {
    type WeatherResponse = {
      current?: { temperature_2m?: unknown; weather_code?: number };
    };
    // WMO weather code → words and an icon.
    const wx: Record<number, [string, string]> = {
      0: ["clear", "☀️"],
      1: ["mainly clear", "🌤️"],
      2: ["partly cloudy", "⛅"],
      3: ["overcast", "☁️"],
      45: ["fog", "🌫️"],
      48: ["fog", "🌫️"],
      51: ["light drizzle", "🌦️"],
      53: ["drizzle", "🌦️"],
      55: ["heavy drizzle", "🌧️"],
      56: ["freezing drizzle", "🌧️"],
      57: ["freezing drizzle", "🌧️"],
      61: ["light rain", "🌧️"],
      63: ["rain", "🌧️"],
      65: ["heavy rain", "🌧️"],
      66: ["freezing rain", "🌧️"],
      67: ["freezing rain", "🌧️"],
      71: ["light snow", "🌨️"],
      73: ["snow", "🌨️"],
      75: ["heavy snow", "❄️"],
      77: ["snow grains", "🌨️"],
      80: ["light showers", "🌦️"],
      81: ["showers", "🌧️"],
      82: ["heavy showers", "🌧️"],
      85: ["snow showers", "🌨️"],
      86: ["snow showers", "🌨️"],
      95: ["thunderstorm", "⛈️"],
      96: ["thunderstorm", "⛈️"],
      99: ["thunderstorm", "⛈️"],
    };
    fetch(
      "https://api.open-meteo.com/v1/forecast?latitude=55.8642&longitude=-4.2518&current=temperature_2m,weather_code",
    )
      .then((r) => r.json())
      .then((d: WeatherResponse) => {
        const c = d.current;
        if (
          !c ||
          typeof c.temperature_2m !== "number" ||
          typeof c.weather_code !== "number"
        ) {
          return;
        }
        const temp = Math.round(c.temperature_2m);
        const [desc, icon] = wx[c.weather_code] ?? ["", ""];
        wxEl.textContent = `Glasgow · ${icon ? icon + " " : ""}${temp}°C${desc ? " · " + desc : ""}`;
      })
      .catch(() => {});
  }

  // Boot the session: reveal each prompt, type its command, then reveal the
  // output, one block at a time, like a real shell.
  const session = document.querySelector<HTMLElement>(".who__session");
  if (session && !reduce) {
    const cmds = Array.from(session.querySelectorAll<HTMLElement>(".js-cmd"));
    const outs = Array.from(session.querySelectorAll<HTMLElement>(".js-out"));
    const lines = cmds.map((c) => c.closest<HTMLElement>(".term-cmd"));
    const rest = session.querySelector<HTMLElement>(".term-cmd--rest");
    session.classList.add("is-booting");
    cmds.forEach((c) => {
      c.dataset.text = c.textContent || "";
      c.textContent = "";
    });
    const finish = () => {
      session.classList.remove("is-booting");
      cmds.forEach((c) => (c.textContent = c.dataset.text || ""));
      lines.forEach((l) => l?.classList.add("is-in"));
      outs.forEach((o) => o.classList.add("is-in"));
      rest?.classList.add("is-in");
    };
    const failsafe = window.setTimeout(finish, 9000);
    let step = 0;
    const run = () => {
      if (step >= cmds.length) {
        window.clearTimeout(failsafe);
        rest?.classList.add("is-in");
        session.classList.remove("is-booting");
        return;
      }
      const cmd = cmds[step];
      const line = lines[step];
      line?.classList.add("is-in");
      line?.classList.add("is-typing");
      const full = cmd.dataset.text || "";
      let i = 0;
      const type = () => {
        cmd.textContent = full.slice(0, (i += 1));
        if (i < full.length) {
          window.setTimeout(type, 60);
          return;
        }
        line?.classList.remove("is-typing");
        const out = outs[step];
        if (out) {
          window.setTimeout(() => {
            out.classList.add("is-in");
            step += 1;
            window.setTimeout(run, 260);
          }, 150);
        } else {
          step += 1;
          window.setTimeout(run, 220);
        }
      };
      window.setTimeout(type, 220);
    };
    run();
  }
</script>
