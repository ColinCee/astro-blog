---
// The homepage's writing section: the newest post as a lead panel with its
// headline figure outlined behind it, the next two as rows, then all posts.
import { getCollection } from "astro:content";

const latest = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const [lead, ...rest] = latest.map((p) => ({
  title: p.data.title,
  stat: p.data.stat,
  statLabel: p.data.statLabel,
  date: p.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  }),
  href: `/blog/${p.id}/`,
}));
// The lead's result: the part of its stat after the arrow ("11 min").
const leadFig = lead?.stat ? lead.stat.split("→").pop()!.trim() : "";
---

<section class="feat" aria-label="Latest writing" data-reveal>
  <p class="feat__tag">// writing</p>
  <div class="feat__grid">
    {lead && (
      <a class="lead" href={lead.href}>
        {leadFig && (
          <span class="lead__fig" aria-hidden="true">
            {leadFig}
          </span>
        )}
        <span class="lead__meta">
          <span class="lead__new">latest</span>
          {lead.date}
        </span>
        <span class="lead__title">{lead.title}</span>
        <span class="lead__foot">
          <span class="lead__stat">
            {lead.stat && <span class="chip">{lead.stat}</span>}
            {lead.statLabel && (
              <span class="lead__label">{lead.statLabel}</span>
            )}
          </span>
          <span class="feat__go">
            read <span aria-hidden="true">→</span>
          </span>
        </span>
      </a>
    )}
    <ul class="rows">
      {rest.map((p) => (
        <li>
          <a class="row" href={p.href}>
            <span class="row__date">{p.date}</span>
            <span class="row__body">
              <span class="row__title">{p.title}</span>
            </span>
            {p.stat && <span class="chip">{p.stat}</span>}
          </a>
        </li>
      ))}
      <li>
        <a class="row row--all" href="/blog/">
          <span class="row__date"></span>
          <span class="row__body">
            <span class="row__title">All posts</span>
          </span>
          <span class="feat__go">
            <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .feat {
    max-width: var(--w-poster);
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) 0 0;
  }
  .feat__tag {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 0 clamp(0.9rem, 2vw, 1.3rem);
  }
  .feat__grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem) clamp(1.6rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 900px) {
    .feat__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }
  /* The stat chip: the post's headline number as a mono readout. */
  .chip {
    flex: none;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--accent-soft);
    background: color-mix(in oklch, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--accent) 22%, transparent);
    border-radius: 999px;
    padding: 0.18rem 0.7rem;
  }
  .feat__go {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }
  .feat__go span {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease);
  }
  a:hover > .feat__go span,
  a:hover .lead__foot .feat__go span {
    transform: translateX(4px);
  }

  .lead {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 0.8rem;
    padding: clamp(1.2rem, 2.6vw, 2rem);
    background: var(--pane);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition:
      transform var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .lead:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  /* The lead post's result, outlined behind its text. */
  .lead__fig {
    position: absolute;
    right: -0.04em;
    bottom: -0.2em;
    font-family: var(--grotesk);
    font-weight: 800;
    font-size: clamp(4.5rem, 7.5vw, 7rem);
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklch, var(--ink) 16%, transparent);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .lead > :not(.lead__fig) {
    position: relative;
  }
  .lead__meta,
  .row__date {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .lead__meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .lead__new {
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: 4px;
    padding: 0.1rem 0.45rem;
  }
  .lead__title {
    font-weight: 600;
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
    margin-top: clamp(0.6rem, 2vw, 1.6rem);
  }
  /* The lead's stat, with what it measures beside it. */
  .lead__stat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
  }
  .lead__label {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--faint);
  }
  .lead__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .rows {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr) auto;
    gap: 0.3rem 1rem;
    align-items: baseline;
    padding: 1.05rem 0.6rem;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-fast) var(--ease);
  }
  .row:hover {
    background: color-mix(in oklch, var(--accent) 7%, transparent);
  }
  .row__body {
    display: grid;
    gap: 0.2rem;
  }
  .row__title {
    font-weight: 600;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .row--all .row__title {
    color: var(--accent-soft);
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .row__date {
      grid-column: 1 / -1;
    }
    .row__date:empty {
      display: none;
    }
  }
</style>
