---
// A cloud outline (the internet, Cloudflare's edge): five bumps on a flat
// base. `box` is the part of the drawing to show, so the same path serves as
// a big cloud with words in it and as a small node on a line. It stretches to
// whatever box the caller gives it, and the caller colours the path.
interface Props {
  box: string;
}
const { box } = Astro.props;
---

<svg viewBox={box} preserveAspectRatio="none" aria-hidden="true">
  <path
    d="M50 104A24 24 0 1 1 58 57.4A30 30 0 0 1 100.5 30.7A36 36 0 0 1 168.5 33.7A28 28 0 0 1 205.7 56.1A24 24 0 0 1 204 104Z"
  ></path>
</svg>
