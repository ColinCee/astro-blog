---
// The home lab's figure: the internet, a tunnel, and the one box at home with
// its Compose stacks as key/value rows, each stack's first few services as
// chips and then how many more. The stacks are what the home server says it
// has deployed (window/data.ts has where the build gets them); when the
// page hears from the server it draws them again from the server's list
// (window/lab.ts), so a stack deployed or taken down shows here with no
// change to this site. Also live, from /homelab.json (window/stats.ts): the
// number of planes the flight-tracker stack is following, and in the box's
// top border whether every stack is up and how old that news is. Until it
// arrives the number is a dash and the label is not there.
import { homeStacks } from "../data";
import { chips } from "../lab";
import Cloud from "./Cloud.astro";

const stacks = await homeStacks();
---

<div class="lab" data-lab>
  <div class="lab__cloud">
    <Cloud box="20 4 214 108" />
    <span>internet</span>
  </div>
  <div class="lab__tun">
    <span><i>cloudflare tunnel</i></span>
  </div>
  <div class="lab__host">
    <span class="lbl lbl--t lab__host__t">mini-PC</span>
    <span class="lbl lbl--tr lab__live items">
      <span data-stats-up></span>
      <span data-stats-age></span>
    </span>
    <dl class="lab__host__kv">
      {stacks.map((s, i) => {
        const { shown, more } = chips(s.services);
        return (
          <div style={`--i:${i}`}>
            <dt>{s.id}</dt>
            <dd>
              {shown.map((service) => (
                <span class="lab__chip">{service}</span>
              ))}
              {more > 0 && <span class="lab__chip lab__more">+{more}</span>}
              {s.id === "flight-tracker" && (
                <span class="lab__now">
                  tracking <b data-stat="tracking">–</b> now
                </span>
              )}
            </dd>
          </div>
        );
      })}
    </dl>
    {/* One row and one chip, for the browser to draw the server's list
         with. */}
    <template data-lab-row>
      <div>
        <dt></dt>
        <dd><span class="lab__chip"></span></dd>
      </div>
    </template>
  </div>
</div>

<style>
  .lab {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    min-width: 0;
  }
  .lab__cloud {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: 10.5rem;
    height: 5.5rem;
    padding-top: 1.2rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .lab__cloud :global(svg) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .lab__cloud :global(path) {
    fill: var(--win-bg);
    stroke: var(--n8);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  /* The tunnel: two hairlines with the traffic running between them. It
     starts under the cloud's edge. */
  .lab__tun {
    position: relative;
    flex: 1 1 9rem;
    min-width: 7.6rem;
    max-width: 11rem;
    height: 9px;
    margin-left: -1rem;
    border-block: 1px solid var(--n8);
  }
  /* One pass is a content timing, like the reel's. Stacked, the traffic runs
     for five passes each time the panel comes on screen (is-live), then
     rests. */
  .lab__tun::before {
    content: "";
    position: absolute;
    inset: 3px 0;
    background: repeating-linear-gradient(
      90deg,
      var(--n10) 0 3px,
      transparent 3px 18px
    );
    animation: win-flow 1.6s linear 5;
  }
  @keyframes win-flow {
    to {
      background-position: 18px 18px;
    }
  }
  :global(.pn--fig:not(.is-live)) .lab__tun::before {
    animation: none;
  }
  /* The tunnel's name, over the stretch of it clear of the cloud: centred
     there while it fits, and on a tunnel shorter than the name kept this far
     from the box, running back over the cloud's shoulder and never across
     the box's border. */
  .lab__tun span {
    position: absolute;
    inset: auto 0.2rem calc(100% + 0.5rem) 1.1rem;
    display: flex;
    justify-content: flex-end;
    font-size: 0.6875rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--faint);
  }
  .lab__tun i {
    flex: none;
    margin-inline: auto;
    font-style: normal;
  }
  .lab__host {
    position: relative;
    flex: 0 1 29.5rem;
    min-width: 0;
    padding: 1.6rem 1.25rem 1.45rem;
    border: 1px solid var(--win-line);
    border-radius: var(--r-ctl);
  }
  .lab__host__t {
    font-size: 0.75rem;
    color: var(--muted);
  }
  /* Nothing heard from the server yet: no label, and no gap in the border. */
  .lab__live:has([data-stats-age]:empty) {
    display: none;
  }
  /* The box's name is short, so this label may run closer to it than a
     panel's would. */
  .lab__live {
    max-width: calc(100% - 5.6rem);
  }
  .lab__host__kv {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.7rem 1.1rem;
  }
  .lab__host__kv > div {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    transition: opacity var(--dur-slow) var(--ease-out)
      calc(var(--i, 0) * var(--stagger));
  }
  :global(.win__app.is-armed) :global(.fg:not(.is-drawn)) .lab__host__kv > div {
    opacity: 0;
  }
  .lab__host__kv dt {
    font-size: 0.75rem;
    white-space: nowrap;
    color: var(--win-key);
  }
  /* A row of services may run a hair into the box's padding before it
     wraps: one that fits to a twentieth of a pixel in one browser must not
     wrap in the next. */
  .lab__host__kv dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.4rem;
    min-width: 0;
    margin-right: -0.25rem;
  }
  .lab__chip {
    padding: 0.14rem 0.4rem 0.16rem;
    border: 1px solid var(--win-line);
    border-radius: var(--r-chip);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
  }
  /* How many more services than the row shows: a count, not a name. */
  .lab__more {
    color: var(--muted);
  }
  /* What the stack is doing now: a time, so the dates' hue. It has a line
     to itself under its stack's services, so the row is the same shape
     whether it holds a dash or three digits. */
  .lab__now {
    flex-basis: 100%;
    font-size: 0.6875rem;
    white-space: nowrap;
    color: var(--win-date);
  }
  .lab__now b {
    font-weight: 500;
    color: var(--win-num);
  }

  /* Beside the picker the traffic runs for as long as the panel is on
     screen. */
  @media (min-width: 60rem) {
    :global(.win__app[data-live]) .lab__tun::before {
      animation: win-flow 1.6s linear infinite;
    }
    :global(.win__app[data-live] .pn--fig:not(.is-live)) .lab__tun::before {
      animation-play-state: paused;
    }
  }
  /* The pause button holds the traffic, and so does a mouse resting on the
     figure. Both come after the rule above, which sets the animation whole
     and with it the running state. */
  :global(.win__app.is-held) .lab__tun::before {
    animation-play-state: paused;
  }
  @media (hover: hover) {
    :global(.pn--fig:hover) .lab__tun::before {
      animation-play-state: paused;
    }
  }

  /* This figure needs the most width, so it turns upright first: the cloud
     over the box, the tunnel coming down into it. */
  @container win-fig (max-width: 43.99rem) {
    .lab {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 30rem;
      margin-inline: auto;
    }
    .lab__cloud {
      align-self: center;
    }
    .lab__tun {
      flex: none;
      align-self: center;
      width: 9px;
      min-width: 0;
      height: 2.5rem;
      margin: -0.4rem 0 0;
      border-block: 0;
      border-inline: 1px solid var(--n8);
    }
    .lab__tun::before {
      inset: 0 3px;
      background: repeating-linear-gradient(
        180deg,
        var(--n10) 0 3px,
        transparent 3px 18px
      );
    }
    .lab__tun span {
      inset: 55% auto auto calc(100% + 0.7rem);
      transform: translateY(-50%);
    }
    .lab__host {
      flex: none;
    }
    /* The tunnel's name now sits just over the box's top right corner, so
       the live label takes the bottom one, where no title shares the
       border and it can be as long as the box. */
    .lab__live {
      top: auto;
      bottom: 0;
      max-width: calc(100% - 1.2rem);
      transform: translateY(50%);
    }
  }
  @container win-fig (max-width: 38rem) {
    .lab__cloud {
      width: 7.6rem;
      height: 4rem;
      padding-top: 0.9rem;
    }
    .lab__host {
      padding: 1.15rem 0.8rem 0.95rem;
    }
    /* Each stack's name over its services. */
    .lab__host__kv {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.55rem;
    }
    .lab__host__kv > div {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 0.7rem;
    }
    .lab__host__kv dt {
      font-size: 0.6875rem;
    }
    .lab__host__kv dd {
      margin-right: 0;
    }
    /* The flight tracker's services always go under its name. Its live line
       counts in the services' width, so beside the name the row's shape
       would turn on how wide the number is, and on the font: at some widths
       a dash keeps name and services on one line and three digits drop the
       services under it. */
    .lab__host__kv > div:has(.lab__now) dd {
      flex-basis: 100%;
    }
    .lab__chip {
      padding-inline: 0.32rem;
      font-size: 0.6875rem;
    }
  }
  /* The narrowest: the tunnel's name sits closer to it, clear of the
     panel's edge. */
  @container win-fig (max-width: 18.4rem) {
    .lab__tun span {
      left: calc(100% + 0.35rem);
    }
  }
  @media (max-width: 45.99rem) {
    .lab__tun {
      height: 1.9rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lab .lab__tun::before {
      animation: none !important;
    }
  }
</style>
