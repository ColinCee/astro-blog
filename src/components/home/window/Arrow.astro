---
// The window's two small arrows, drawn because the site's fonts have no
// glyph for either: `e` after a link that stays on the site, `ne` after one
// that leaves it. Decoration only, so hidden from screen readers. A stat's
// arrow is a different thing (site/StatArrow.astro): that one is read as "to".
interface Props {
  dir: "e" | "ne";
}
const { dir } = Astro.props;
---

{dir === "e" ? (
  <svg class="arw arw--e" viewBox="0 0 16 10" aria-hidden="true">
    <path d="M1 5h13.5M10.5 1l4 4-4 4" />
  </svg>
) : (
  <svg class="arw arw--ne" viewBox="0 0 10 10" aria-hidden="true">
    <path d="M2 8 8 2M3.2 2H8v4.8" />
  </svg>
)}

<style>
  .arw {
    margin-left: 0.5em;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  /* The stat arrow's size and seat: on the middle of the digits. */
  .arw--e {
    width: 0.8em;
    height: 0.5em;
    vertical-align: 0.11em;
    stroke-width: 1.25;
  }
  .arw--ne {
    width: 0.62em;
    height: 0.62em;
    stroke-width: 1.2;
  }
</style>
