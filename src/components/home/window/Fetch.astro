---
// The window's fastfetch panel: the site's favicon where fastfetch prints a
// logo, beside a few key/value rows. The rows say what the hero does not
// (both names, since when, how much is written); the role is the one repeat,
// and it is the first row to go when the panel narrows.

import { homePosts, workSince } from "./data";
import Panel from "./Panel.astro";

const name = "Colin Cheung";
const nameCjk = "張志權";
const role = "Senior Software Engineer";
const posts = await homePosts();
const since = await workSince();
---

<Panel name="who" title="fastfetch" class="pn--who">
  <div class="ff">
    {/* public/favicon.svg's own shapes, in the page's colours. */}
    <div
      class="ff__mark"
      role="img"
      aria-label="The site's favicon: a long grey bar, before, over a short purple bar, after"
    >
      <svg viewBox="0 0 128 128" aria-hidden="true">
        <rect class="is-tile" width="128" height="128" rx="24"></rect>
        <rect class="is-was" x="26" y="40" width="76" height="18" rx="5"></rect>
        <rect class="is-now" x="26" y="70" width="30" height="18" rx="5"></rect>
      </svg>
    </div>
    <dl class="ff__kv">
      <div class="is-name" data-dim style="--i:0">
        <dt>name</dt>
        <dd>
          <span>{name}</span>
          <span class="ff__cjk" lang="zh-Hant">{nameCjk}</span>
        </dd>
      </div>
      <div class="is-role" data-dim style="--i:1">
        <dt>role</dt>
        <dd>{role}</dd>
      </div>
      <div data-dim style="--i:2">
        <dt>work</dt>
        <dd>since {since}</dd>
      </div>
      <div data-dim style="--i:3">
        <dt>posts</dt>
        <dd class="items">
          <span>{posts.length}</span>
          {posts[0] && <span class="ff__dim">newest {posts[0].date}</span>}
        </dd>
      </div>
    </dl>
  </div>
</Panel>

<style>
  .pn.pn--who {
    grid-area: who;
    container: win-who / inline-size;
  }
  /* The favicon is as tall as the rows beside it, so it reads as part of the
     readout, not a logo over it: its side is the row count times one line,
     less a hair top and bottom (given back as margin) so its edges sit on the
     text and not on the line boxes. One grid row and no row gap: anything
     more leaves empty space under the rows. --rows and --lh change together
     with what the steps below show. */
  .ff {
    --rows: 4;
    --lh: 1.5;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 1.2rem;
    align-items: start;
    line-height: var(--lh);
  }
  .ff__mark {
    width: calc(var(--rows) * var(--lh) * 1em - 0.4rem);
    aspect-ratio: 1;
    margin-block: 0.2rem;
  }
  .ff__mark svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ff__mark .is-tile {
    fill: var(--page);
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  /* The mark, not a second accent: it is the same purple bar the browser tab
     shows. */
  .ff__mark .is-was {
    fill: var(--n8);
  }
  .ff__mark .is-now {
    fill: var(--accent);
  }
  /* In the opening round the two bars grow from the left, grey then purple. */
  .ff__mark .is-was,
  .ff__mark .is-now {
    transform-box: fill-box;
    transform-origin: left center;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .ff__mark .is-now {
    transition-delay: calc(4 * var(--stagger));
  }
  :global(.win__app.is-boot) .pn--who:not(.is-on) :is(.is-was, .is-now) {
    transform: scaleX(0);
  }

  .ff__kv > div {
    display: grid;
    grid-template-columns: 5ch minmax(0, 1fr);
    column-gap: 1.5ch;
    align-items: baseline;
  }
  .ff__kv dt {
    color: var(--win-key);
  }
  .ff__kv dd {
    min-width: 0;
  }
  .ff__kv .is-name dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5ch;
  }
  /* The second name comes from whichever CJK font the device has. No line
     height of its own, so on the first name's baseline it can never make the
     row taller than a line, whatever that font's proportions. */
  .ff__cjk {
    font-family: var(--cjk);
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--dim);
  }
  .ff__dim {
    color: var(--dim);
  }

  /* A narrower panel, step by step: closer columns; then the role row goes
     (the hero has it) and the three left are set a little apart; then they
     close up again; then the newest date goes; and last the two names take a
     line each, which makes four lines again. The rows always sit beside the
     mark, never under it. */
  @container win-who (max-width: 26.49rem) {
    .ff {
      column-gap: 1rem;
    }
  }
  @container win-who (max-width: 24.49rem) {
    .ff {
      --rows: 3;
      --lh: 1.72;
      column-gap: 0.8rem;
    }
    .ff__kv .is-role {
      display: none;
    }
  }
  @container win-who (max-width: 20.99rem) {
    .ff {
      column-gap: 0.5rem;
    }
    .ff__kv > div {
      column-gap: 1ch;
    }
  }
  @container win-who (max-width: 19.24rem) {
    .ff {
      --lh: 1.5;
    }
  }
  @container win-who (max-width: 17.49rem) {
    .ff__dim {
      display: none;
    }
  }
  @container win-who (max-width: 15.99rem) {
    .ff {
      --rows: 4;
    }
    .ff__kv .is-name dd {
      flex-direction: column;
    }
    .ff__cjk {
      line-height: inherit;
    }
  }
</style>
