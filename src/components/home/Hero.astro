---
// The homepage hero: the name, the role and the links on the left; the
// one-liners on the right as a reel, the only thing that moves on the first
// screen.
import links from "../../data/links.json";
import BrandIcon from "./BrandIcon.astro";

// Dry one-liners, shown one at a time in the reel. Each is a line of trusted HTML: plain
// text with the punchline in <b>, and for some a small inline drawing (classes
// prefixed q-, styled below). Behaviours are opt-in data attributes:
//   data-flip="7,0"  the counter shows 7, then flips to 0 while on screen
//   data-odo="N"     a counter that keeps ticking up from N
// The markup here is the resting state (what no-JS and reduced motion show).
const quips = [
  `<span class="q-ctr" data-flip="7,0">0</span> days since the last prod incident`,
  `still waiting to reverse a <b>linked list</b> at work <svg class="q-svg" width="54" height="14" viewBox="0 0 54 14" aria-hidden="true"><path class="q-line q-arrow" d="M12 7 H20 M17.5 4.5 L20 7 L17.5 9.5"/><path class="q-line q-arrow q-arrow--2" d="M32 7 H40 M37.5 4.5 L40 7 L37.5 9.5"/><rect class="q-node q-node--head" x="1" y="2" width="10" height="10" rx="2"/><rect class="q-node" x="21" y="2" width="10" height="10" rx="2"/><rect class="q-node q-node--tail" x="41" y="2" width="10" height="10" rx="2"/></svg>`,
  `<b>LGTM</b> (didn’t read)`,
  `still on <b>16GB</b> of RAM in 2026`,
  `coffee <span class="q-meter q-meter--drain" aria-hidden="true"><i></i></span> into <b>code</b> <span class="q-meter q-meter--fill" aria-hidden="true"><i></i></span>`,
  `never seen a <b>linear</b> burndown chart in my life <svg class="q-svg" width="64" height="18" viewBox="0 0 64 18" aria-hidden="true"><path class="q-line" stroke-dasharray="3 3" d="M1 2 L63 16"/><path class="q-line q-line--hot" d="M1 2 L12 3 L22 3 L30 6 L40 5 L50 9 L63 7"/></svg>`,
  `<b>0</b> tests failing (0 tests)`,
  `<b>claude</b> implement this, make no mistakes.`,
  `homelab <span class="q-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i class="is-down"></i><i></i><i></i><i></i></span> <b>1</b> powercut from downtime`,
  `TODO: fix this <b>later</b> (2019)`,
  `today <span class="q-split" aria-hidden="true"><i style="--w:7"></i><i class="is-hot" style="--w:1"></i></span> meetings / <b>code</b>`,
  `another meeting that could've been an <b>email</b>`,
  `infinite RAM, if you count <b>swap</b>`,
  `git blame <svg class="q-svg" width="52" height="18" viewBox="0 0 52 18" aria-hidden="true"><path class="q-line" d="M3 9 H49 M14 9 C20 9 20 3 26 3 H34 C40 3 40 9 46 9"/><circle class="q-fill" cx="3" cy="9" r="2.5"/><circle class="q-fill" cx="26" cy="3" r="2.5"/><circle class="q-fill q-fill--hot" cx="46" cy="9" r="3.2"/></svg> says it was <b>me</b>`,
  `reads the docs as a <b>last resort</b>`,
  `<b data-odo="2000000000">2,000,000,000</b> tokens burned today`,
  `learning Mandarin one <b>Anki card</b> at a time`,
  `testing in <b>production…</b>`,
];
---

<section class="hero" aria-label="Colin Cheung, Senior Software Engineer">
  <div class="hero__who">
    <h1 class="hero__name">Colin Cheung</h1>
    <p class="hero__role">Senior Software Engineer</p>
    <div class="hero__social">
      <a class="hero__ico" href={links.github} aria-label="GitHub">
        <BrandIcon name="github" />
      </a>
      <a class="hero__ico" href={links.linkedin} aria-label="LinkedIn">
        <BrandIcon name="linkedin" />
      </a>
    </div>
  </div>

  <!-- The one-liners as a reel: the current one, the next one faint under it.
       One every 5 s; hover pauses, a click skips, the bar shows the time left. -->
  <div class="reel" data-reel data-quips={JSON.stringify(quips)}>
    <p class="reel__cap">
      <span>today's one-liner</span>
      <span data-reel-n>01 / {String(quips.length).padStart(2, "0")}</span>
    </p>
    <div class="reel__list">
      <ul class="reel__track" data-reel-track>
        <li class="reel__item is-cur" set:html={quips[0]} />
        <li class="reel__item" aria-hidden="true" set:html={quips[1]} />
      </ul>
    </div>
    <div class="reel__bar" aria-hidden="true"><i data-reel-bar></i></div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: var(--w-poster);
    min-height: 24rem;
    margin: 0 auto;
    padding: clamp(1rem, 4vw, 3rem) 0 clamp(2rem, 4vw, 3rem);
  }
  .hero__name {
    font-family: var(--head);
    font-weight: 600;
    font-size: clamp(2.6rem, 5.5vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--ink);
    animation: rise var(--dur-slow) var(--ease-out) both;
  }
  .hero__role {
    margin-top: 0.7rem !important;
    font-size: 1.0625rem;
    color: var(--muted);
  }
  .hero__social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }
  /* Controls: ink on the panel tone, 6px, never the accent */
  .hero__ico {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--r-ctl);
    background: var(--panel);
    color: var(--muted);
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }
  .hero__ico :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }
  .hero__ico:hover {
    color: var(--ink);
    background: var(--accent-hover);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .hero__ico:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .reel {
    display: grid;
    gap: 0.8rem;
    cursor: pointer;
    min-width: 0;
  }
  .reel__cap {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .reel__list {
    position: relative;
    height: 9rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    mask-image: linear-gradient(#000 60%, transparent);
  }
  .reel__track {
    position: absolute;
    inset: 0 0 auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reel__track.is-moving {
    transition: transform 0.7s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .reel__bar {
    max-width: 12rem;
    height: 2px;
    border-radius: 2px;
    background: var(--well);
    overflow: hidden;
  }
  .reel__bar i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--n9);
  }
  .reel__bar i.is-running {
    animation: reel-run 5s linear forwards;
  }
  .reel:hover .reel__bar i.is-running {
    animation-play-state: paused;
  }
  @keyframes reel-run {
    to {
      width: 100%;
    }
  }
  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .reel__list {
      height: 9.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reel__bar {
      display: none;
    }
  }
</style>

<!-- Global: the one-liners arrive as HTML (set:html, then innerHTML), which
     scoped styles do not reach. -->
<style is:global>
  /* The one-liners: Sora at 200 in ink. The current
     one is full strength, the next one faint; the old one fades as it rises. */
  .reel__item {
    max-width: 28ch;
    padding: 0 0 1.1rem;
    font-family: var(--head);
    font-weight: 200;
    font-size: clamp(1.3rem, 2.1vw, 1.8rem);
    line-height: 1.35;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
    opacity: 0.18;
    transition: opacity 0.7s;
  }
  .reel__item.is-cur {
    opacity: 1;
  }
  .reel__item.is-gone {
    opacity: 0;
    transition-duration: 0.35s;
  }
  /* One violet thing per line: the punchline word, unless a drawing or the
     counter already is. Colour, not bold: a heavy Sora reads thick next to
     the 200 voice; 300 only keeps the thin violet strokes as solid as ink. */
  .reel__item b {
    font-weight: 300;
    color: var(--accent-text);
  }
  .reel__item:has(.q-svg, .q-meter, .q-dots, .q-split, .q-ctr) b {
    font-weight: inherit;
    color: inherit;
  }
  /* Inline drawings: neutral marks, the punchline in the accent, one line tall. */
  .q-svg {
    display: inline-block;
    height: 1.1em;
    width: auto;
    overflow: visible;
    vertical-align: -0.2em;
  }
  .q-line {
    fill: none;
    stroke: var(--n7);
    stroke-width: 1.5;
  }
  .q-line--hot {
    stroke: var(--accent-solid);
    stroke-width: 2;
  }
  .q-fill {
    fill: var(--n7);
  }
  .q-fill--hot {
    fill: var(--accent-solid);
  }
  /* Linked list: the arrows flip one after the other, then the highlight
     moves from the old tail to the new head. Plays once per appearance. */
  .q-arrow {
    transform-box: fill-box;
    transform-origin: center;
    animation: q-reverse 0.45s ease-in-out 0.9s forwards;
  }
  .q-arrow--2 {
    animation-delay: 1.4s;
  }
  .q-node {
    fill: var(--n7);
  }
  .q-node--tail {
    fill: var(--accent-solid);
    animation: q-cool 0.3s ease 2s forwards;
  }
  .q-node--head {
    animation: q-hot 0.3s ease 2s forwards;
  }
  @keyframes q-reverse {
    to {
      transform: rotate(180deg);
    }
  }
  @keyframes q-hot {
    to {
      fill: var(--accent-solid);
    }
  }
  @keyframes q-cool {
    to {
      fill: var(--n7);
    }
  }
  .q-ctr {
    display: inline-block;
    min-width: 1.6ch;
    padding: 0 0.4ch;
    border-radius: 3px;
    background: var(--accent-solid);
    color: var(--accent-ink);
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .q-ctr.is-flipping {
    animation: q-flip 0.32s ease-in-out;
  }
  @keyframes q-flip {
    50% {
      transform: rotateX(90deg);
    }
  }
  /* Coffee drains while code fills, once, each time the line appears. */
  .q-meter {
    display: inline-block;
    width: 3.2em;
    height: 0.6em;
    vertical-align: 0.1em;
    background: var(--n5);
    border-radius: 1px;
    overflow: hidden;
  }
  .q-meter i {
    display: block;
    height: 100%;
  }
  .q-meter--drain i {
    width: 12%;
    background: var(--n8);
    animation: q-drain 2.6s 0.3s ease-in-out backwards;
  }
  .q-meter--fill i {
    width: 100%;
    background: var(--accent-solid);
    animation: q-fill 2.6s 0.3s ease-in-out backwards;
  }
  @keyframes q-drain {
    from {
      width: 100%;
    }
  }
  @keyframes q-fill {
    from {
      width: 8%;
    }
  }
  .q-dots,
  .q-split {
    display: inline-flex;
    align-items: center;
    vertical-align: 0.1em;
  }
  .q-dots {
    gap: 0.2em;
  }
  .q-dots i {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--n6);
  }
  .q-dots .is-down {
    background: var(--accent-solid);
  }
  .q-split {
    width: 7em;
    height: 0.6em;
    gap: 2px;
  }
  .q-split i {
    flex: var(--w) 0 0;
    height: 100%;
    background: var(--n5);
    border-radius: 1px;
  }
  .q-split .is-hot {
    background: var(--accent-solid);
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const reel of document.querySelectorAll<HTMLElement>("[data-reel]")) {
    const quips = JSON.parse(reel.dataset.quips || "[]") as string[];
    const track = reel.querySelector<HTMLElement>("[data-reel-track]")!;
    const num = reel.querySelector<HTMLElement>("[data-reel-n]")!;
    const bar = reel.querySelector<HTMLElement>("[data-reel-bar]")!;
    const N = quips.length;
    const EVERY = 5000;
    const at = (k: number) => quips[((k % N) + N) % N];
    let i = 0;
    let timers: number[] = [];

    // Start the opt-in behaviours of the line now showing; under reduced
    // motion the line stays at rest.
    const animate = (el: HTMLElement) => {
      timers.forEach((t) => window.clearTimeout(t));
      timers = [];
      if (reduce) return;
      const flip = el.querySelector<HTMLElement>("[data-flip]");
      if (flip) {
        const [from, to] = (flip.dataset.flip || "").split(",");
        flip.textContent = from;
        timers.push(
          window.setTimeout(() => {
            flip.classList.add("is-flipping");
            timers.push(window.setTimeout(() => (flip.textContent = to), 160));
          }, 1300),
        );
      }
      const odo = el.querySelector<HTMLElement>("[data-odo]");
      if (odo) {
        let n = Number(odo.dataset.odo);
        const tick = () => {
          n += 10_000 + Math.floor(Math.random() * 90_000);
          odo.textContent = n.toLocaleString("en-GB");
          timers.push(window.setTimeout(tick, 120));
        };
        tick();
      }
    };

    // The old line, the new one and the one after; start one row down, then
    // glide up so the old line rises and fades while the next takes its place.
    const paint = () => {
      num.textContent = `${String(i + 1).padStart(2, "0")} / ${String(N).padStart(2, "0")}`;
      track.classList.remove("is-moving");
      track.innerHTML = [-1, 0, 1]
        .map(
          (d) =>
            `<li class="reel__item${d === -1 ? " is-cur" : ""}" data-d="${d}"${d ? ' aria-hidden="true"' : ""}>${at(i + d)}</li>`,
        )
        .join("");
      const row = (d: number) =>
        track.querySelector<HTMLElement>(`[data-d="${d}"]`)!;
      track.style.transform = `translateY(${-row(-1).offsetTop}px)`;
      void track.offsetWidth;
      track.classList.add("is-moving");
      row(-1).classList.replace("is-cur", "is-gone");
      row(0).classList.add("is-cur");
      track.style.transform = `translateY(${-row(0).offsetTop}px)`;
      animate(row(0));
      bar.classList.remove("is-running");
      void bar.offsetWidth;
      bar.classList.add("is-running");
    };

    let timer = 0;
    let left = EVERY;
    let t0 = 0;
    const next = () => {
      i = (i + 1) % N;
      paint();
      schedule(EVERY);
    };
    const schedule = (ms: number) => {
      window.clearTimeout(timer);
      left = ms;
      t0 = performance.now();
      timer = window.setTimeout(next, ms);
    };

    animate(track.querySelector<HTMLElement>(".is-cur")!);
    if (!reduce && N > 1) {
      bar.classList.add("is-running");
      schedule(EVERY);
      reel.addEventListener("mouseenter", () => {
        window.clearTimeout(timer);
        left -= performance.now() - t0;
      });
      reel.addEventListener("mouseleave", () => schedule(Math.max(600, left)));
      reel.addEventListener("click", next);
    }
  }
</script>
