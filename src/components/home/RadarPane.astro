---
// A simulated radar of the London airspace, top down: overflights crossing
// high, departures climbing out, and a few arrivals in the accent colour
// heading for their airport with a callsign. Plausible, not to scale, no
// network calls. The link goes to the real tracker.
const demo = "https://flight-tracker-at-home.pages.dev";
---

<div class="rd" data-radar>
  <div class="rd__map">
    <canvas class="rd__canvas" aria-hidden="true"></canvas>
  </div>
  <p class="rd__foot">
    <span data-rd-status>simulated airspace</span>
    <a href={demo}> the real thing <span aria-hidden="true">↗</span> </a>
  </p>
</div>

<style>
  .rd {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    font-family: var(--mono);
  }
  .rd__map {
    position: relative;
    flex: 1;
    min-height: 9.5rem;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: 7px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at center,
        color-mix(in oklch, var(--ink) 6%, transparent),
        transparent 70%
      ),
      var(--panel);
  }
  .rd__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .rd__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.6875rem;
    color: var(--faint);
  }
  .rd__foot b {
    color: var(--accent);
    font-weight: 600;
  }
  .rd__foot a {
    color: var(--muted);
    white-space: nowrap;
  }
  .rd__foot a:hover {
    color: var(--accent);
  }
</style>

<script>
  // Positions are km east and north of central London; the map shows R km each way.
  type Kind = "over" | "dep" | "arr";
  type Plane = {
    kind: Kind;
    cs: string;
    ap: string;
    x: number;
    y: number;
    hdg: number;
    v: number;
    trail: [number, number][];
    tAt: number;
    born: number;
    gone: number;
    t: number;
  };
  const R = 45;
  const AIRPORTS: Record<string, [number, number]> = {
    LHR: [-18.5, -3.5],
    LGW: [-1.5, -39],
    STN: [26, 43],
    LTN: [-11, 42],
    LCY: [11, 0.5],
  };
  const FLEETS: Record<string, string[]> = {
    LHR: ["BAW", "BAW", "BAW", "VIR", "EIN", "UAE", "AAL", "DLH"],
    LGW: ["EZY", "EZY", "BAW", "TOM", "NAX"],
    STN: ["RYR", "RYR", "RYR", "EZY"],
    LTN: ["EZY", "WZZ", "WZZ"],
    LCY: ["CFE", "CFE", "KLM"],
  };
  const ARR_AT = ["LHR", "LHR", "LHR", "LGW", "LGW", "STN", "LTN", "LCY"];
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  function pick<T>(xs: T[]) {
    return xs[Math.floor(Math.random() * xs.length)];
  }
  const callsign = (ap: string) =>
    `${pick(FLEETS[ap] || FLEETS.LHR)}${Math.floor(rnd(1, 999))}${Math.random() < 0.3 ? String.fromCharCode(65 + Math.floor(rnd(0, 26))) : ""}`;
  // a point on the edge of the map, a little outside it
  const edge = (): [number, number] => {
    const a = rnd(0, 6.2832),
      r = R * 1.45;
    return [Math.cos(a) * r, Math.sin(a) * r];
  };
  const make = (kind: Kind, now: number): Plane => {
    const base = {
      trail: [] as [number, number][],
      tAt: 0,
      born: now,
      gone: 0,
      t: 0,
    };
    if (kind === "arr") {
      const ap = pick(ARR_AT);
      const [x, y] = edge();
      const [ax, ay] = AIRPORTS[ap];
      return {
        ...base,
        kind,
        cs: callsign(ap),
        ap,
        x,
        y,
        hdg: Math.atan2(ay - y, ax - x),
        v: rnd(2.2, 2.8),
      };
    }
    if (kind === "dep") {
      const ap = pick(ARR_AT);
      const [ax, ay] = AIRPORTS[ap];
      return {
        ...base,
        kind,
        cs: callsign(ap),
        ap,
        x: ax,
        y: ay,
        hdg: rnd(0, 6.2832),
        v: rnd(1.6, 2.2),
      };
    }
    const [x, y] = edge();
    // cross the map, aiming somewhere near the middle so it actually crosses
    const hdg = Math.atan2(
      rnd(-R * 0.6, R * 0.6) - y,
      rnd(-R * 0.6, R * 0.6) - x,
    );
    return {
      ...base,
      kind,
      cs: callsign("LHR"),
      ap: "",
      x,
      y,
      hdg,
      v: rnd(3, 4.2),
    };
  };

  document.querySelectorAll<HTMLElement>("[data-radar]").forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>("canvas")!;
    const ctx = canvas.getContext("2d")!;
    const status = root.querySelector<HTMLElement>("[data-rd-status]")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let W = 0,
      H = 0,
      raf = 0,
      prev = 0,
      visible = false,
      inView = false,
      sweep = 0;
    let ink = "#000",
      accent = "#c33",
      faint = "#888",
      mono = "monospace";
    const WANT = { over: 7, dep: 2, arr: 3 } as const;
    const planes: Plane[] = [];
    const now0 = performance.now();
    (Object.keys(WANT) as Kind[]).forEach((k) => {
      for (let i = 0; i < WANT[k]; i++) {
        const p = make(k, now0);
        // first fill: scatter along their paths instead of all arriving at once
        if (k !== "dep") {
          const d = rnd(0, R * 1.6);
          p.x += Math.cos(p.hdg) * d;
          p.y += Math.sin(p.hdg) * d;
        }
        planes.push(p);
      }
    });

    const colors = () => {
      const cs = getComputedStyle(root);
      ink = cs.getPropertyValue("--ink").trim() || ink;
      accent = cs.getPropertyValue("--accent").trim() || accent;
      faint = cs.getPropertyValue("--faint").trim() || faint;
      mono = cs.getPropertyValue("--mono").trim() || mono;
    };
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const scale = () => Math.min(W, H) / (2 * R);
    const px = (x: number) => W / 2 + x * scale();
    const py = (y: number) => H / 2 - y * scale();

    const step = (dt: number, now: number) => {
      sweep = (sweep + dt * 0.4) % 6.2832;
      for (let i = planes.length - 1; i >= 0; i--) {
        const p = planes[i];
        p.t += dt;
        if (p.gone) {
          if (now - p.gone > 900) {
            planes.splice(i, 1);
            planes.push(make(p.kind, now));
          }
          continue;
        }
        if (p.kind === "arr") {
          // home in on the airport, with a little banking as the heading corrects
          const [ax, ay] = AIRPORTS[p.ap];
          const want = Math.atan2(ay - p.y, ax - p.x);
          let d = want - p.hdg;
          while (d > Math.PI) d -= 6.2832;
          while (d < -Math.PI) d += 6.2832;
          p.hdg += d * Math.min(1, dt * 1.5);
          if (Math.hypot(ax - p.x, ay - p.y) < 1.2) {
            p.gone = now;
            continue;
          }
        } else if (p.kind === "dep") {
          p.v = Math.min(3.4, p.v + dt * 0.35); // climbing out, accelerating
        }
        p.x += Math.cos(p.hdg) * p.v * dt;
        p.y += Math.sin(p.hdg) * p.v * dt;
        if (now - p.tAt > 260) {
          p.tAt = now;
          p.trail.push([p.x, p.y]);
          if (p.trail.length > 16) p.trail.shift();
        }
        if (p.kind !== "arr" && Math.hypot(p.x, p.y) > R * 1.5 && p.t > 2) {
          planes.splice(i, 1);
          planes.push(make(p.kind, now));
        }
      }
      const arr = planes.filter(
        (p) => p.kind === "arr" && !p.gone && Math.hypot(p.x, p.y) < R * 1.05,
      );
      const next = arr.sort(
        (a, b) =>
          Math.hypot(a.x - AIRPORTS[a.ap][0], a.y - AIRPORTS[a.ap][1]) -
          Math.hypot(b.x - AIRPORTS[b.ap][0], b.y - AIRPORTS[b.ap][1]),
      )[0];
      const n = planes.filter(
        (p) => !p.gone && Math.hypot(p.x, p.y) < R * 1.05,
      ).length;
      // Touch the page only when the line changes, not every frame.
      const line = next ? `${next.cs} → ${next.ap}|${n}` : `|${n}`;
      if (line === shown) return;
      shown = line;
      status.innerHTML = next
        ? `<b></b> inbound · ${n} tracked · simulated`
        : `${n} tracked · simulated`;
      if (next)
        status.querySelector("b")!.textContent = `${next.cs} → ${next.ap}`;
    };
    let shown = "";

    const draw = (now: number) => {
      ctx.clearRect(0, 0, W, H);
      const s = scale(),
        cx = W / 2,
        cy = H / 2;
      ctx.lineWidth = 1;
      ctx.strokeStyle = ink;
      [15, 30, 45].forEach((r) => {
        ctx.globalAlpha = 0.07;
        ctx.beginPath();
        ctx.arc(cx, cy, r * s, 0, 6.2832);
        ctx.stroke();
      });
      if (!reduce) {
        const g = ctx.createConicGradient(sweep, cx, cy);
        g.addColorStop(0, accent);
        g.addColorStop(0.1, "transparent");
        g.addColorStop(1, "transparent");
        ctx.globalAlpha = 0.08;
        ctx.fillStyle = g;
        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, R * s, 0, 6.2832);
        ctx.clip();
        ctx.fillRect(0, 0, W, H);
        ctx.restore();
      }
      ctx.font = `500 9px ${mono}`;
      Object.entries(AIRPORTS).forEach(([code, [x, y]]) => {
        ctx.globalAlpha = 0.7;
        ctx.fillStyle = ink;
        ctx.fillRect(px(x) - 2.5, py(y) - 2.5, 5, 5);
        ctx.globalAlpha = 0.5;
        ctx.fillText(code, px(x) + 6, py(y) + 3);
      });
      ctx.font = `500 10px ${mono}`;
      const placed: { x0: number; x1: number; y: number }[] = [];
      planes.forEach((p) => {
        const x = px(p.x),
          y = py(p.y);
        if (x < -20 || x > W + 20 || y < -20 || y > H + 20) return;
        const hot = p.kind === "arr";
        const fade = p.gone
          ? 1 - Math.min(1, (now - p.gone) / 900)
          : Math.min(1, (now - p.born) / 600);
        ctx.fillStyle = hot ? accent : ink;
        p.trail.forEach(([tx, ty], k) => {
          ctx.globalAlpha = (k / p.trail.length) * (hot ? 0.45 : 0.22) * fade;
          ctx.beginPath();
          ctx.arc(px(tx), py(ty), 1, 0, 6.2832);
          ctx.fill();
        });
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(-p.hdg);
        ctx.globalAlpha = (hot ? 0.95 : p.kind === "dep" ? 0.5 : 0.4) * fade;
        ctx.beginPath();
        ctx.moveTo(6, 0);
        ctx.lineTo(-5, 4);
        ctx.lineTo(-3, 0);
        ctx.lineTo(-5, -4);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
        if (!hot || p.gone) return;
        const text = `${p.cs} → ${p.ap}`;
        const w = ctx.measureText(text).width;
        const right = x + 9 + w > W - 4;
        const x0 = right ? x - 9 - w : x + 9,
          x1 = x0 + w;
        let ly = 0;
        for (let lane = 0; lane < 6; lane++) {
          const cand =
            lane % 2 === 0
              ? y + 4 - Math.floor(lane / 2) * 13
              : y + 17 + Math.floor(lane / 2) * 13;
          if (cand < 10 || cand > H - 4) continue;
          if (
            !placed.some(
              (r) =>
                Math.abs(r.y - cand) < 12 && r.x0 < x1 + 6 && r.x1 > x0 - 6,
            )
          ) {
            ly = cand;
            break;
          }
        }
        if (!ly) return;
        placed.push({ x0, x1, y: ly });
        ctx.globalAlpha = 0.9 * fade;
        ctx.fillText(text, x0, ly);
      });
      ctx.globalAlpha = 1;
    };
    // 30 frames a second: the traffic and the sweep move slowly enough that
    // more frames would only cost CPU.
    const loop = (ms: number) => {
      if (visible) raf = requestAnimationFrame(loop);
      if (prev && ms - prev < 1000 / 31) return;
      const dt = Math.min(0.05, prev ? (ms - prev) / 1000 : 0.016);
      prev = ms;
      step(dt, ms);
      draw(ms);
    };

    colors();
    resize();
    step(0, performance.now());
    draw(performance.now());
    new ResizeObserver(() => {
      resize();
      draw(performance.now());
    }).observe(canvas);
    // the nav button announces a theme change
    addEventListener("themechange", () => {
      colors();
      draw(performance.now());
    });
    const update = () => {
      const was = visible;
      visible = inView && !document.hidden && !reduce;
      cancelAnimationFrame(raf);
      if (visible && !was) prev = 0;
      if (visible) raf = requestAnimationFrame(loop);
    };
    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        update();
      },
      { threshold: 0 },
    ).observe(root);
    document.addEventListener("visibilitychange", update);
  });
</script>
