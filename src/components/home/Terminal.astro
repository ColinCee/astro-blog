---
// The homepage's set piece: a terminal window with two panes, who I am (the
// two names, skills, live weather) and what I wrote (the newest posts and
// their results). No tmux bar: nothing on it said anything new.
import WhoamiPane from "./WhoamiPane.astro";
import WritingPane from "./WritingPane.astro";
---

<section class="term" aria-label="Colin at a glance, as a terminal session">
  <div class="term__bar">
    <span class="term__dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="term__name">~/ColinOS</span>
  </div>

  <div class="term__panes">
    <WhoamiPane />
    <WritingPane />
  </div>
</section>

<style>
  .term {
    max-width: var(--w-poster);
    margin: clamp(1.5rem, 4vw, 3rem) auto 0;
    background: var(--panel);
    border-radius: var(--r);
    overflow: hidden;
    animation: rise var(--dur-slow) var(--ease-out) var(--stagger) both;
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .term__dots {
    display: inline-flex;
    gap: 0.42rem;
  }
  .term__dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--n6);
  }
  .term__panes {
    display: grid;
    gap: 1px;
    background: var(--line);
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "who writing";
  }
  @media (max-width: 900px) {
    .term__panes {
      grid-template-columns: 1fr;
      /* biome-ignore lint/correctness/noInvalidGridAreas: one cell per row; Biome misreads strings in .astro styles */
      grid-template-areas: "who" "writing";
    }
  }
</style>
