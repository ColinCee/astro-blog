---
// The homepage's projects: a picker. The names are a plain list on the left;
// the open one shows its figure on the right, one panel at a time (an
// accordion on narrow screens). Each figure is a small live piece of the
// project: the dissertation's training curve, a simulated London radar, the
// homelab's stacks, a card from the deck and how this page got to you.
// Projects: src/data/projects.json; stacks: homelab-stacks.json; cards:
// anki-cards.json. The radar's simulation is projects/radar.ts.
import { getCollection } from "astro:content";
import ankiCards from "../../data/anki-cards.json";
import Cloud from "./projects/Cloud.astro";

// The delivery figure's numbers are real: the commit this page was built
// from, the post count, and (in the browser) this visit's time to first byte.
const build = __BUILD__;
const postCount = (await getCollection("blog")).length;
const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, ...data }));
const stacks = (await getCollection("homelabStacks"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, ...data }));

// What each stack's node says instead of its service list: a real number from
// the home server, read in the browser from /homelab.json (worker/index.ts),
// in [data-stat]. Until it arrives, or without it, the number is a dash.
const stackNow: Record<string, [string, string, string]> = {
  "flight-tracker": ["tracking", "tracking", "now"],
  crowdsec: ["blocking", "blocked", "ips"],
};

// One training run: 12 hours in 2018, 11 minutes in 2026.
const runNow = `${((11 / (12 * 60)) * 100).toFixed(2)}%`;
---

<section class="sec" id="projects" aria-labelledby="projects-h" data-reveal>
  <h2 id="projects-h">Projects</h2>
  <div class="pj" data-pj style={`--n: ${projects.length}`}>
    {projects.map((p, i) => (
      <article class:list={["pj__item", { "is-on": i === 0 }]} data-pj-item>
        <button
          class="pj__pick"
          type="button"
          aria-expanded={i === 0 ? "true" : "false"}
          aria-controls={`pj-${i}`}
          data-pj-pick
        >
          <span class="pj__name">{p.id}</span>
          <span class="pj__sub">{p.desc}</span>
        </button>
        <figure class="pj__fig" id={`pj-${i}`}>
          <figcaption class="pj__cap">
            {p.caption}
            {["home-lab", "flight-tracker"].includes(p.id) && (
              <span data-stats-age></span>
            )}
          </figcaption>
          <div class="pj__body">
            {p.id === "dissertation" && (
              <div class="tr">
                <div class="tr__plot">
                  <span>reward</span>
                  <div class="tr__area">
                    <svg
                      viewBox="38 8 274 124"
                      role="img"
                      aria-label="Reward over a 12 hour run: the 2026 GPU agent climbs early and plateaus high; the 2018 CPU agent climbs slowly"
                    >
                      <line
                        class="grid"
                        x1="40"
                        y1="30"
                        x2="310"
                        y2="30"
                      ></line>
                      <line
                        class="grid"
                        x1="40"
                        y1="60"
                        x2="310"
                        y2="60"
                      ></line>
                      <line
                        class="grid"
                        x1="40"
                        y1="90"
                        x2="310"
                        y2="90"
                      ></line>
                      <line class="ax" x1="40" y1="8" x2="40" y2="130"></line>
                      <line
                        class="ax"
                        x1="40"
                        y1="130"
                        x2="310"
                        y2="130"
                      ></line>
                      <path
                        class="old"
                        d="M40 128 C80 126 110 120 150 104 S230 70 310 62"
                      ></path>
                      <path
                        class="new"
                        d="M40 128 C55 120 62 90 80 70 S120 34 170 28 S260 22 310 20"
                      ></path>
                    </svg>
                    <span class="tr__lab tr__lab--new">2026 · gpu</span>
                    <span class="tr__lab tr__lab--old">2018 · cpu</span>
                  </div>
                  <span class="tr__x">
                    <span>0</span>
                    <span>12 h</span>
                  </span>
                </div>
                <div class="bars">
                  <span class="bars__t">one training run</span>
                  <span>2018</span>
                  <i>
                    <b style="--w: 100%"></b>
                  </i>
                  <em>12 h</em>
                  <span>2026</span>
                  <i class="hot">
                    <b style={`--w: ${runNow}`}></b>
                  </i>
                  <em class="hot">11 min</em>
                </div>
              </div>
            )}
            {p.id === "flight-tracker" && (
              <div class="rd">
                <canvas
                  data-radar
                  role="img"
                  aria-label="A simulated radar around Heathrow: planes circling the four holding stacks, landing and taking off"
                ></canvas>
                <div class="rd__nodes">
                  <span class="node">
                    <span class="node__k">tracking now</span>
                    <span class="node__v hot">
                      <b data-stat="tracking">–</b>
                    </span>
                    <span class="node__s">within 30 nm of heathrow</span>
                  </span>
                  <span class="node">
                    <span class="node__k">bound for london</span>
                    <span class="node__v">
                      <b data-stat="londonHour">–</b>
                    </span>
                    <span class="node__s">seen in the past hour</span>
                  </span>
                </div>
              </div>
            )}
            {p.id === "home-lab" && (
              <div class="dg dg--lab" data-edges="internet>host">
                <svg class="dg__edges" aria-hidden="true">
                  <path class="e"></path>
                  <path class="p"></path>
                </svg>
                <span class="node node--cloud" data-node="internet">
                  <Cloud />
                  <span class="node__k">internet</span>
                  <span class="node__s">cloudflare tunnel</span>
                </span>
                <div class="node node--host" data-node="host">
                  <span class="node__k">
                    <b>mini-PC</b> · {stacks.length} compose stacks
                  </span>
                  <ul class="lab">
                    {stacks.map((s) => {
                      const now = stackNow[s.id];
                      return (
                        <li class="node">
                          <span class="node__k">
                            <i
                              class="dot"
                              role="img"
                              aria-label="not reported"
                            ></i>
                            {s.id}
                          </span>
                          <span class="node__s">
                            {now ? (
                              <Fragment>
                                {`${now[0]} `}
                                <b data-stat={now[1]}>–</b>{" "}
                                <span>{now[2]}</span>
                              </Fragment>
                            ) : (
                              s.services
                            )}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            )}
            {p.id === "anki-chinese" && (
              <div class="ak">
                <p
                  class="ak__card"
                  aria-live="polite"
                  data-anki
                  data-cards={JSON.stringify(ankiCards)}
                >
                  <span class="ak__hz" lang="zh-Hans" data-anki-hanzi>
                    {ankiCards[0].hanzi}
                  </span>
                  <span class="ak__py">
                    <span data-anki-py>{ankiCards[0].pinyin}</span> ·
                    <span data-anki-jp>{ankiCards[0].jyutping}</span>
                  </span>
                  <span class="ak__mn" data-anki-mean>
                    {ankiCards[0].meaning}
                  </span>
                </p>
                <button class="ak__next" type="button" data-anki-next>
                  next card
                </button>
              </div>
            )}
            {p.id === "colincheung.dev" && (
              <div
                class="dg dg--deliver"
                data-edges="repo>build,build>edge,edge>you"
              >
                <svg class="dg__edges" aria-hidden="true">
                  <path class="e"></path>
                  <path class="p"></path>
                </svg>
                <span class="node" data-node="repo">
                  <span class="node__k">git push</span>
                  <span class="node__v">{build.hash || "main"}</span>
                  <span class="node__s">github</span>
                </span>
                <span class="node" data-node="build">
                  <span class="node__k">astro build</span>
                  <span class="node__v">
                    <b data-n={postCount}>{postCount}</b> posts
                  </span>
                  <span class="node__s">cloudflare workers</span>
                </span>
                <span class="node node--cloud" data-node="edge">
                  <Cloud />
                  <span class="node__k">cloudflare edge</span>
                  <span class="node__v">
                    <b data-n="330">330</b>
                  </span>
                  <span class="node__s">cities</span>
                </span>
                <span class="node" data-node="you">
                  <span class="node__k">you</span>
                  <span class="node__v hot">
                    <b data-n="0" data-ttfb>
                      –
                    </b>{" "}
                    ms
                  </span>
                  <span class="node__s">your first byte</span>
                </span>
              </div>
            )}
          </div>
          <a class="pj__link" href={p.href}>
            {p.repo} ↗
          </a>
        </figure>
      </article>
    ))}
  </div>
</section>

<style>
  .sec {
    max-width: var(--w-poster);
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) 0 0;
  }
  h2 {
    font-family: var(--head);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    margin-bottom: 0.9rem;
  }

  /* ---- The picker: the list in column one; the open item's figure spans
     every row of column two. The list keeps its own spacing and the
     figure's extra height goes to a last, empty row. The script arms it
     ([data-picker]); without JS every figure shows under its name. ---- */
  .pj {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.1rem 2.5rem;
  }
  @media (min-width: 56.01rem) {
    .pj[data-picker] {
      grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 2fr);
      grid-template-rows: repeat(var(--n), min-content) 1fr;
    }
  }
  .pj__item {
    display: contents;
  }
  .pj__pick {
    grid-column: 1;
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }
  .pj__name {
    position: relative;
    font-family: var(--head);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .pj__sub {
    font-size: 0.875rem;
    color: var(--faint);
  }
  .pj__pick:hover .pj__name,
  .is-on .pj__name {
    color: var(--ink);
  }
  .is-on .pj__sub {
    color: var(--muted);
  }
  /* The open project: a slash hanging in the margin, the same faint purple
     as the slashes between the companies, so the names stay flush with the
     heading. */
  [data-picker] .is-on .pj__name::before {
    content: "/";
    position: absolute;
    right: calc(100% + 0.45rem);
    font-weight: 300;
    color: var(--accent-line);
  }
  .pj__fig {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    min-width: 0;
    min-height: 22rem;
    margin: 0;
    padding: 1.25rem 1.5rem 1.2rem;
    background: var(--pane);
    border-radius: var(--r);
    container-type: inline-size;
  }
  [data-picker] .pj__fig {
    display: none;
  }
  [data-picker] .is-on .pj__fig {
    display: grid;
  }
  @media (min-width: 56.01rem) {
    [data-picker] .pj__fig {
      grid-column: 2;
      grid-row: 1 / -1;
    }
  }
  .pj__cap,
  .pj__link {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .pj__body {
    display: grid;
    align-items: center;
    min-width: 0;
  }
  .pj__link {
    justify-self: start;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .pj__link:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  /* Narrow: an accordion, each figure right under its name. */
  @media (max-width: 56rem) {
    .pj__fig {
      min-height: 0;
      margin: 0.3rem 0 0.7rem;
      padding: 1rem 1rem 1.1rem;
    }
  }

  /* ---- Nodes and edges, shared by the two diagrams. Edges are drawn by
     the script from the nodes' boxes; the dashes on top are the traffic. ---- */
  .dg {
    position: relative;
    display: grid;
    align-items: center;
    padding-top: 1.2rem;
  }
  .dg__edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .e {
    fill: none;
    stroke: var(--n7);
    stroke-width: 1.5;
  }
  /* The traffic on the edges is decoration, so neutral */
  .p {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-dasharray: 3 15;
    stroke-linecap: round;
    animation: flow 7s linear infinite;
  }
  /* Anything moving on its own stops while the pointer or focus is on it */
  .pj__fig:is(:hover, :focus-within) :is(.p, .dot) {
    animation-play-state: paused;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -72;
    }
  }
  .node {
    position: relative;
    z-index: 1;
    display: block;
    min-width: 0;
    padding: 0.7rem 0.85rem 0.75rem;
    background: var(--panel);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-ctl);
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--faint);
  }
  .node__k,
  .node__s {
    display: block;
  }
  .node__s {
    margin-top: 0.3rem;
  }
  .node__v {
    display: block;
    margin-top: 0.3rem;
    font-size: 1.25rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .node b {
    font-weight: 500;
    color: var(--ink);
  }
  .node__v b {
    font-weight: 400;
  }
  .node__v.hot,
  .node__v.hot b {
    color: var(--accent-text);
  }
  .node--cloud {
    padding: 1.1rem 1.5rem 0.7rem;
    background: none;
    border: 0;
    text-align: center;
  }
  .node--host {
    padding: 0.85rem 0.9rem 0.9rem;
    background: var(--well);
    border: 0;
    border-radius: var(--r);
  }
  .node--host > .node__k {
    margin-bottom: 0.6rem;
  }
  /* Grey until the home server reports every stack up in the last 20 min */
  .dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--faint);
  }
  [data-up] .dot {
    background: var(--ok9);
    animation: pulse 3s var(--ease-in-out) infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* home-lab: the internet comes in through the tunnel to the five stacks */
  .dg--lab {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: 1rem 2.5rem;
  }
  .lab {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .lab .node {
    padding: 0.5rem 0.65rem 0.55rem;
  }
  .lab .node:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  /* this site: push, build, the edge, you */
  .dg--deliver {
    grid-template-columns: 1fr 1fr 1.2fr 1fr;
    gap: 1rem 2rem;
  }

  /* dissertation: the reward curves, then one run's time as bars */
  .tr {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    align-items: center;
  }
  .tr__plot,
  .bars {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .tr__plot {
    display: grid;
    gap: 0.4rem;
    max-width: 34rem;
  }
  .tr__area {
    position: relative;
  }
  .tr__area svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid,
  .ax {
    stroke: var(--line);
    vector-effect: non-scaling-stroke;
  }
  .ax {
    stroke: var(--line-strong);
  }
  .old,
  .new {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .old {
    stroke: var(--bar);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
  }
  /* The 2026 curve in ink: the bar beside it is this figure's one purple */
  .new {
    stroke: var(--ink);
    stroke-width: 2;
  }
  /* The 2026 curve draws itself, left to right, each time it is shown. */
  [data-motion] .new {
    clip-path: inset(-4px 100% -4px -4px);
  }
  [data-motion] .is-drawn .new {
    animation: draw 2.6s var(--ease-out) 0.2s forwards;
  }
  @keyframes draw {
    to {
      clip-path: inset(-4px -4px -4px -4px);
    }
  }
  /* Series labels sit over the plot at the curves' own coordinates. */
  .tr__lab {
    position: absolute;
    transform: translateY(-100%);
    white-space: nowrap;
    color: var(--muted);
  }
  .tr__lab--new {
    left: 55%;
    top: 9%;
    color: var(--ink);
  }
  .tr__lab--old {
    left: 60%;
    top: 56%;
  }
  .tr__x {
    display: flex;
    justify-content: space-between;
  }
  .bars {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) 3.6rem;
    gap: 0.5rem 0.7rem;
    align-items: center;
  }
  .bars__t {
    grid-column: 1 / -1;
  }
  .bars i {
    display: block;
    height: 0.5rem;
    background: var(--well);
    border-radius: 2px;
    overflow: hidden;
  }
  .bars i b {
    display: block;
    width: var(--w);
    min-width: 3px;
    height: 100%;
    background: var(--bar);
  }
  .bars i.hot b {
    background: var(--accent);
  }
  .bars em {
    font-style: normal;
    text-align: right;
    color: var(--muted);
  }
  /* The 2026 bar carries the accent; its label stays ink */
  .bars em.hot {
    font-weight: 500;
    color: var(--ink);
  }

  /* flight-tracker: the scope, and two counts beside it */
  .rd {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.2rem 2rem;
    align-items: center;
  }
  .rd canvas {
    display: block;
    justify-self: center;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 1;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }
  .rd__nodes {
    display: grid;
    gap: 0.6rem;
  }

  /* anki-chinese: one card, and a button for the next */
  .ak {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
  }
  .ak__card {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    min-width: 13rem;
    padding: 1.4rem 2.2rem 1.2rem;
    background: var(--well);
    border-radius: var(--r);
    text-align: center;
  }
  .ak__hz {
    font-family: var(--cjk);
    font-size: 4rem;
    font-weight: 400;
    line-height: 1;
    color: var(--ink);
  }
  .ak__py {
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .ak__mn {
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .ak__next {
    padding: 0.35rem 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink);
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-ctl);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .ak__next:hover {
    background: var(--accent-hover);
    border-color: var(--accent-solid);
  }

  /* A figure narrower than its diagram stacks it; the edges then run top
     to bottom. The extra row gap leaves room for a cloud's bumps. */
  @container (max-width: 40rem) {
    .tr,
    .rd,
    .dg--lab,
    .dg--deliver {
      grid-template-columns: minmax(0, 1fr);
    }
    .dg {
      row-gap: 2.6rem;
      padding-top: 1.7rem;
    }
    .rd__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* A phone: the stacks one per row, so names like observability stay on
     one line with their dot. */
  @container (max-width: 28rem) {
    .lab {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p {
      display: none;
    }
    [data-up] .dot {
      animation: none;
    }
  }
</style>

<script>
  import { still as reduce } from "../../scripts/in-view";
  import { radar } from "./projects/radar";

  type Card = {
    hanzi: string;
    pinyin: string;
    jyutping: string;
    meaning: string;
  };

  const pj = document.querySelector<HTMLElement>("[data-pj]");

  if (pj) {
    // Without this the curve is simply drawn (no JS, or reduced motion).
    if (!reduce) pj.dataset.motion = "";
    pj.dataset.picker = "";
    const items = [...pj.querySelectorAll<HTMLElement>("[data-pj-item]")];
    const canvas = pj.querySelector<HTMLCanvasElement>("[data-radar]");
    const scope = canvas ? radar(canvas, reduce) : null;
    const isOpen = (it: HTMLElement) => it.classList.contains("is-on");
    const sideBySide = matchMedia("(min-width: 56.01rem)");
    let inView = false;

    // Numbers count up from zero the first time they are shown.
    const fmt = (v: number) => Math.round(v).toLocaleString("en-GB");
    const counted = new WeakSet<HTMLElement>();
    // This visit's own time to first byte, from the browser's timing of the
    // page request; without it the dash stays.
    const nav = performance.getEntriesByType("navigation")[0] as
      | PerformanceNavigationTiming
      | undefined;
    const ttfb = pj.querySelector<HTMLElement>("[data-ttfb]");
    if (ttfb && nav && nav.responseStart > 0) {
      ttfb.dataset.n = String(
        Math.max(1, Math.round(nav.responseStart - nav.startTime)),
      );
      ttfb.textContent = ttfb.dataset.n;
    } else ttfb?.removeAttribute("data-n");
    const countUp = (el: HTMLElement) => {
      counted.add(el);
      if (reduce) return;
      const t0 = performance.now();
      const frame = (t: number) => {
        if (el.dataset.n === undefined) return;
        const e = 1 - (1 - Math.min(1, (t - t0) / 1400)) ** 3;
        el.textContent = fmt(Number(el.dataset.n) * e);
        if (e < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    };

    // The home server's numbers (worker/index.ts), gathered every five
    // minutes, fetched again as often while the tab is open. Older than 20
    // minutes, the dots go grey and the captions say when they were last
    // seen; unreachable, the dashes stay.
    const ages = pj.querySelectorAll<HTMLElement>("[data-stats-age]");
    const lab = pj.querySelector<HTMLElement>(".dg--lab");
    let stats: Record<string, number | boolean | null> | undefined;
    const say = () => {
      if (!stats) return;
      const mins = Math.max(
        0,
        Math.round((Date.now() / 1000 - Number(stats.at)) / 60),
      );
      const fresh = mins <= 20;
      const ago =
        mins < 2
          ? "just now"
          : mins < 120
            ? `${mins} min ago`
            : `${Math.round(mins / 60)} h ago`;
      for (const a of ages)
        a.textContent = fresh ? ` · live, ${ago}` : ` · last seen ${ago}`;
      const up = fresh && !!stats.allUp;
      lab?.toggleAttribute("data-up", up);
      for (const d of lab?.querySelectorAll(".dot") ?? [])
        d.setAttribute("aria-label", up ? "up" : "not reported");
    };
    const load = () =>
      fetch("/homelab.json")
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((s: Record<string, number | boolean | null>) => {
          stats = s;
          say();
          for (const el of pj.querySelectorAll<HTMLElement>("[data-stat]")) {
            const v = s[el.dataset.stat!];
            if (typeof v !== "number") {
              // Not reported this time: back to a dash, not the old number.
              delete el.dataset.n;
              el.textContent = "–";
              continue;
            }
            el.dataset.n = String(v);
            el.textContent = fmt(v);
            // On screen for the first time: count up now; otherwise when it
            // is shown. A later fetch just puts the new number in.
            if (!counted.has(el) && el.closest(".is-drawn")) countUp(el);
          }
        })
        .catch(() => {
          if (stats) say();
          else for (const a of ages) a.textContent = " · offline";
        });
    load();
    setInterval(() => {
      if (!document.hidden) load();
    }, 300_000);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) say();
    });

    // Edges from box to box: side to side when the next node is to the right,
    // top to bottom when the diagram is stacked.
    const draw = (dg: HTMLElement) => {
      const R = dg.getBoundingClientRect();
      if (!R.width) return;
      const svg = dg.querySelector("svg")!;
      svg.setAttribute("viewBox", `0 0 ${R.width} ${R.height}`);
      const box = (n: string) =>
        dg.querySelector(`[data-node="${n}"]`)!.getBoundingClientRect();
      let d = "";
      for (const [a, b] of dg.dataset
        .edges!.split(",")
        .map((s) => s.split(">"))) {
        const A = box(a);
        const B = box(b);
        if (B.left >= A.right - 1) {
          const [x1, y1] = [A.right - R.left, A.top + A.height / 2 - R.top];
          const [x2, y2] = [B.left - R.left, B.top + B.height / 2 - R.top];
          const c = (x2 - x1) / 2;
          d += `M${x1} ${y1} C${x1 + c} ${y1} ${x2 - c} ${y2} ${x2} ${y2} `;
        } else {
          const [x1, y1] = [A.left + A.width / 2 - R.left, A.bottom - R.top];
          const [x2, y2] = [B.left + B.width / 2 - R.left, B.top - R.top];
          const c = (y2 - y1) / 2;
          d += `M${x1} ${y1} C${x1} ${y1 + c} ${x2} ${y2 - c} ${x2} ${y2} `;
        }
      }
      for (const path of svg.querySelectorAll("path"))
        path.setAttribute("d", d);
    };
    const drawOpen = () => {
      const it = items.find(isOpen);
      if (it)
        for (const dg of it.querySelectorAll<HTMLElement>(".dg")) draw(dg);
    };

    // The radar runs only while it is open, on screen, not held by the
    // pointer or focus, and the tab is visible.
    let held = false;
    const scopeFig = canvas?.closest<HTMLElement>(".pj__fig");
    for (const [ev, on] of [
      ["pointerenter", true],
      ["pointerleave", false],
      ["focusin", true],
      ["focusout", false],
    ] as const)
      scopeFig?.addEventListener(ev, () => {
        held = on;
        runScope();
      });
    const runScope = () =>
      scope?.run(
        inView &&
          !held &&
          !document.hidden &&
          !!items.find(isOpen)?.contains(canvas),
      );

    const show = (it: HTMLElement, replay: boolean) => {
      const fig = it.querySelector<HTMLElement>(".pj__fig")!;
      if (replay) {
        fig.classList.remove("is-drawn");
        void fig.offsetWidth;
      }
      fig.classList.add("is-drawn");
      for (const el of fig.querySelectorAll<HTMLElement>("[data-n]"))
        if (!counted.has(el)) countUp(el);
      drawOpen();
      runScope();
    };
    const pick = (it: HTMLElement) => {
      if (isOpen(it)) return;
      for (const o of items) {
        o.classList.toggle("is-on", o === it);
        o.querySelector("[data-pj-pick]")!.setAttribute(
          "aria-expanded",
          String(o === it),
        );
      }
      if (inView) show(it, true);
      else runScope();
    };
    for (const it of items) {
      const b = it.querySelector<HTMLElement>("[data-pj-pick]")!;
      for (const ev of ["click", "focus"])
        b.addEventListener(ev, () => pick(it));
      // A moving mouse, not pointerenter: a still pointer that the page
      // scrolls under would otherwise switch the figure mid-scroll. Only side
      // by side: stacked, opening one moves the list under the pointer.
      b.addEventListener("pointermove", (e) => {
        if (e.pointerType === "mouse" && sideBySide.matches) pick(it);
      });
    }

    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        const it = items.find(isOpen);
        if (inView && it) show(it, false);
        else runScope();
      },
      { threshold: 0.2 },
    ).observe(pj);
    document.addEventListener("visibilitychange", runScope);
    new ResizeObserver(drawOpen).observe(pj);
    document.fonts.ready.then(drawOpen);

    // anki: a real card from the deck, a random one first, the next on asking.
    const card = pj.querySelector<HTMLElement>("[data-anki]");
    if (card) {
      const cards = JSON.parse(card.dataset.cards!) as Card[];
      let at = Math.floor(Math.random() * cards.length);
      const put = () => {
        const c = cards[at];
        card.querySelector("[data-anki-hanzi]")!.textContent = c.hanzi;
        card.querySelector("[data-anki-py]")!.textContent = c.pinyin;
        card.querySelector("[data-anki-jp]")!.textContent = c.jyutping;
        card.querySelector("[data-anki-mean]")!.textContent = c.meaning;
      };
      put();
      pj.querySelector("[data-anki-next]")!.addEventListener("click", () => {
        at = (at + 1) % cards.length;
        put();
      });
    }
  }
</script>
