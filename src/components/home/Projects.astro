---
// The homepage's projects: a picker. The names are a plain list on the left;
// the open one shows its figure on the right, one panel at a time (an
// accordion on narrow screens). Each figure is a small live piece of the
// project: the dissertation's training curve, a simulated London radar, the
// homelab's stacks, a card from the deck and how this page got to you.
// Projects: src/data/projects.json; stacks: homelab-stacks.json; cards:
// anki-cards.json. The radar's simulation is projects/radar.ts.
import { getCollection } from "astro:content";
import ankiCards from "../../data/anki-cards.json";
import Cloud from "./projects/Cloud.astro";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, ...data }));
const stacks = (await getCollection("homelabStacks"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, ...data }));

// What each stack's node says instead of its service list. The two counts
// tick up while the page is open; [data-live] keeps every copy of one in step.
const stackNow: Record<
  string,
  { label: string; n: number; live: string; every: number } | string
> = {
  crowdsec: { label: "blocked", n: 1284, live: "blocked", every: 4000 },
  "flight-tracker": { label: "seen today", n: 212, live: "seen", every: 7000 },
  "home-assistant": "19.5°C inside",
  backup: "restic, nightly at 03:00",
};

// One training run: 12 hours in 2018, 11 minutes in 2026.
const runNow = `${((11 / (12 * 60)) * 100).toFixed(2)}%`;
---

<section class="sec" id="projects" aria-labelledby="projects-h" data-reveal>
  <h2 id="projects-h">Projects</h2>
  <div class="pj" data-pj style={`--n: ${projects.length}`}>
    {projects.map((p, i) => (
      <article class:list={["pj__item", { "is-on": i === 0 }]} data-pj-item>
        <button
          class="pj__pick"
          type="button"
          aria-expanded={i === 0 ? "true" : "false"}
          aria-controls={`pj-${i}`}
          data-pj-pick
        >
          <span class="pj__name">{p.id}</span>
          <span class="pj__sub">{p.desc}</span>
        </button>
        <figure class="pj__fig" id={`pj-${i}`}>
          <figcaption class="pj__cap">{p.caption}</figcaption>
          <div class="pj__body">
            {p.id === "dissertation" && (
              <div class="tr">
                <div class="tr__plot">
                  <span>reward</span>
                  <div class="tr__area">
                    <svg
                      viewBox="38 8 274 124"
                      role="img"
                      aria-label="Reward over a 12 hour run: the 2026 GPU agent climbs early and plateaus high; the 2018 CPU agent climbs slowly"
                    >
                      <line
                        class="grid"
                        x1="40"
                        y1="30"
                        x2="310"
                        y2="30"
                      ></line>
                      <line
                        class="grid"
                        x1="40"
                        y1="60"
                        x2="310"
                        y2="60"
                      ></line>
                      <line
                        class="grid"
                        x1="40"
                        y1="90"
                        x2="310"
                        y2="90"
                      ></line>
                      <line class="ax" x1="40" y1="8" x2="40" y2="130"></line>
                      <line
                        class="ax"
                        x1="40"
                        y1="130"
                        x2="310"
                        y2="130"
                      ></line>
                      <path
                        class="old"
                        d="M40 128 C80 126 110 120 150 104 S230 70 310 62"
                      ></path>
                      <path
                        class="new"
                        d="M40 128 C55 120 62 90 80 70 S120 34 170 28 S260 22 310 20"
                      ></path>
                    </svg>
                    <span class="tr__lab tr__lab--new">2026 · gpu</span>
                    <span class="tr__lab tr__lab--old">2018 · cpu</span>
                  </div>
                  <span class="tr__x">
                    <span>0</span>
                    <span>12 h</span>
                  </span>
                </div>
                <div class="bars">
                  <span class="bars__t">one training run</span>
                  <span>2018</span>
                  <i>
                    <b style="--w: 100%"></b>
                  </i>
                  <em>12 h</em>
                  <span>2026</span>
                  <i class="hot">
                    <b style={`--w: ${runNow}`}></b>
                  </i>
                  <em class="hot">11 min</em>
                </div>
              </div>
            )}
            {p.id === "flight-tracker" && (
              <div class="rd">
                <canvas
                  data-radar
                  role="img"
                  aria-label="A simulated radar around Heathrow: planes circling the four holding stacks, landing and taking off"
                ></canvas>
                <div class="rd__nodes">
                  <span class="node">
                    <span class="node__k">seen today</span>
                    <span class="node__v">
                      <b data-n="212" data-live="seen">
                        212
                      </b>
                    </span>
                    <span class="node__s">ads-b, one antenna</span>
                  </span>
                  <span class="node">
                    <span class="node__k">tracking now</span>
                    <span class="node__v hot">
                      <b data-n="7">7</b>
                    </span>
                    <span class="node__s">two with callsigns</span>
                  </span>
                </div>
              </div>
            )}
            {p.id === "home-lab" && (
              <div class="dg dg--lab" data-edges="internet>host">
                <svg class="dg__edges" aria-hidden="true">
                  <path class="e"></path>
                  <path class="p"></path>
                </svg>
                <span class="node node--cloud" data-node="internet">
                  <Cloud />
                  <span class="node__k">internet</span>
                  <span class="node__s">cloudflare tunnel</span>
                </span>
                <div class="node node--host" data-node="host">
                  <span class="node__k">
                    <b>mini-PC</b> · {stacks.length} compose stacks
                  </span>
                  <ul class="lab">
                    {stacks.map((s) => {
                      const now = stackNow[s.id];
                      return (
                        <li class="node">
                          <span class="node__k">
                            <i class="dot" role="img" aria-label="up"></i>
                            {s.id}
                          </span>
                          <span class="node__s">
                            {typeof now === "object" ? (
                              <Fragment>
                                {now.label}{" "}
                                <b
                                  data-n={now.n}
                                  data-live={now.live}
                                  data-every={now.every}
                                >
                                  {now.n.toLocaleString("en-GB")}
                                </b>
                              </Fragment>
                            ) : (
                              (now ?? s.services)
                            )}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            )}
            {p.id === "anki-chinese" && (
              <div class="ak">
                <p
                  class="ak__card"
                  aria-live="polite"
                  data-anki
                  data-cards={JSON.stringify(ankiCards)}
                >
                  <span class="ak__hz" lang="zh-Hans" data-anki-hanzi>
                    {ankiCards[0].hanzi}
                  </span>
                  <span class="ak__py">
                    <span data-anki-py>{ankiCards[0].pinyin}</span> ·
                    <span data-anki-jp>{ankiCards[0].jyutping}</span>
                  </span>
                  <span class="ak__mn" data-anki-mean>
                    {ankiCards[0].meaning}
                  </span>
                </p>
                <button class="ak__next" type="button" data-anki-next>
                  next card
                </button>
              </div>
            )}
            {p.id === "colincheung.dev" && (
              <div
                class="dg dg--deliver"
                data-edges="repo>build,build>edge,edge>you"
              >
                <svg class="dg__edges" aria-hidden="true">
                  <path class="e"></path>
                  <path class="p"></path>
                </svg>
                <span class="node" data-node="repo">
                  <span class="node__k">git push</span>
                  <span class="node__v">main</span>
                  <span class="node__s">github</span>
                </span>
                <span class="node" data-node="build">
                  <span class="node__k">astro build</span>
                  <span class="node__v">
                    <b data-n="14">14</b> s
                  </span>
                  <span class="node__s">cloudflare workers</span>
                </span>
                <span class="node node--cloud" data-node="edge">
                  <Cloud />
                  <span class="node__k">cloudflare edge</span>
                  <span class="node__v">
                    <b data-n="330">330</b>
                  </span>
                  <span class="node__s">cities</span>
                </span>
                <span class="node" data-node="you">
                  <span class="node__k">you</span>
                  <span class="node__v hot">
                    <b data-n="24">24</b> ms
                  </span>
                  <span class="node__s">first byte</span>
                </span>
              </div>
            )}
          </div>
          <a class="pj__link" href={p.href}>
            {p.repo} ↗
          </a>
        </figure>
      </article>
    ))}
  </div>
</section>

<style>
  .sec {
    max-width: var(--w-poster);
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) 0 0;
  }
  h2 {
    font-family: var(--head);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    margin-bottom: 0.9rem;
  }

  /* ---- The picker: the list in column one; the open item's figure spans
     every row of column two. The list keeps its own spacing and the
     figure's extra height goes to a last, empty row. ---- */
  .pj {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 2fr);
    grid-template-rows: repeat(var(--n), min-content) 1fr;
    gap: 0.1rem 2.5rem;
  }
  .pj__item {
    display: contents;
  }
  .pj__pick {
    grid-column: 1;
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }
  .pj__name {
    position: relative;
    font-family: var(--head);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .pj__sub {
    font-size: 0.875rem;
    color: var(--faint);
  }
  .pj__pick:hover .pj__name,
  .is-on .pj__name {
    color: var(--ink);
  }
  .is-on .pj__sub {
    color: var(--muted);
  }
  /* The open project: a violet slash hanging in the margin, like the
     slashes between the companies, so the names stay flush with the
     heading. */
  .is-on .pj__name::before {
    content: "/";
    position: absolute;
    right: calc(100% + 0.45rem);
    font-weight: 300;
    color: var(--accent);
  }
  .pj__fig {
    grid-column: 2;
    grid-row: 1 / -1;
    display: none;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    min-width: 0;
    min-height: 22rem;
    margin: 0;
    padding: 1.25rem 1.5rem 1.2rem;
    background: var(--pane);
    border-radius: var(--r);
    container-type: inline-size;
  }
  .is-on .pj__fig {
    display: grid;
  }
  .pj__cap,
  .pj__link {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .pj__body {
    display: grid;
    align-items: center;
    min-width: 0;
  }
  .pj__link {
    justify-self: start;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }
  .pj__link:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  /* Narrow: an accordion, each figure right under its name. */
  @media (max-width: 56rem) {
    .pj {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }
    .pj__fig {
      grid-column: 1;
      grid-row: auto;
      min-height: 0;
      margin: 0.3rem 0 0.7rem;
      padding: 1rem 1rem 1.1rem;
    }
  }

  /* ---- Nodes and edges, shared by the two diagrams. Edges are drawn by
     the script from the nodes' boxes; the dashes on top are the traffic. ---- */
  .dg {
    position: relative;
    display: grid;
    align-items: center;
    padding-top: 1.2rem;
  }
  .dg__edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .e {
    fill: none;
    stroke: var(--n7);
    stroke-width: 1.5;
  }
  .p {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 3 15;
    stroke-linecap: round;
    animation: flow 7s linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -72;
    }
  }
  .node {
    position: relative;
    z-index: 1;
    display: block;
    min-width: 0;
    padding: 0.7rem 0.85rem 0.75rem;
    background: var(--panel);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-ctl);
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--faint);
  }
  .node__k,
  .node__s {
    display: block;
  }
  .node__s {
    margin-top: 0.3rem;
  }
  .node__v {
    display: block;
    margin-top: 0.3rem;
    font-size: 1.25rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .node b {
    font-weight: 500;
    color: var(--ink);
  }
  .node__v b {
    font-weight: 400;
  }
  .node__v.hot,
  .node__v.hot b {
    color: var(--accent-text);
  }
  .node--cloud {
    padding: 1.1rem 1.5rem 0.7rem;
    background: none;
    border: 0;
    text-align: center;
  }
  .node--host {
    padding: 0.85rem 0.9rem 0.9rem;
    background: var(--well);
    border: 0;
    border-radius: var(--r);
  }
  .node--host > .node__k {
    margin-bottom: 0.6rem;
  }
  .dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--ok9);
    animation: pulse 3s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  /* home-lab: the internet comes in through the tunnel to the five stacks */
  .dg--lab {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: 1rem 2.5rem;
  }
  .lab {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .lab .node {
    padding: 0.5rem 0.65rem 0.55rem;
  }
  .lab .node:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  /* this site: push, build, the edge, you */
  .dg--deliver {
    grid-template-columns: 1fr 1fr 1.2fr 1fr;
    gap: 1rem 2rem;
  }

  /* dissertation: the reward curves, then one run's time as bars */
  .tr {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    align-items: center;
  }
  .tr__plot,
  .bars {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .tr__plot {
    display: grid;
    gap: 0.4rem;
    max-width: 34rem;
  }
  .tr__area {
    position: relative;
  }
  .tr__area svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid,
  .ax {
    stroke: var(--line);
    vector-effect: non-scaling-stroke;
  }
  .ax {
    stroke: var(--line-strong);
  }
  .old,
  .new {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .old {
    stroke: var(--bar);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
  }
  .new {
    stroke: var(--accent);
    stroke-width: 2;
  }
  /* The 2026 curve draws itself, left to right, each time it is shown. */
  [data-motion] .new {
    clip-path: inset(-4px 100% -4px -4px);
  }
  [data-motion] .is-drawn .new {
    animation: draw 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s forwards;
  }
  @keyframes draw {
    to {
      clip-path: inset(-4px -4px -4px -4px);
    }
  }
  /* Series labels sit over the plot at the curves' own coordinates. */
  .tr__lab {
    position: absolute;
    transform: translateY(-100%);
    white-space: nowrap;
    color: var(--muted);
  }
  .tr__lab--new {
    left: 55%;
    top: 9%;
    color: var(--accent-text);
  }
  .tr__lab--old {
    left: 60%;
    top: 56%;
  }
  .tr__x {
    display: flex;
    justify-content: space-between;
  }
  .bars {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) 3.6rem;
    gap: 0.5rem 0.7rem;
    align-items: center;
  }
  .bars__t {
    grid-column: 1 / -1;
  }
  .bars i {
    display: block;
    height: 0.5rem;
    background: var(--well);
    border-radius: 2px;
    overflow: hidden;
  }
  .bars i b {
    display: block;
    width: var(--w);
    min-width: 3px;
    height: 100%;
    background: var(--bar);
  }
  .bars i.hot b {
    background: var(--accent);
  }
  .bars em {
    font-style: normal;
    text-align: right;
    color: var(--muted);
  }
  .bars em.hot {
    font-weight: 500;
    color: var(--accent-text);
  }

  /* flight-tracker: the scope, and two counts beside it */
  .rd {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.2rem 2rem;
    align-items: center;
  }
  .rd canvas {
    display: block;
    justify-self: center;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 1;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }
  .rd__nodes {
    display: grid;
    gap: 0.6rem;
  }

  /* anki-chinese: one card, and a button for the next */
  .ak {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
  }
  .ak__card {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    min-width: 13rem;
    padding: 1.4rem 2.2rem 1.2rem;
    background: var(--well);
    border-radius: var(--r);
    text-align: center;
  }
  .ak__hz {
    font-family: var(--cjk);
    font-size: 4rem;
    font-weight: 400;
    line-height: 1;
    color: var(--ink);
  }
  .ak__py {
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .ak__mn {
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .ak__next {
    padding: 0.35rem 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink);
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-ctl);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .ak__next:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  /* A figure narrower than its diagram stacks it; the edges then run top
     to bottom. The extra row gap leaves room for a cloud's bumps. */
  @container (max-width: 40rem) {
    .tr,
    .rd,
    .dg--lab,
    .dg--deliver {
      grid-template-columns: minmax(0, 1fr);
    }
    .dg {
      row-gap: 2.6rem;
      padding-top: 1.7rem;
    }
    .rd__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* A phone: the stacks one per row, so names like observability stay on
     one line with their dot. */
  @container (max-width: 28rem) {
    .lab {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p {
      display: none;
    }
    .dot {
      animation: none;
    }
  }
</style>

<script>
  import { radar } from "./projects/radar";

  type Card = {
    hanzi: string;
    pinyin: string;
    jyutping: string;
    meaning: string;
  };

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const pj = document.querySelector<HTMLElement>("[data-pj]");

  if (pj) {
    // Without this the curve is simply drawn (no JS, or reduced motion).
    if (!reduce) pj.dataset.motion = "";
    const items = [...pj.querySelectorAll<HTMLElement>("[data-pj-item]")];
    const canvas = pj.querySelector<HTMLCanvasElement>("[data-radar]");
    const scope = canvas ? radar(canvas, reduce) : null;
    const isOpen = (it: HTMLElement) => it.classList.contains("is-on");
    let inView = false;

    // Numbers count up from zero the first time they are shown. The live ones
    // keep one value per name, so the radar and the home-lab agree.
    const fmt = (v: number) => Math.round(v).toLocaleString("en-GB");
    const live = new Map<string, number>();
    const counted = new WeakSet<HTMLElement>();
    const counting = new WeakSet<HTMLElement>();
    const target = (el: HTMLElement) =>
      el.dataset.live ? live.get(el.dataset.live)! : Number(el.dataset.n);
    for (const el of pj.querySelectorAll<HTMLElement>("[data-live]"))
      live.set(el.dataset.live!, Number(el.dataset.n));
    const countUp = (el: HTMLElement) => {
      counted.add(el);
      if (reduce) return;
      counting.add(el);
      const t0 = performance.now();
      const frame = (t: number) => {
        const e = 1 - (1 - Math.min(1, (t - t0) / 1400)) ** 3;
        el.textContent = fmt(target(el) * e);
        if (e < 1) requestAnimationFrame(frame);
        else counting.delete(el);
      };
      requestAnimationFrame(frame);
    };
    let ticking = false;
    const tick = () => {
      if (ticking || reduce) return;
      ticking = true;
      for (const el of pj.querySelectorAll<HTMLElement>("[data-every]")) {
        const key = el.dataset.live!;
        setInterval(() => {
          const v = live.get(key)! + 0.6 + Math.random() * 0.8;
          live.set(key, v);
          for (const o of pj.querySelectorAll<HTMLElement>(
            `[data-live="${key}"]`,
          ))
            if (!counting.has(o)) o.textContent = fmt(v);
        }, Number(el.dataset.every));
      }
    };

    // Edges from box to box: side to side when the next node is to the right,
    // top to bottom when the diagram is stacked.
    const draw = (dg: HTMLElement) => {
      const R = dg.getBoundingClientRect();
      if (!R.width) return;
      const svg = dg.querySelector("svg")!;
      svg.setAttribute("viewBox", `0 0 ${R.width} ${R.height}`);
      const box = (n: string) =>
        dg.querySelector(`[data-node="${n}"]`)!.getBoundingClientRect();
      let d = "";
      for (const [a, b] of dg.dataset
        .edges!.split(",")
        .map((s) => s.split(">"))) {
        const A = box(a);
        const B = box(b);
        if (B.left >= A.right - 1) {
          const [x1, y1] = [A.right - R.left, A.top + A.height / 2 - R.top];
          const [x2, y2] = [B.left - R.left, B.top + B.height / 2 - R.top];
          const c = (x2 - x1) / 2;
          d += `M${x1} ${y1} C${x1 + c} ${y1} ${x2 - c} ${y2} ${x2} ${y2} `;
        } else {
          const [x1, y1] = [A.left + A.width / 2 - R.left, A.bottom - R.top];
          const [x2, y2] = [B.left + B.width / 2 - R.left, B.top - R.top];
          const c = (y2 - y1) / 2;
          d += `M${x1} ${y1} C${x1} ${y1 + c} ${x2} ${y2 - c} ${x2} ${y2} `;
        }
      }
      for (const path of svg.querySelectorAll("path"))
        path.setAttribute("d", d);
    };
    const drawOpen = () => {
      const it = items.find(isOpen);
      if (it)
        for (const dg of it.querySelectorAll<HTMLElement>(".dg")) draw(dg);
    };

    // The radar runs only while it is open, on screen and the tab is visible.
    const runScope = () =>
      scope?.run(
        inView && !document.hidden && !!items.find(isOpen)?.contains(canvas),
      );

    const show = (it: HTMLElement, replay: boolean) => {
      const fig = it.querySelector<HTMLElement>(".pj__fig")!;
      if (replay) {
        fig.classList.remove("is-drawn");
        void fig.offsetWidth;
      }
      fig.classList.add("is-drawn");
      for (const el of fig.querySelectorAll<HTMLElement>("[data-n]"))
        if (!counted.has(el)) countUp(el);
      drawOpen();
      runScope();
      tick();
    };
    const pick = (it: HTMLElement) => {
      if (isOpen(it)) return;
      for (const o of items) {
        o.classList.toggle("is-on", o === it);
        o.querySelector("[data-pj-pick]")!.setAttribute(
          "aria-expanded",
          String(o === it),
        );
      }
      if (inView) show(it, true);
      else runScope();
    };
    for (const it of items) {
      const b = it.querySelector("[data-pj-pick]")!;
      for (const ev of ["click", "focus", "pointerenter"])
        b.addEventListener(ev, () => pick(it));
    }

    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        const it = items.find(isOpen);
        if (inView && it) show(it, false);
        else runScope();
      },
      { threshold: 0.2 },
    ).observe(pj);
    document.addEventListener("visibilitychange", runScope);
    new ResizeObserver(drawOpen).observe(pj);
    document.fonts.ready.then(drawOpen);

    // anki: a real card from the deck, a random one first, the next on asking.
    const card = pj.querySelector<HTMLElement>("[data-anki]");
    if (card) {
      const cards = JSON.parse(card.dataset.cards!) as Card[];
      let at = Math.floor(Math.random() * cards.length);
      const put = () => {
        const c = cards[at];
        card.querySelector("[data-anki-hanzi]")!.textContent = c.hanzi;
        card.querySelector("[data-anki-py]")!.textContent = c.pinyin;
        card.querySelector("[data-anki-jp]")!.textContent = c.jyutping;
        card.querySelector("[data-anki-mean]")!.textContent = c.meaning;
      };
      put();
      pj.querySelector("[data-anki-next]")!.addEventListener("click", () => {
        at = (at + 1) % cards.length;
        put();
      });
    }
  }
</script>
