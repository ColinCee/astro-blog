---
// One tmux pane of the homepage terminal: a numbered title bar over a body.
// `area` places it in the terminal's grid; the active pane is outlined.
interface Props {
  idx: number;
  name: string;
  area: "who" | "ship" | "writing";
  active?: boolean;
}
const { idx, name, area, active = false } = Astro.props;
---

<!-- Holds the scroll-in entrances from the first paint, before the module script
     below runs; otherwise a short delay (the writing lines' 0.1s) can start
     playing first and get paused part-way in. Same conditions as that script. -->
<script is:inline>
  if (
    matchMedia("(max-width: 900px)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  )
    document.documentElement.classList.add("hold-in");
</script>

<article
  class:list={["pane", `pane--${area}`, { "is-active": active }]}
  data-scroll-in
>
  <h2 class="pane__bar">
    <span class="pane__idx">{idx}</span>
    {name}
  </h2>
  <div class="pane__body">
    <slot />
  </div>
</article>

<style>
  .pane {
    background: var(--pane);
    display: flex;
    flex-direction: column;
    min-width: 0;
    animation: rise var(--dur-slow) var(--ease-out) both;
  }
  .pane--who {
    grid-area: who;
    animation-delay: 0.12s;
  }
  .pane--ship {
    grid-area: hl;
    animation-delay: 0.2s;
  }
  .pane--writing {
    grid-area: writing;
    animation-delay: 0.28s;
  }
  /* On a phone the panes stack, so each waits for its turn on screen. */
  @media (max-width: 900px) {
    .pane--ship,
    .pane--writing {
      /* A beat, so the hold lands before the first frame of the rise. */
      animation-delay: 0.1s;
    }
  }
  .pane.is-active {
    box-shadow: inset 0 0 0 1.5px
      color-mix(in oklch, var(--accent) 55%, transparent);
  }
  .pane__bar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.95rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklch, var(--panel) 60%, transparent);
  }
  .pane.is-active .pane__bar {
    color: var(--accent-text);
  }
  .pane__idx {
    display: inline-grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.25rem;
    border-radius: 5px;
    background: color-mix(in oklch, var(--accent) 18%, transparent);
    color: var(--accent-text);
    font-size: 0.6875rem;
  }
  .pane__body {
    padding: 1.05rem 1.1rem 1.2rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.55;
    flex: 1;
  }
</style>

<script>
  // On a phone, where the panes stack, anything marked data-scroll-in holds
  // its entrance (and its children's) until it scrolls into view. Desktop
  // plays its sequence on load: a held element's delay only counts down once
  // released, so holding there would leave a pane empty for seconds. Armed by
  // JS only, so without it (or with reduced motion) everything plays on load.
  const items = document.querySelectorAll<HTMLElement>("[data-scroll-in]");
  if (
    items.length &&
    matchMedia("(max-width: 900px)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.remove("is-held");
          io.unobserve(e.target);
        });
      },
      { rootMargin: "0px 0px -12% 0px" },
    );
    items.forEach((el) => {
      el.classList.add("is-held");
      io.observe(el);
    });
    // Tabbing into something held (at opacity 0) shows it straight away.
    document.addEventListener("focusin", (e) => {
      let held = (e.target as Element).closest?.(".is-held");
      while (held) {
        held.classList.remove("is-held");
        io.unobserve(held);
        held = held.closest(".is-held");
      }
    });
  }
  document.documentElement.classList.remove("hold-in");
</script>

<style is:global>
  /* A held animation sits on its first frame (fill: both) until released. */
  .is-held,
  .is-held *,
  .hold-in [data-scroll-in],
  .hold-in [data-scroll-in] * {
    animation-play-state: paused !important;
  }
  /* Printed, nothing waits for a scroll. */
  @media print {
    .is-held,
    .is-held * {
      animation: none !important;
    }
  }
</style>
