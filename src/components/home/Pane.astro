---
// One pane of the homepage terminal. `area` places it in the terminal's grid;
// `name` titles it for screen readers (the commands in it title it on screen).
interface Props {
  name: string;
  area: "who" | "writing";
}
const { name, area } = Astro.props;
---

<!-- Holds the scroll-in entrances from the first paint, before the module script
     below runs; otherwise a short delay (the writing lines' 0.1s) can start
     playing first and get paused part-way in. Same conditions as that script. -->
<script is:inline>
  if (
    matchMedia("(max-width: 900px)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  )
    document.documentElement.classList.add("hold-in");
</script>

<article class:list={["pane", `pane--${area}`]} data-scroll-in>
  <h2 class="pane__name">{name}</h2>
  <div class="pane__body">
    <slot />
  </div>
</article>

<style>
  .pane {
    background: var(--pane);
    display: flex;
    flex-direction: column;
    min-width: 0;
    animation: rise var(--dur-slow) var(--ease-out) both;
  }
  .pane--who {
    grid-area: who;
    animation-delay: calc(2 * var(--stagger));
  }
  .pane--writing {
    grid-area: writing;
    animation-delay: calc(4 * var(--stagger));
  }
  /* On a phone the panes stack, so each waits for its turn on screen. */
  @media (max-width: 900px) {
    .pane--writing {
      /* A beat, so the hold lands before the first frame of the rise. */
      animation-delay: 0.1s;
    }
  }
  /* Visually hidden: the pane's commands say what it is. */
  .pane__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .pane__body {
    padding: 1.1rem 1.3rem 1.3rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    flex: 1;
  }
</style>

<script>
  import { onceSeen, still } from "../../scripts/in-view";

  // On a phone, where the panes stack, anything marked data-scroll-in holds
  // its entrance (and its children's) until it scrolls into view. Desktop
  // plays its sequence on load: a held element's delay only counts down once
  // released, so holding there would leave a pane empty for seconds. Armed by
  // JS only, so without it (or with reduced motion) everything plays on load.
  const items = document.querySelectorAll<HTMLElement>("[data-scroll-in]");
  if (
    items.length &&
    matchMedia("(max-width: 900px)").matches &&
    !still &&
    "IntersectionObserver" in window
  ) {
    for (const el of items) el.classList.add("is-held");
    onceSeen(items, (el) => el.classList.remove("is-held"), {
      rootMargin: "0px 0px -12% 0px",
    });
    // Tabbing into something held (at opacity 0) shows it straight away (when
    // it is later seen, removing the class again does nothing).
    document.addEventListener("focusin", (e) => {
      let held = (e.target as Element).closest?.(".is-held");
      while (held) {
        held.classList.remove("is-held");
        held = held.closest(".is-held");
      }
    });
  }
  document.documentElement.classList.remove("hold-in");
</script>

<style is:global>
  /* A held animation sits on its first frame (fill: both) until released. */
  .is-held,
  .is-held *,
  .hold-in [data-scroll-in],
  .hold-in [data-scroll-in] * {
    animation-play-state: paused !important;
  }
  /* Printed, nothing waits for a scroll. */
  @media print {
    .is-held,
    .is-held * {
      animation: none !important;
    }
  }
</style>
