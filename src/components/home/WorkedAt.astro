---
// "Worked at": the companies, oldest first, scrolling past on a strip that
// can be paused: each name in thin Sora with the year it started, a violet
// slash between. No job lengths; they read as hopping. Data:
// src/data/companies.json.
import { getCollection } from "astro:content";

const companies = (await getCollection("companies"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((c) => c.data);
---

<section class="strip" aria-label="Companies I have worked at" data-reveal>
  <div class="strip__head">
    <h2 class="strip__label">Worked at</h2>
    <span class="strip__span">{companies[0]?.year} → now</span>
  </div>
  <div class="strip__view" aria-hidden="true">
    <div class="strip__track">
      {[...companies, ...companies, ...companies].map((c) => (
        <span class="strip__item">
          {c.name}
          <b class="strip__yr">{c.year}</b>
          <i>/</i>
        </span>
      ))}
    </div>
  </div>
  <button
    class="strip__toggle"
    type="button"
    aria-pressed="false"
    data-strip-toggle
    hidden
  >
    pause
  </button>
  <ul class="sr-only">
    {companies.map((c) => (
      <li>
        {c.name}, {c.year}
      </li>
    ))}
  </ul>
</section>

<style>
  .strip {
    max-width: var(--w-poster);
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .strip__head {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .strip__label {
    font-family: var(--head);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .strip__span {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--faint);
  }
  .strip__view {
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 6%,
      #000 94%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 6%,
      #000 94%,
      transparent
    );
  }
  .strip__track {
    display: flex;
    width: max-content;
    animation: slide 70s linear infinite;
  }
  .strip:hover .strip__track,
  .strip:focus-within .strip__track,
  .strip.is-paused .strip__track {
    animation-play-state: paused;
  }
  @keyframes slide {
    to {
      transform: translateX(-33.3333%);
    }
  }
  /* WCAG 2.2.2: the strip moves on its own, so it can be stopped by keyboard and touch too. */
  .strip__toggle {
    flex: none;
    min-width: 3.4rem;
    min-height: 1.75rem;
    padding: 0 0.6rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--r-ctl);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .strip__toggle:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .strip__item {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--head);
    font-weight: 200;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }
  .strip__yr {
    margin-left: 0.7rem;
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0;
    color: var(--faint);
  }
  /* The separator carries the accent: one of its small marks */
  .strip__item i {
    padding: 0 2.25rem;
    color: var(--accent-solid);
    font-style: normal;
    font-weight: 200;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  /* Under reduced motion the strip stands still and wraps. */
  @media (prefers-reduced-motion: reduce) {
    .strip__view {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .strip__track {
      flex-wrap: wrap;
      width: auto;
      gap: 0.2rem 0;
    }
  }
</style>

<script>
  // The strip scrolls by itself; this stops and restarts it. Under reduced
  // motion the strip stands still, so the button stays hidden.
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-strip-toggle]",
  );
  if (toggle && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const paused = toggle.closest(".strip")!.classList.toggle("is-paused");
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.textContent = paused ? "play" : "pause";
    });
  }
</script>
