---
// Site footer — the shell's bottom bar. Standardized to match the homepage
// footer: name + copyright at the same 1440px width so it lines up with the nav.
const year = new Date().getFullYear();
---

<footer class="foot">
  <span class="foot__name">COLIN CHEUNG</span>
  <span class="foot__meta">© {year} · BUILT IN GLASGOW</span>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    width: 100%;
    max-width: 1440px;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .foot__meta {
    color: var(--faint);
  }
</style>
