---
// "What they ask for" against "what I've done", with a fit chip per row.
import type { FitRow } from "./types";

interface Props {
  rows: FitRow[];
}
const { rows } = Astro.props;
---

<div class="fit-wrap">
  <table class="fit">
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <td class="fit__need">{r.need}</td>
            <td>{r.evidence}</td>
            <td class="fit__lvl"><span class:list={["chip", `chip--${r.level}`]}>{r.level}</span></td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .fit-wrap { overflow-x: auto; }
  .fit { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .fit td { padding: 0.5rem 0.25rem; vertical-align: top; border-top: 1px solid var(--line); }
  .fit__need { width: 42%; color: var(--muted); }
  .fit__lvl { width: 1%; text-align: right; }
  .chip {
    padding: 0.15rem 0.6rem;
    font: 0.72rem var(--mono);
    letter-spacing: 0.04em;
    white-space: nowrap;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .chip--strong { color: oklch(0.52 0.12 150); border-color: currentColor; }
  .chip--partial { color: oklch(0.6 0.13 75); border-color: currentColor; }
  .chip--gap { color: var(--accent-soft); border-color: currentColor; }
  @media (prefers-color-scheme: dark) {
    .chip--strong { color: oklch(0.75 0.13 150); }
    .chip--partial { color: oklch(0.8 0.13 80); }
  }
</style>
