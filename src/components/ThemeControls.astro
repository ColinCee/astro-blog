---
// Live theme controls: accent-color presets + light/dark toggle.
// The accent presets map to [data-accent] rules defined in global.css.
const accents = [
	{ id: "amber", color: "oklch(0.79 0.15 73)", label: "Amber" },
	{ id: "violet", color: "oklch(0.62 0.2 292)", label: "Violet" },
	{ id: "emerald", color: "oklch(0.72 0.14 165)", label: "Emerald" },
	{ id: "rose", color: "oklch(0.66 0.2 14)", label: "Rose" },
	{ id: "sky", color: "oklch(0.68 0.15 232)", label: "Sky" },
];
---

<div class="theme-controls">
	<div class="accent-swatches" role="group" aria-label="Accent color">
		{
			accents.map((a) => (
				<button
					type="button"
					class="swatch"
					data-accent-choice={a.id}
					style={`--swatch: ${a.color}`}
					title={`${a.label} accent`}
					aria-label={`Use ${a.label} accent`}
				/>
			))
		}
	</div>
	<button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
		<svg
			class="icon icon-sun"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			aria-hidden="true"
		>
			<circle cx="12" cy="12" r="4"></circle>
			<path
				d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
			></path>
		</svg>
		<svg class="icon icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
	</button>
</div>

<script>
	const root = document.documentElement;

	const swatches = document.querySelectorAll<HTMLButtonElement>("[data-accent-choice]");

	function syncActiveSwatch() {
		const current = root.getAttribute("data-accent") || "amber";
		swatches.forEach((b) => b.classList.toggle("is-active", b.dataset.accentChoice === current));
	}

	swatches.forEach((btn) => {
		btn.addEventListener("click", () => {
			const accent = btn.dataset.accentChoice!;
			root.setAttribute("data-accent", accent);
			localStorage.setItem("accent", accent);
			syncActiveSwatch();
		});
	});

	document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const isDark = root.classList.toggle("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
		});
	});

	syncActiveSwatch();
</script>

<style>
	.theme-controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.accent-swatches {
		display: flex;
		gap: 0.35rem;
	}
	.swatch {
		width: 1.05rem;
		height: 1.05rem;
		padding: 0;
		border-radius: 999px;
		background: var(--swatch);
		border: 2px solid transparent;
		cursor: pointer;
		transition: transform 0.15s ease, border-color 0.15s ease;
	}
	.swatch:hover {
		transform: scale(1.18);
	}
	.swatch.is-active {
		border-color: var(--foreground);
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--foreground);
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.theme-toggle:hover {
		border-color: var(--accent);
		color: var(--accent-text);
	}
	.icon {
		width: 1.05rem;
		height: 1.05rem;
	}
	.icon-moon {
		display: none;
	}
	:global(.dark) .icon-sun {
		display: none;
	}
	:global(.dark) .icon-moon {
		display: inline;
	}
	@media (max-width: 540px) {
		.accent-swatches {
			display: none;
		}
	}
</style>
