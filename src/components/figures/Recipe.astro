---
// The recipe so far, for a post built as numbered steps: one chip per step,
// sticky at the top while the steps are read. A script marks the chips of the
// steps already passed (headings starting "Step N") and hides the bar once the
// heading `until` is reached. Styles: recipe.css.
interface Props {
  steps: string[];
  until?: string;
}
const { steps, until = "" } = Astro.props;
---

<nav class="recipe" aria-label="The recipe so far" data-until={until}>
  <span class="recipe__k">recipe</span>
  <ol>
    {steps.map((s, i) => (
      <li data-step={i + 1}>
        <b>{i + 1}</b>
        {s}
      </li>
    ))}
  </ol>
</nav>

<script>
  for (const bar of document.querySelectorAll<HTMLElement>(".recipe")) {
    const heads = [...document.querySelectorAll<HTMLElement>(".prose h2")];
    const steps = heads
      .map((h) => ({
        h,
        n: Number(/^Step (\d+)/.exec(h.textContent ?? "")?.[1]),
      }))
      .filter((s) => s.n);
    const end = heads.find(
      (h) => bar.dataset.until && h.textContent?.startsWith(bar.dataset.until),
    );
    const update = () => {
      const line = innerHeight * 0.35;
      const now = Math.max(
        0,
        ...steps
          .filter((s) => s.h.getBoundingClientRect().top < line)
          .map((s) => s.n),
      );
      for (const li of bar.querySelectorAll<HTMLElement>("li")) {
        const n = Number(li.dataset.step);
        li.classList.toggle("is-done", n < now);
        li.classList.toggle("is-now", n === now);
      }
      bar.classList.toggle(
        "is-gone",
        !!end && end.getBoundingClientRect().top < line,
      );
    };
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>
