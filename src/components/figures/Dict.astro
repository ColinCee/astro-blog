---
// One field going from JSONL to a column to dictionary encoding (drawn by
// Frames). In the column the names fly into one header and the syntax fades;
// in the dictionary each distinct value moves to a numbered entry, its
// repeats fly into that entry and fade, and each row's value turns into the
// entry's number.
import Frames from "./Frames.astro";
import type { Cell, Spot } from "./frames";

interface Props {
  name: string;
  values: string[];
}
const { name, values } = Astro.props;
const distinct = [...new Set(values)];
const bits = Math.max(1, Math.ceil(Math.log2(distinct.length)));
const valW = Math.max(...values.map((v) => v.length));
const start = name.length + 2;

// The dictionary line: "0:OPEN 1:DONE", each entry's text after its label.
const entry: Record<string, { label: number; text: number }> = {};
let dx = start;
distinct.forEach((v, i) => {
  entry[v] = { label: dx, text: dx + String(i).length + 1 };
  dx = entry[v].text + v.length + 1;
});

const cells: Cell[] = [];
const fade = (p: Spot): Spot => ({ ...p, show: false });
values.forEach((v, row) => {
  let x = 0;
  const put = (s: string, at: (i: number, here: Spot) => Spot[]) => {
    for (const [i, ch] of [...s].entries()) {
      const here: Spot = { x, y: row, show: true, tone: "syn" };
      cells.push({ ch, at: at(i, here) });
      x++;
    }
  };
  const syn = (s: string) => put(s, (_, h) => [h, fade(h), fade(h)]);
  syn('"');
  put(name, (i, h) => {
    const head: Spot = { x: i, y: 0, show: row === 0, tone: "head" };
    return [{ ...h, tone: "name" }, head, head];
  });
  syn('":"');
  const first = values.indexOf(v) === row;
  const col = start + row * (valW + 1);
  const vx = x;
  put(v, (i, h) => [
    { ...h, tone: "val" },
    { x: col + i, y: 0, show: true, tone: "val" },
    { x: entry[v].text + i, y: 1, show: first, tone: "val" },
  ]);
  for (const c of cells.slice(-v.length)) c.bold = true;
  syn('",');
  // The row's index: hidden where the value is, shown in the index line.
  cells.push({
    ch: String(distinct.indexOf(v)),
    bold: true,
    at: [
      { x: vx, y: row, show: false, tone: "idx" },
      { x: col, y: 0, show: false, tone: "idx" },
      { x: start + row * 2, y: 0, show: true, tone: "idx" },
    ],
  });
});
// The entry labels ("0:"), shown only in the dictionary.
distinct.forEach((v, i) => {
  for (const [j, ch] of [...`${i}:`].entries()) {
    const p: Spot = { x: entry[v].label + j, y: 1, show: true, tone: "idx" };
    cells.push({ ch, at: [fade(p), fade(p), p] });
  }
});

const jsonBytes = values.reduce((s, v) => s + name.length + v.length + 6, 0);
const colBytes = values.join("").length;
const dictBytes =
  distinct.join("").length + Math.ceil((values.length * bits) / 8);
---

<Frames
  cells={cells}
  tabs={[
    { label: "In JSONL", bytes: jsonBytes },
    { label: "As a column", bytes: colBytes },
    { label: "Dictionary", bytes: dictBytes },
  ]}
/>
