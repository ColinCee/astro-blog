---
// A dot plot: one row per item, a dot at its value on one axis from 0 to
// `max`, in titled groups, with the axis's ticks (0, half, max, in `unit`)
// under the last group. The `after` row is the result. Styles: dot.css.
interface Row {
  label: string;
  value: number;
  text: string;
  after?: boolean;
}
interface Props {
  max: number;
  unit?: string;
  groups: { title?: string; rows: Row[] }[];
}
const { max, unit = "", groups } = Astro.props;
const ticks = [0, max / 2, max];
---

{groups.map((g) => (
  <Fragment>
    {g.title && <p class="fig__k">{g.title}</p>}
    {g.rows.map((r) => (
      <div class:list={["dot", { "dot--after": r.after }]}>
        <span>{r.label}</span>
        <i style={`--x:${(r.value / max).toFixed(3)}`} />
        <b>{r.text}</b>
      </div>
    ))}
  </Fragment>
))}
<div class="dot dot--axis" aria-hidden="true">
  <span></span>
  <i>
    {ticks.map((t) => (
      <em style={`--x:${t / max}`}>
        {t}
        {t === max && unit ? ` ${unit}` : ""}
      </em>
    ))}
  </i>
  <b></b>
</div>
