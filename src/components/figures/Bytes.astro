---
// The same records stored two ways, one square a byte, on one grid so both
// are to scale. JSONL is a line of squares per record, split into field names,
// JSON syntax and values (booleans written "TRUE" as the export writes them).
// Parquet is a line per column: numbers as 4-byte ints, booleans as bits, and
// strings as a dictionary of the distinct values once plus a small index per
// row. Parquet's own headers are left out. Styles: bytes.css.
type Value = string | number | boolean;
interface Props {
  records: Record<string, Value>[];
}
const { records } = Astro.props;
const keys = Object.keys(records[0]);
const n = records.length;

type Kind = "key" | "syn" | "val";
const run = (kind: Kind, len: number) => Array<Kind>(len).fill(kind);
const text = (v: Value) =>
  typeof v === "boolean" ? String(v).toUpperCase() : String(v);
const line = (r: Record<string, Value>): Kind[] => [
  ...run("syn", 1),
  ...keys.flatMap((k, i) => {
    const v = r[k];
    const quoted = typeof v !== "number";
    return [
      ...run("key", k.length + 2),
      ...run("syn", 1 + (quoted ? 1 : 0)),
      ...run("val", text(v).length),
      ...run("syn", (quoted ? 1 : 0) + (i < keys.length - 1 ? 1 : 0)),
    ];
  }),
  ...run("syn", 2),
];
const lines = records.map(line);
const jsonBytes = lines.reduce((s, l) => s + l.length, 0);
const width = Math.max(...lines.map((l) => l.length));

interface Col {
  key: string;
  dict: number;
  data: number;
  note: string;
}
const cols: Col[] = keys.map((k) => {
  const vs = records.map((r) => r[k]);
  if (typeof vs[0] === "number")
    return { key: k, dict: 0, data: n * 4, note: `${n} numbers × 4 bytes` };
  if (typeof vs[0] === "boolean")
    return { key: k, dict: 0, data: Math.ceil(n / 8), note: `${n} bits` };
  const distinct = [...new Set(vs.map(String))];
  const bits = Math.max(1, Math.ceil(Math.log2(distinct.length)));
  return {
    key: k,
    dict: distinct.join("").length,
    data: Math.ceil((n * bits) / 8),
    note: `${distinct.join(" ")} once, then ${bits} bit a row`,
  };
});
const parquetBytes = cols.reduce((s, c) => s + c.dict + c.data, 0);
---

<div class="bytes" style={`--n:${width}`}>
  <p class="fig__k">JSONL · {jsonBytes} bytes</p>
  <div class="bytes__set">
    {lines.map((l) => (
      <span class="bytes__line">
        {l.map((k) => (
          <i class={k} />
        ))}
      </span>
    ))}
  </div>
  <ul class="bytes__key">
    <li class="key">field names</li>
    <li class="syn">JSON syntax</li>
    <li class="val">values</li>
  </ul>
  <p class="fig__k">Parquet · {parquetBytes} bytes</p>
  <div class="bytes__set">
    {cols.map((c) => (
      <div class="bytes__col">
        <span class="bytes__line">
          {run("val", c.dict).map(() => (
            <i class="dict" />
          ))}
          {run("val", c.data).map(() => (
            <i class="pq" />
          ))}
        </span>
        <small>
          <b>{c.key}</b> {c.note}
        </small>
      </div>
    ))}
  </div>
</div>
