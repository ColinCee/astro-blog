---
// A line chart from data (see src/scripts/line-chart.ts for its shape). The
// lines widget redraws it at the figure's real width; without script the
// same chart shows, drawn here at build time. Styles: chart.css.

import {
  chartHeight,
  type LineData,
  lineChart,
} from "../../scripts/line-chart";
import Fig from "./Fig.astro";

interface Props {
  title: string;
  label: string;
  data: LineData;
}
const { title, label, data } = Astro.props;
// Drawn about as wide as a phone column, so without script (when chart text
// scales with the drawing) the labels stay readable at every width.
const W = 340;
const H = chartHeight(W);
---

<Fig title={title} data-widget="lines">
  <div class="chart chart--fluid">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={label}
      set:html={lineChart(data, W, H)}
    />
  </div>
  <script type="application/json" set:html={JSON.stringify(data)} />
</Fig>
