---
// The same records stored two ways: as JSON lines, one row at a time with
// every field name repeated (highlighted), and as columns, each name once.
// Booleans are written as the export writes them ("TRUE") in the rows, and
// as the bit they become in the columns. Styles: split.css.
interface Props {
  records: Record<string, string | number | boolean>[];
  rowsTitle: string;
  colsTitle: string;
}
const { records, rowsTitle, colsTitle } = Astro.props;
const keys = Object.keys(records[0]);
const asJson = (v: string | number | boolean) =>
  typeof v === "boolean" ? `"${String(v).toUpperCase()}"` : JSON.stringify(v);
const asCol = (v: string | number | boolean) =>
  typeof v === "boolean" ? Number(v) : v;
// One JSON line, as markup with no stray spaces: {"id": 1, "status": …}.
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const line = (r: Props["records"][number]) =>
  `{${keys.map((k) => `<u>${esc(`"${k}"`)}</u>: ${esc(asJson(r[k]))}`).join(", ")}}`;
---

<div class="split">
  <div>
    <p class="fig__k">{rowsTitle}</p>
    <div class="rows">
      {records.map((r) => <span set:html={line(r)} />)}
    </div>
  </div>
  <div>
    <p class="fig__k">{colsTitle}</p>
    <div class="cols">
      {keys.map((k) => (
        <div>
          <b>{k}</b>
          {records.map((r) => (
            <span>{asCol(r[k])}</span>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>
