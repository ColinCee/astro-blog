---
// The finished Parquet file for a few records: a line per column chunk with
// what it actually stores (numbers at 4 bytes, strings as a dictionary plus a
// number a row, booleans as bits) and its bytes. Bits are drawn inside the
// whole bytes they take, the unused bits as dots, since a file is stored in
// bytes; then bars for the same
// records as JSONL, as plain columns and encoded. Dictionary numbers use
// Lookup's entry styles (.e0, .e1, …). Parquet's own headers and Zstandard
// are left out. Styles: packed.css.
import Cmp from "./Cmp.astro";

type Value = string | number | boolean;
interface Props {
  records: Record<string, Value>[];
}
const { records } = Astro.props;
const keys = Object.keys(records[0]);
const n = records.length;
const text = (v: Value) =>
  typeof v === "boolean" ? String(v).toUpperCase() : String(v);

interface Chunk {
  key: string;
  kind: "num" | "dict" | "bits";
  values: Value[];
  distinct: string[];
  bits: number;
  bytes: number;
  note: string;
}
const chunks: Chunk[] = keys.map((key) => {
  const values = records.map((r) => r[key]);
  if (typeof values[0] === "number")
    return {
      key,
      kind: "num",
      values,
      distinct: [],
      bits: 32,
      bytes: n * 4,
      note: `${n} × 4 bytes`,
    };
  if (typeof values[0] === "boolean")
    return {
      key,
      kind: "bits",
      values,
      distinct: [],
      bits: 1,
      bytes: Math.ceil(n / 8),
      note: `${n} bits, padded to a whole byte`,
    };
  const distinct = [...new Set(values.map(String))];
  const bits = Math.max(1, Math.ceil(Math.log2(distinct.length)));
  return {
    key,
    kind: "dict",
    values,
    distinct,
    bits,
    bytes: distinct.join("").length + Math.ceil((n * bits) / 8),
    note: `${distinct.join("").length} bytes of dictionary, then ${n} × ${bits} bit, padded to a whole byte`,
  };
});

// The same records three ways: JSON lines (with a newline each), the names
// once plus the values as text, and the encoded chunks above.
const jsonl = records.reduce(
  (s, r) =>
    s +
    JSON.stringify(
      Object.fromEntries(
        keys.map((k) => [k, typeof r[k] === "boolean" ? text(r[k]) : r[k]]),
      ),
    ).length +
    1,
  0,
);
const plain = records.reduce(
  (s, r) => s + keys.reduce((t, k) => t + text(r[k]).length, 0),
  keys.join("").length,
);
const packed = chunks.reduce((s, c) => s + c.bytes, 0);
// The unused bits in the last byte of a chunk of n values at `bits` each.
const pad = (bits: number) => Math.ceil((n * bits) / 8) * 8 - n * bits;
const spare = (bits: number) => Array.from({ length: pad(bits) });
const b = (x: number) => `${x} byte${x === 1 ? "" : "s"}`;
---

<div class="packed">
  {chunks.map((c) => (
    <div class="packed__row">
      <span class="packed__key">{c.key}</span>
      <span class="packed__data">
        {c.kind === "num" && c.values.map((v) => <i>{v}</i>)}
        {c.kind === "dict" && (
          <>
            {c.distinct.map((v, i) => (
              <span class="packed__entry">
                <b class={`e${i}`}>{i}</b>
                {v}
              </span>
            ))}
            <span class="packed__byte">
              {c.values.map((v) => {
                const i = c.distinct.indexOf(String(v));
                return <b class={`e${i}`}>{i}</b>;
              })}
              {spare(c.bits).map(() => (
                <em>·</em>
              ))}
            </span>
          </>
        )}
        {c.kind === "bits" && (
          <span class="packed__byte">
            {c.values.map((v) => (
              <i>{v ? 1 : 0}</i>
            ))}
            {spare(1).map(() => (
              <em>·</em>
            ))}
          </span>
        )}
        <small>{c.note}</small>
      </span>
      <span class="packed__bytes">{b(c.bytes)}</span>
    </div>
  ))}
  <div class="packed__bars">
    <Cmp
      cols={["8rem", "4.6rem"]}
      rows={[
        { label: "JSONL", value: jsonl, text: b(jsonl) },
        { label: "As columns", value: plain, text: b(plain) },
        { label: "Encoded", value: packed, text: b(packed), after: true },
      ]}
    />
  </div>
</div>
