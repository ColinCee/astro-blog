---
// The same records stored two ways, as text in a mono font so one character
// is one byte and both panels are to scale. JSONL lines with the field names
// and syntax marked; Parquet a line per column, with zero bytes as dots and a
// packed byte of bits as ▪. Parquet's own headers are left out.
// Styles: btext.css.
type Value = string | number | boolean;
interface Props {
  records: Record<string, Value>[];
}
const { records } = Astro.props;
const keys = Object.keys(records[0]);
const n = records.length;
type Kind = "k" | "s" | "v" | "z" | "b";
type Run = [Kind, string];
const text = (v: Value) =>
  typeof v === "boolean" ? String(v).toUpperCase() : String(v);
const line = (r: Record<string, Value>): Run[] => [
  ["s", "{"],
  ...keys.flatMap((k, i): Run[] => {
    const q = typeof r[k] === "number" ? "" : '"';
    return [
      ["k", `"${k}"`],
      ["s", `:${q}`],
      ["v", text(r[k])],
      ["s", q + (i < keys.length - 1 ? "," : "")],
    ];
  }),
  ["s", "}"],
];
const lines = records.map(line);
const jsonBytes = lines.reduce(
  (s, l) => s + l.reduce((t, [, x]) => t + x.length, 0) + 1,
  0,
);

interface Col {
  key: string;
  runs: Run[];
  note: string;
}
const cols: Col[] = keys.map((k) => {
  const vs = records.map((r) => r[k]);
  if (typeof vs[0] === "number")
    return {
      key: k,
      runs: vs.flatMap((v): Run[] => [
        ["v", String(v)],
        ["z", "·".repeat(4 - String(v).length)],
      ]),
      note: `${n} numbers × 4 bytes`,
    };
  if (typeof vs[0] === "boolean")
    return {
      key: k,
      runs: [["b", "▪".repeat(Math.ceil(n / 8))]],
      note: `${n} bits in 1 byte`,
    };
  const distinct = [...new Set(vs.map(String))];
  const bits = Math.max(1, Math.ceil(Math.log2(distinct.length)));
  return {
    key: k,
    runs: [
      ["v", distinct.join("")],
      ["b", "▪".repeat(Math.ceil((n * bits) / 8))],
    ],
    note: `${distinct.join(" ")} once, then ${bits} bit a row`,
  };
});
const parquetBytes = cols.reduce(
  (s, c) => s + c.runs.reduce((t, [, x]) => t + x.length, 0),
  0,
);
---

<div class="btext">
  <p class="fig__k">JSONL · {jsonBytes} bytes</p>
  <div class="btext__code">
    {lines.map((l) => (
      <div>
        {l.map(([k, x]) => (
          <span class={k}>{x}</span>
        ))}
      </div>
    ))}
  </div>
  <ul class="btext__key">
    <li class="k">field names</li>
    <li class="s">JSON syntax</li>
    <li class="v">values</li>
  </ul>
  <p class="fig__k">Parquet · {parquetBytes} bytes</p>
  <div class="btext__code">
    {cols.map((c) => (
      <div class="btext__col">
        <small>
          <b>{c.key}</b> {c.note}
        </small>
        <div>
          {c.runs.map(([k, x]) => (
            <span class={k}>{x}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
