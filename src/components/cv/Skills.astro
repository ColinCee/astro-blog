---
// Skills as a compact two-column list of plain text under mono labels.
import { skills } from "../../data/cv";
import Items from "../site/Items.astro";
---

<section class="cv__sec" aria-labelledby="sk-h">
  <h2 class="cv__sec-head" id="sk-h">// skills</h2>
  <dl class="skills">
    {skills.map((g) => (
      <div class="skill">
        <dt class="skill__label">{g.label}</dt>
        <Items as="dd" class="skill__items" list={g.items} />
      </div>
    ))}
  </dl>
</section>

<style>
  /* ---------------- skills ---------------- */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.1rem clamp(1.5rem, 4vw, 3rem);
    margin: 0;
  }
  .skill__label {
    margin: 0 0 0.2rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--dim);
  }
  .skill__items {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--ink);
    text-wrap: pretty;
  }
</style>
