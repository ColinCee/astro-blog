---
// Name, role line, lede and contact.
import { contact, lede, name, role } from "../../data/cv";
import Items from "../site/Items.astro";
---

<header class="cv__head">
  <h1 class="cv__name">{name}</h1>
  <Items as="p" class="cv__role" list={role} />
  <p class="cv__lede">{lede}</p>
  <nav class="cv__contact" aria-label="Contact">
    {contact.map((c) => <a href={c.href}>{c.label}</a>)}
  </nav>
</header>

<style>
  /* ---------------- masthead ---------------- */
  .cv__head {
    margin-bottom: 1.6rem;
  }
  .cv__name {
    margin: 0;
    font-family: var(--head);
    font-weight: 600;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--ink);
    text-wrap: balance;
  }
  .cv__role {
    margin: 0.8rem 0 0;
    font-family: var(--mono);
    font-size: var(--text-md);
    color: var(--dim);
  }
  .cv__lede {
    margin: 1rem 0 0;
    max-width: 86ch;
    font-family: var(--grotesk);
    font-weight: 400;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--dim);
    text-wrap: pretty;
  }
  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: 1rem 0 0;
    font-family: var(--mono);
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
  }
  .cv__contact a {
    padding-bottom: 2px;
    color: var(--dim);
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .cv__contact a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
</style>
