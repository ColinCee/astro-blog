---
// Education and projects side by side, then the end cap.
import { education, projects } from "../../data/cv";
---

<div class="cv__lower">
  <section class="cv__sec" aria-labelledby="ed-h">
    <h2 class="cv__sec-head" id="ed-h">// education</h2>
    <div class="edu">
      <h3 class="edu__school">{education.school}</h3>
      <p class="edu__meta">{education.meta}</p>
      <p class="edu__degree">
        {education.degree}
        <b class="hl">{education.honours}</b>
      </p>
      <p class="edu__note">{education.note}</p>
    </div>
  </section>

  <section class="cv__sec" aria-labelledby="pr-h">
    <h2 class="cv__sec-head" id="pr-h">// projects</h2>
    <ul class="proj">
      {projects.map((p) => (
        <li class="proj__item">
          <h3 class="proj__name">
            <a href={p.href} rel="noopener">
              {p.name}
            </a>
          </h3>
          <p class="proj__desc">{p.desc}</p>
          <p class="proj__stack">{p.stack}</p>
        </li>
      ))}
    </ul>
  </section>
</div>

<p class="cv__end">
  <span>Open to remote roles · Glasgow, UK</span>
  <a href="https://www.linkedin.com/in/colin-cheung/">
    Let's talk <span aria-hidden="true">↗</span>
  </a>
</p>

<style>
  /* ---------------- lower: education + projects ---------------- */
  .cv__lower {
    display: grid;
    gap: clamp(0.5rem, 2vw, 1rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (min-width: 900px) {
    .cv__lower {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .edu__school {
    margin: 0;
    font-family: var(--head);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .edu__meta {
    margin: 0.35rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .edu__degree {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin: 1rem 0 0;
    font-family: var(--grotesk);
    font-weight: 500;
    font-size: 1rem;
    color: var(--ink);
  }
  .edu__note {
    margin: 0.75rem 0 0;
    max-width: 48ch;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .proj {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(1.3rem, 2.5vw, 1.8rem);
  }
  .proj__name {
    margin: 0;
    font-family: var(--head);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .proj__name a {
    color: inherit;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .proj__name a:hover {
    border-color: var(--accent);
  }
  .proj__desc {
    margin: 0.35rem 0 0;
    max-width: 54ch;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .proj__stack {
    margin: 0.45rem 0 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--faint);
  }

  /* ---------------- end cap ---------------- */
  .cv__end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--faint);
  }
  .cv__end a {
    color: var(--accent-text);
    border-bottom: 1px solid var(--accent-line);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .cv__end a:hover {
    border-color: var(--accent);
  }
</style>
