---
// The <head> every page shares: charset, colour scheme, icon, title,
// description, canonical URL, the social card, and structured data for
// search engines: a BlogPosting on posts (`article`), the person on the
// homepage (`person`).
import links from "../../data/links.json";

interface Props {
  title: string;
  description: string;
  // The social card's line, when it should differ from the description.
  ogDescription?: string;
  ogType?: string;
  // The social card image, when the page has its own (a post's, from
  // `pnpm og`); else the site's.
  image?: string;
  article?: { headline: string; published: Date; modified?: Date };
  person?: boolean;
}
const {
  title,
  description,
  ogDescription = description,
  ogType = "website",
  image = "/og.png",
  article,
  person,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const author = {
  "@type": "Person",
  name: "Colin Cheung",
  url: new URL("/", Astro.site).href,
  jobTitle: "Senior Software Engineer",
  sameAs: [links.github, links.linkedin],
};
const schema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: article.headline,
      description,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      author,
      image: ogImage.href,
      mainEntityOfPage: canonical.href,
    }
  : person
    ? { "@context": "https://schema.org", ...author }
    : undefined;
---

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<!-- The theme: dark unless the visitor chose light (the nav button). Set here,
     before any stylesheet, so a light page never flashes dark or the reverse. -->
<script is:inline>
  try {
    if (localStorage.getItem("theme") === "light")
      document.documentElement.dataset.theme = "light";
  } catch {}
  // Paper is light: print in the light theme (code blocks switch with
  // data-theme, not the print media query), then put the reader's back.
  addEventListener("beforeprint", () => {
    const r = document.documentElement;
    r.dataset.screenTheme = r.dataset.theme || "dark";
    r.dataset.theme = "light";
  });
  addEventListener("afterprint", () => {
    const r = document.documentElement;
    if (r.dataset.screenTheme === "light") r.dataset.theme = "light";
    else delete r.dataset.theme;
    delete r.dataset.screenTheme;
  });
</script>
<!-- ?v= changes with the icon, so browsers drop the one they cached -->
<link rel="icon" href="/favicon.ico?v=2" sizes="32x32">
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
<!-- Fonts: linked here, not imported from a stylesheet, so the browser asks
     for them as soon as it reads the head. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Sora:wght@200..600&amp;family=DM+Mono:wght@300;400;500&amp;display=swap"
>
<meta name="generator" content={Astro.generator}>

<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>

<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
{article && (
  <meta
    property="article:published_time"
    content={article.published.toISOString()}
  />
)}
{article?.modified && (
  <meta
    property="article:modified_time"
    content={article.modified.toISOString()}
  />
)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
