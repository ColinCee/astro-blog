---
// The <head> every page shares: charset, colour scheme, icon, title,
// description, canonical URL, the social card, and structured data for
// search engines: a BlogPosting on posts (`article`), the person on the
// homepage (`person`).
import { Font } from "astro:assets";
import links from "../../data/links.json";

interface Props {
  title: string;
  description: string;
  // The social card's line, when it should differ from the description.
  ogDescription?: string;
  ogType?: string;
  // The social card image, when the page has its own (a post's, from
  // `pnpm og`); else the site's.
  image?: string;
  article?: { headline: string; published: Date; modified?: Date };
  person?: boolean;
}
const {
  title,
  description,
  ogDescription = description,
  ogType = "website",
  image = "/og.png",
  article,
  person,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const author = {
  "@type": "Person",
  name: "Colin Cheung",
  url: new URL("/", Astro.site).href,
  jobTitle: "Senior Software Engineer",
  sameAs: [links.github, links.linkedin],
};
const schema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: article.headline,
      description,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      author,
      image: ogImage.href,
      mainEntityOfPage: canonical.href,
    }
  : person
    ? { "@context": "https://schema.org", ...author }
    : undefined;
---

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<!-- The theme: dark unless the visitor chose light (the nav button). Set here,
     before any stylesheet, so a light page never flashes dark or the reverse. -->
<script is:inline>
  const theme = () => {
    try {
      if (localStorage.getItem("theme") === "light")
        document.documentElement.dataset.theme = "light";
      else delete document.documentElement.dataset.theme;
    } catch {}
  };
  theme();
  // A prerendered page (see the speculation rules below) read the theme when
  // it was made; read it again as it is shown, in case it changed since.
  // The toggle's state and the canvases follow (as the toggle does, Nav.astro).
  if (document.prerendering)
    document.addEventListener(
      "prerenderingchange",
      () => {
        theme();
        const light = String(
          document.documentElement.dataset.theme === "light",
        );
        for (const b of document.querySelectorAll("[data-theme-toggle]"))
          b.setAttribute("aria-pressed", light);
        dispatchEvent(new Event("themechange"));
      },
      { once: true },
    );
  // Paper is light: print in the light theme (code blocks switch with
  // data-theme, not the print media query), then put the reader's back.
  addEventListener("beforeprint", () => {
    const r = document.documentElement;
    r.dataset.screenTheme = r.dataset.theme || "dark";
    r.dataset.theme = "light";
  });
  addEventListener("afterprint", () => {
    const r = document.documentElement;
    if (r.dataset.screenTheme === "light") r.dataset.theme = "light";
    else delete r.dataset.theme;
    delete r.dataset.screenTheme;
  });
</script>
<!-- ?v= changes with the icon, so browsers drop the one they cached -->
<link rel="icon" href="/favicon.ico?v=2" sizes="32x32">
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
<!-- Fonts, self-hosted (astro.config.ts). Sora (titles) and DM Mono 400
     (meta lines) are preloaded: text that rewraps when its font lands moves
     the page under it, and DM Mono's stand-in ("DM Mono fallback" in
     tokens.css) matches its height but not its width. -->
<Font cssVariable="--font-geist" />
<Font cssVariable="--font-sora" preload={[{ subset: "latin" }]} />
<Font
  cssVariable="--font-dm-mono"
  preload={[{ weight: 400, subset: "latin" }]}
/>
<!-- Chrome and Edge prerender a page of the site when the pointer rests on
     its link (or as a tap starts), so the click shows it at once. Files (a
     path with a dot, like a post's sample data) are left alone. A prefetch
     would not do: the HTML is sent "check again before use", so it was
     downloaded twice. -->
<script type="speculationrules" is:inline>
  {
    "prerender": [
      {
        "where": {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/*.*" } }
          ]
        },
        "eagerness": "moderate"
      }
    ]
  }
</script>
<meta name="generator" content={Astro.generator}>

<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>

<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
{article && (
  <meta
    property="article:published_time"
    content={article.published.toISOString()}
  />
)}
{article?.modified && (
  <meta
    property="article:modified_time"
    content={article.modified.toISOString()}
  />
)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
