---
// Site navigation — the terminal shell's top bar, on every page. On the
// homepage (`home`) it spans the wider poster frame and hides its links on
// phones; the page itself links to the blog and the CV.
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/blog/", label: "Writing" },
  { href: "/cv/", label: "CV" },
];
const active = (href: string) => {
  if (href.startsWith("/#")) return false;
  const p = path.replace(/\/$/, "") || "/";
  const h = href.replace(/\/$/, "") || "/";
  return h === "/" ? p === "/" : p === h || p.startsWith(`${h}/`);
};
---

<nav class:list={["nav", { "nav--home": home }]} aria-label="Primary">
  <a class="nav__mark" href="/"> colin<span>@</span>glasgow<b>:~$</b> </a>
  <div class="nav__links">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={["nav__link", { "is-active": active(l.href) }]}
        aria-current={active(l.href) ? "page" : undefined}
      >
        {l.label}
      </a>
    ))}
  </div>
  <button
    class="nav__theme"
    type="button"
    data-theme-toggle
    aria-label="Switch between dark and light"
  >
    <svg class="nav__moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
    <svg class="nav__sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path
        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      />
    </svg>
  </button>
</nav>

<script>
  // Dark is the default; the choice of light is remembered. Head.astro applies
  // it before paint; pieces that draw in a canvas listen for "themechange".
  for (const b of document.querySelectorAll("[data-theme-toggle]")) {
    b.addEventListener("click", () => {
      const r = document.documentElement;
      const light = r.dataset.theme !== "light";
      if (light) r.dataset.theme = "light";
      else delete r.dataset.theme;
      try {
        if (light) localStorage.setItem("theme", "light");
        else localStorage.removeItem("theme");
      } catch {}
      dispatchEvent(new Event("themechange"));
    });
  }
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    width: 100%;
    max-width: var(--w-page);
    margin: 0 auto;
    padding-bottom: clamp(2rem, 6vw, 3.6rem);
  }
  .nav__mark {
    font-family: var(--mono);
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .nav__mark span {
    color: var(--muted);
  }
  .nav__mark b {
    color: var(--faint);
    font-weight: 400;
  }
  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-left: auto;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  /* The theme switch: a control, so ink and 6px, not the accent */
  .nav__theme {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-ctl);
    background: var(--panel);
    color: var(--ink);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .nav__theme:hover {
    background: var(--accent-hover);
    border-color: var(--accent);
  }
  .nav__theme svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nav__sun,
  :global(:root[data-theme="light"]) .nav__moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .nav__sun {
    display: block;
  }
  .nav__link {
    position: relative;
    padding: 0.2rem 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  /* A tap area of about 40 x 32px or more; the visible underline stays where it was. */
  .nav__link::before {
    content: "";
    position: absolute;
    inset: -0.55rem -0.5rem;
  }
  .nav__link:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .nav__link.is-active {
    color: var(--ink);
    border-color: var(--line);
  }
  @media (max-width: 480px) {
    .nav__links {
      gap: 1rem;
    }
  }
  .nav--home {
    max-width: var(--w-poster);
  }
  @media (max-width: 560px) {
    .nav--home .nav__links {
      display: none;
    }
  }
</style>
