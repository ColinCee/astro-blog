---
// Site navigation — the terminal shell's top bar, on every page. On the
// homepage (`home`) it spans the wider poster frame and hides its links on
// phones; the page itself links to the blog and the CV.
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/blog/", label: "BLOG" },
  { href: "/cv/", label: "CV" },
];
const active = (href: string) => {
  if (href.startsWith("/#")) return false;
  const p = path.replace(/\/$/, "") || "/";
  const h = href.replace(/\/$/, "") || "/";
  return h === "/" ? p === "/" : p === h || p.startsWith(`${h}/`);
};
---

<nav class:list={["nav", { "nav--home": home }]} aria-label="Primary">
  <a class="nav__mark" href="/"> colin<span>@</span>glasgow<b>:~$</b> </a>
  <div class="nav__links">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={["nav__link", { "is-active": active(l.href) }]}
        aria-current={active(l.href) ? "page" : undefined}
      >
        {l.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    width: 100%;
    max-width: var(--w-page);
    margin: 0 auto;
    padding-bottom: clamp(2rem, 6vw, 3.6rem);
  }
  .nav__mark {
    font-family: var(--mono);
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .nav__mark span {
    color: var(--accent);
  }
  .nav__mark b {
    color: var(--faint);
    font-weight: 400;
  }
  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .nav__link {
    position: relative;
    padding: 0.2rem 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  /* A tap area of about 40 x 32px or more; the visible underline stays where it was. */
  .nav__link::before {
    content: "";
    position: absolute;
    inset: -0.55rem -0.5rem;
  }
  .nav__link:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .nav__link.is-active {
    color: var(--ink);
    border-color: var(--line);
  }
  @media (max-width: 480px) {
    .nav__links {
      gap: 1rem;
    }
  }
  .nav--home {
    max-width: var(--w-poster);
  }
  @media (max-width: 560px) {
    .nav--home .nav__links {
      display: none;
    }
  }
</style>
