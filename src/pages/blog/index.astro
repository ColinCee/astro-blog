---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Each index row: a trimmed display title + the one metric the post moved.
// Short-form on purpose — the full title and the story live on the post page.
const cards: Record<
  string,
  {
    short: string;
    hook: string;
    from?: string;
    to?: string;
    value?: string;
    label: string;
  }
> = {
  "jsonl-to-parquet-compression": {
    short: "A story about Parquet",
    hook: "What columnar storage is doing under the hood.",
    from: "4.5 GB",
    to: "221 MB",
    label: "95% smaller",
  },
  "saving-time-in-ts-jest": {
    short: "Slash your ts-jest test times",
    hook: "One config flag skips the type-check tax.",
    value: "−10 min",
    label: "off CI",
  },
};

const readMin = (body?: string) =>
  Math.max(1, Math.round((body?.trim().split(/\s+/).length || 0) / 200));

const entries = posts.map((post) => {
  const c = cards[post.id];
  return {
    href: `/blog/${post.id}/`,
    title: c?.short ?? post.data.title,
    hook: c?.hook ?? post.data.description,
    year: post.data.pubDate.getFullYear(),
    mon: post.data.pubDate.toLocaleDateString("en-US", { month: "short" }),
    read: readMin(post.body),
    metric:
      c?.from && c?.to ? `${c.from} → ${c.to}` : (c?.to ?? c?.value ?? null),
    label: c?.label ?? null,
  };
});
---

<Base
  title="Blog · Colin Cheung"
  description="Short engineering notes from Colin Cheung. Things that got faster, smaller, or cheaper."
>
  <section class="log">
    <header class="log__head">
      <h1 class="log__sr">Blog</h1>
      <p class="log__kicker">// writing</p>
      <p class="log__lede">
        Short notes on the things I've made faster, smaller, or cheaper, with
        the numbers to back them up.
      </p>
    </header>

    <ol class="log__list">
      {
        entries.map((e) => (
          <li class="log__item">
            <a class="log__link" href={e.href}>
              <span class="log__node" aria-hidden="true" />
              <div class="log__date">
                <span class="log__year">{e.year}</span>
                <span class="log__mon">{e.mon}</span>
                <span class="log__read">{e.read} min</span>
              </div>
              <div class="log__body">
                <h2 class="log__title">{e.title}</h2>
                {e.metric && (
                  <p class="log__sig" aria-hidden="true">
                    {e.metric}
                    {e.label && <span class="log__label">{e.label}</span>}
                  </p>
                )}
                {e.hook && <p class="log__hook">{e.hook}</p>}
              </div>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="log__end">
      <span class="log__end-note">That's everything so far. More soon.</span>
    </p>
  </section>
</Base>

<style>
  .log {
    max-width: 54rem;
    margin: 0 auto;
  }

  .log__head {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .log__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .log__kicker {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-soft);
  }
  .log__lede {
    margin: 0;
    max-width: 40ch;
    font-family: var(--grotesk);
    font-weight: 500;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }

  .log__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* continuous timeline spine */
  .log__list::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 5.5rem;
    width: 1px;
    background: var(--line);
  }

  .log__link {
    --pad: clamp(1.35rem, 3vw, 2rem);
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 2.25rem;
    align-items: start;
    padding: var(--pad) 0;
  }
  .log__node {
    position: absolute;
    left: 5.5rem;
    top: calc(var(--pad) + 0.4rem);
    width: 8px;
    height: 8px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--faint);
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
    z-index: 1;
  }
  .log__link:hover .log__node,
  .log__link:focus-visible .log__node {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--accent) 20%, transparent);
  }

  .log__date {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.2rem;
    text-align: right;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }
  .log__year {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }
  .log__mon {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .log__read {
    margin-top: 0.35rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  .log__body {
    min-width: 0;
  }
  /* muted title — the metric is the accent, not this */
  .log__title {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 600;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--muted);
    text-wrap: balance;
    transition: color 0.18s ease;
  }
  .log__link:hover .log__title,
  .log__link:focus-visible .log__title {
    color: var(--ink);
  }
  .log__sig {
    margin: 0.5rem 0 0;
    font-family: var(--grotesk);
    font-weight: 600;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    letter-spacing: -0.01em;
    color: var(--accent-soft);
    font-variant-numeric: tabular-nums;
  }
  .log__hook {
    margin: 0.3rem 0 0;
    max-width: 52ch;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }
  .log__label {
    margin-left: 0.5rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .log__end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: clamp(2rem, 5vw, 3.25rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .log__list::before {
      left: 4px;
    }
    .log__link {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding-left: 1.5rem;
    }
    .log__node {
      left: 4px;
    }
    .log__date {
      flex-direction: row;
      align-items: baseline;
      gap: 0.55rem;
      text-align: left;
    }
    .log__read {
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .log__head {
      animation: rise 0.45s ease-out both;
    }
    .log__item {
      animation: rise 0.5s ease-out both;
    }
    .log__item:nth-child(1) {
      animation-delay: 0.08s;
    }
    .log__item:nth-child(2) {
      animation-delay: 0.15s;
    }
    .log__end {
      animation: rise 0.5s ease-out 0.22s both;
    }
  }
</style>
