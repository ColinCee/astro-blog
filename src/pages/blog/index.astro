---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const readMin = (body?: string) =>
  Math.max(1, Math.round((body?.trim().split(/\s+/).length || 0) / 200));
const dayMonth = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "2-digit", month: "short" });
---

<Base
  title="Blog — Colin Cheung"
  description="Engineering notes, discoveries, and opinions from Colin Cheung — senior software engineer in Glasgow."
>
  <div class="blog">
    <header class="masthead">
      <h1 class="masthead__title">Blog</h1>
      <p class="masthead__note">
        {posts.length} posts — notes on shipping software, mostly.
      </p>
    </header>

    <ol class="entries">
      {
        posts.map((post) => (
          <li class="post">
            <a class="post__link" href={`/blog/${post.id}/`}>
              <div class="post__aside">
                <span class="post__year">{post.data.pubDate.getFullYear()}</span>
                <span class="post__day">{dayMonth(post.data.pubDate)}</span>
                <span class="post__read">{readMin(post.body)} min</span>
              </div>
              <div class="post__main">
                <h2 class="post__title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="post__desc">{post.data.description}</p>
                )}
                <span class="post__go">
                  read the post
                  <span class="post__arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .blog {
    max-width: 60rem;
    margin: 0 auto;
  }

  /* ── masthead ────────────────────────────────────────────────────── */
  .masthead {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .masthead__title {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 800;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    color: var(--ink);
  }
  .masthead__note {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  /* ── entries ─────────────────────────────────────────────────────── */
  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post {
    border-top: 1px solid var(--line);
  }
  .post:last-child {
    border-bottom: 1px solid var(--line);
  }
  .post__link {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
    padding: clamp(2rem, 4vw, 3.25rem) 0;
  }

  .post__aside {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.4rem;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
  }
  .post__year {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .post__day {
    color: var(--muted);
  }
  .post__read {
    color: var(--faint);
  }

  .post__main {
    min-width: 0;
  }
  .post__title {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
    transition: color 0.18s ease;
  }
  .post__desc {
    margin: 1rem 0 0;
    max-width: 58ch;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  .post__go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.3rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--faint);
    transition: color 0.18s ease;
  }
  .post__arrow {
    transition: transform 0.24s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .post__link:hover .post__title,
  .post__link:hover .post__go {
    color: var(--accent);
  }
  .post__link:hover .post__arrow {
    transform: translateX(5px);
  }

  @media (max-width: 640px) {
    .post__link {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .post__aside {
      flex-direction: row;
      align-items: baseline;
      gap: 0.85rem;
      padding-top: 0;
    }
    .post__year {
      font-size: 0.9rem;
    }
  }

  /* ── entrance ────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .masthead {
      animation: rise 0.5s ease-out both;
    }
    .post {
      animation: rise 0.5s ease-out both;
    }
    .post:nth-child(1) {
      animation-delay: 0.08s;
    }
    .post:nth-child(2) {
      animation-delay: 0.15s;
    }
    .post:nth-child(3) {
      animation-delay: 0.22s;
    }
  }
</style>
