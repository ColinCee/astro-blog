---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { readMinutes } from "../../scripts/read-minutes";
import { statScale } from "../../scripts/stat-scale";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Each index row comes from the post's frontmatter: `title`, and `stat` with
// an optional `statLabel`. Every post gets the same row; nothing is listed here.

const entries = posts.map((post) => {
  const parts = post.data.stat?.includes("→")
    ? post.data.stat.split("→").map((x) => x.trim())
    : null;
  return {
    href: `/blog/${post.id}/`,
    title: post.data.title,
    year: post.data.pubDate.getFullYear(),
    mon: post.data.pubDate.toLocaleDateString("en-US", { month: "short" }),
    read: readMinutes(post.body),
    metric: post.data.stat ?? null,
    // "428 s → 23 s" splits so the old value can go grey; "82% vs 80%" stays ink
    parts,
    // the two sides drawn to scale under the stat, when they can be read
    scale: parts ? statScale(parts[0], parts[1]) : null,
    flat: post.data.stat?.includes(" vs ") ?? false,
    label: post.data.statLabel ?? null,
  };
});
---

<Base
  title="Blog · Colin Cheung"
  description="Short engineering notes from Colin Cheung. Things that got faster, smaller, or cheaper."
>
  <section class="log">
    <header class="log__head">
      <h1 class="log__sr">Blog</h1>
      <p class="log__kicker">// writing</p>
      <p class="log__lede">
        A collection of stuff I find interesting and want to share.
      </p>
    </header>

    <ol class="log__list">
      {entries.map((e, i) => (
        <li class="log__item" style={`--i:${i}`}>
          <a class="log__link" href={e.href}>
            <span class="log__node" aria-hidden="true" />
            <div class="log__date">
              <span class="log__year">{e.year}</span>
              <span class="log__mon">{e.mon}</span>
              <span class="log__read">{e.read} min</span>
            </div>
            <div class="log__body">
              <h2 class="log__title">{e.title}</h2>
              {e.metric && (
                <p
                  class:list={["log__sig", { "log__sig--flat": e.flat }]}
                  aria-hidden="true"
                >
                  {e.parts ? (
                    <Fragment>
                      <span class="log__was">{e.parts[0]}</span> →{" "}
                      <b>{e.parts[1]}</b>
                    </Fragment>
                  ) : (
                    <b>{e.metric}</b>
                  )}
                  {e.label && <span class="log__label">{e.label}</span>}
                </p>
              )}
              {e.scale && (
                <span class="log__bars" aria-hidden="true">
                  <i style={`--w:${e.scale.was.toFixed(3)}`} />
                  <i class="log__now" style={`--w:${e.scale.now.toFixed(3)}`} />
                </span>
              )}
            </div>
          </a>
        </li>
      ))}
    </ol>

    <p class="log__end" style={`--i:${entries.length}`}>
      <span class="log__end-note">That's everything so far. More soon.</span>
    </p>
  </section>
</Base>

<style>
  .log {
    max-width: var(--w-page);
    margin: 0 auto;
  }

  .log__head {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .log__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .log__kicker {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .log__lede {
    margin: 0;
    max-width: 40ch;
    font-family: var(--head);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.4;
    color: var(--ink);
    text-wrap: balance;
  }

  .log__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* continuous timeline spine */
  .log__list::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 5.5rem;
    width: 1px;
    background: var(--line);
  }

  .log__link {
    --pad: clamp(1.35rem, 3vw, 2rem);
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 2.25rem;
    align-items: start;
    padding: var(--pad) 0;
  }
  .log__node {
    position: absolute;
    left: 5.5rem;
    top: calc(var(--pad) + 0.4rem);
    width: 8px;
    height: 8px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--faint);
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
    z-index: 1;
  }
  .log__link:hover .log__node,
  .log__link:focus-visible .log__node {
    border-color: var(--accent);
    box-shadow: var(--ring);
  }

  .log__date {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.2rem;
    text-align: right;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }
  .log__year {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }
  .log__mon {
    font-size: 0.72rem;
    color: var(--faint);
  }
  .log__read {
    margin-top: 0.35rem;
    font-size: 0.6875rem;
    color: var(--faint);
  }

  .log__body {
    min-width: 0;
  }
  /* A list title reads as prose: Geist at a regular weight, a step under ink;
     the result is the accent, not this. */
  .log__title {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 400;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
    transition: color var(--dur-fast) var(--ease);
  }
  .log__link:hover .log__title,
  .log__link:focus-visible .log__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  /* The stat's two sides to scale, as the posts' before/after bars draw
     them: the old grey above, the new in the accent, each a fraction of the
     larger. They grow in with the row. */
  .log__bars {
    display: grid;
    gap: 3px;
    width: min(14rem, 100%);
    margin-top: 0.6rem;
  }
  .log__bars i {
    display: block;
    height: 4px;
    min-width: 2px;
    width: calc(var(--w) * 100%);
    border-radius: 1px;
    background: var(--bar);
  }
  .log__bars .log__now {
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .log__bars i {
      transform-origin: left;
      animation: log-grow 0.9s var(--ease-out) calc(0.3s + var(--i, 0) * 0.08s)
        both;
    }
  }
  @keyframes log-grow {
    from {
      transform: scaleX(0);
    }
  }
  .log__sig {
    margin: 0.5rem 0 0;
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .log__was {
    color: var(--faint);
  }
  .log__sig b {
    font-weight: 500;
    color: var(--accent-text);
  }
  .log__sig--flat b {
    color: var(--ink);
  }
  .log__label {
    margin-left: 0.5rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--faint);
  }

  .log__end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: clamp(2rem, 5vw, 3.25rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .log__list::before {
      left: 4px;
    }
    .log__link {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding-left: 1.5rem;
    }
    .log__node {
      left: 4px;
    }
    .log__date {
      flex-direction: row;
      align-items: baseline;
      gap: 0.55rem;
      text-align: left;
    }
    .log__read {
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .log__head {
      animation: rise var(--dur-slow) var(--ease-out) both;
    }
    .log__item {
      animation: rise var(--dur-slow) var(--ease-out) both;
      animation-delay: calc(0.08s + var(--i, 0) * 0.07s);
    }
    .log__end {
      animation: rise var(--dur-slow) var(--ease-out) both;
      animation-delay: calc(0.08s + var(--i, 0) * 0.07s);
    }
  }
</style>
