---
import { getCollection } from "astro:content";
import "../styles/terminal.css";
import AgentPane from "../components/AgentPane.astro";
import RadarPane from "../components/RadarPane.astro";
import ankiCards from "../components/anki-cards.json";

// Terminal-native homepage for colincheung.dev. Colours come from the tokens
// in terminal.css and follow the system light/dark setting.
// Shared design tokens + fonts live in src/styles/terminal.css (the design system).

// Left pane — who Colin is, rendered as a real terminal session (.who__session).
const name = "Colin Cheung";
const nameCjk = "張志權";
const whoLine = "Open to remote · UK-based";
const nowLine = "Tech lead @ EDF Energy, leading AI adoption across the team.";

// Side projects — each a tile below the terminal with a live piece of it:
// the dissertation agent playing, a simulated radar, the homelab stacks, a card
// from the deck, this site's last deploy. `href` is where the tile goes.
const projects = [
  {
    name: "home-lab",
    desc: "self-hosted infra · Docker Compose, semantic search",
    href: "https://github.com/ColinCee/homelab",
  },
  {
    name: "anki-chinese",
    desc: "Mandarin deck builder · Python, Gemini + TTS",
    href: "https://github.com/ColinCee/anki-chinese",
  },
  {
    name: "colincheung.dev",
    desc: "this site · Astro, terminal-native",
    href: "https://github.com/ColinCee/astro-blog",
  },
  {
    name: "flight-tracker",
    desc: "home ADS-B receiver · live aircraft feed",
    href: "https://github.com/ColinCee/flight-tracker-at-home",
  },
];

// Rotating dry one-liners under the name. Each is a line of trusted HTML: plain
// text with the punchline in <b>, and for some a small inline drawing (classes
// prefixed q-, styled below). Behaviours are opt-in data attributes:
//   data-flip="7,0"  the counter shows 7, then flips to 0 while on screen
//   data-odo="N"     a counter that keeps ticking up from N
// The markup here is the resting state (what no-JS and reduced motion show).
const quips = [
  `<span class="q-ctr" data-flip="7,0">0</span> days since the last prod incident`,
  `still waiting to reverse a <b>linked list</b> at work <svg class="q-svg" width="54" height="14" viewBox="0 0 54 14" aria-hidden="true"><path class="q-line q-arrow" d="M12 7 H20 M17.5 4.5 L20 7 L17.5 9.5"/><path class="q-line q-arrow q-arrow--2" d="M32 7 H40 M37.5 4.5 L40 7 L37.5 9.5"/><rect class="q-node q-node--head" x="1" y="2" width="10" height="10" rx="2"/><rect class="q-node" x="21" y="2" width="10" height="10" rx="2"/><rect class="q-node q-node--tail" x="41" y="2" width="10" height="10" rx="2"/></svg>`,
  `<b>LGTM</b> (didn’t read)`,
  `still on <b>16GB</b> of RAM in 2026`,
  `coffee <span class="q-meter q-meter--drain" aria-hidden="true"><i></i></span> into <b>code</b> <span class="q-meter q-meter--fill" aria-hidden="true"><i></i></span>`,
  `never seen a <b>linear</b> burndown chart in my life <svg class="q-svg" width="64" height="18" viewBox="0 0 64 18" aria-hidden="true"><path class="q-line" stroke-dasharray="3 3" d="M1 2 L63 16"/><path class="q-line q-line--hot" d="M1 2 L12 3 L22 3 L30 6 L40 5 L50 9 L63 7"/></svg>`,
  `<b>0</b> tests failing (0 tests)`,
  `<b>claude</b> implement this, make no mistakes.`,
  `homelab <span class="q-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i class="is-down"></i><i></i><i></i><i></i></span> <b>1</b> powercut from downtime`,
  `TODO: fix this <b>later</b> (2019)`,
  `today <span class="q-split" aria-hidden="true"><i style="--w:7"></i><i class="is-hot" style="--w:1"></i></span> meetings / <b>code</b>`,
  `another meeting that could've been an <b>email</b>`,
  `infinite RAM, if you count <b>swap</b>`,
  `git blame <svg class="q-svg" width="52" height="18" viewBox="0 0 52 18" aria-hidden="true"><path class="q-line" d="M3 9 H49 M14 9 C20 9 20 3 26 3 H34 C40 3 40 9 46 9"/><circle class="q-fill" cx="3" cy="9" r="2.5"/><circle class="q-fill" cx="26" cy="3" r="2.5"/><circle class="q-fill q-fill--hot" cx="46" cy="9" r="3.2"/></svg> says it was <b>me</b>`,
  `reads the docs as a <b>last resort</b>`,
  `<b data-odo="2000000000">2,000,000,000</b> tokens burned today`,
  `learning Mandarin one <b>Anki card</b> at a time`,
  `testing in <b>production…</b>`,
];

// "Worked at" marquee — chronological by join date (oldest → newest), with years.
const companies = [
  { name: "PodFather", year: "2017" },
  { name: "Skyscanner", year: "2020" },
  { name: "Hometree", year: "2021" },
  { name: "Hopper", year: "2022" },
  { name: "BBC", year: "2022" },
  { name: "EDF Energy", year: "2023" },
];

// Right-bottom pane — latest writing, as readable titles. Read from the blog
// collection so publishing a post updates the homepage automatically.
const latest = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Writing section below the terminal — the newest post as a lead panel, the
// others as rows. `stat` (frontmatter) is the post's headline number, shown
// as a mono chip.
const [lead, ...rest] = latest.map((p) => ({
  title: p.data.title,
  subtitle: p.data.subtitle,
  stat: p.data.stat,
  date: p.data.pubDate.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  }),
  href: `/blog/${p.id}/`,
}));

const posts: {
  title: string;
  date: string;
  href: string;
  all?: boolean;
}[] = [
  ...latest.map((p) => ({
    title: p.data.title,
    date: p.data.pubDate.toLocaleDateString("en-US", {
      month: "short",
      year: "numeric",
    }),
    href: `/blog/${p.id}/`,
  })),
  { title: "All posts", date: "", href: "/blog", all: true },
];

const github = "https://github.com/ColinCee";
const flightDemo = "https://flight-tracker-at-home.pages.dev";
const linkedin = "https://www.linkedin.com/in/colin-cheung/";


// Shipped — before/after improvements, newest first. Bars are drawn to scale
// (after ÷ before); `rel` rows have no absolute figures, only a ratio.
const shipped = [
  {
    what: "Data-lake export, as Parquet",
    where: "Post",
    when: "Sep 2025",
    href: "/blog/jsonl-to-parquet-compression/",
    before: "4.5GB",
    after: "221MB",
    ratio: 221 / 4500,
  },
  {
    what: "Build + test cycle",
    where: "EDF Energy",
    when: "2023 – now",
    href: "/cv",
    before: "30 min",
    after: "5 min",
    ratio: 5 / 30,
  },
  {
    what: "CI-log debugging time",
    where: "BBC",
    when: "2022 – 2023",
    href: "/cv",
    before: "baseline",
    after: "up to −90%",
    ratio: 0.1,
  },
  {
    what: "HRMS → Active Directory sync",
    where: "Skyscanner",
    when: "2020 – 2021",
    href: "/cv",
    before: "8 hours",
    after: "2 min",
    ratio: 2 / 480,
  },
];

// The lead post's headline figure, outlined behind its panel.
const leadStat = latest[0]?.data.stat as string | undefined;
const leadFig = leadStat ? leadStat.split("→").pop()!.trim() : "";

// The homelab's Compose stacks, as in its repo.
const homelabStacks = [
  { name: "observability", services: "grafana · prometheus · loki · alloy" },
  { name: "flight-tracker", services: "backend · cloudflared" },
  { name: "home-assistant", services: "homeassistant" },
  { name: "crowdsec", services: "crowdsec" },
  { name: "backup", services: "restic, nightly" },
];

// The commit this page was built from, for the status bar, the footer and the
// site's own tile (see astro.config.mjs).
const build = __BUILD__;

// Left-pane hero: core skills as a live `top` process list. TIME+ = years of
// experience (now − since) — a real, honest number, no invented scores.
const skillSeed = [
  { name: "typescript", since: 2018 },
  { name: "react", since: 2017 },
  { name: "aws", since: 2019 },
  { name: "distributed-sys", since: 2020 },
  { name: "ai-development", since: 2024 },
];
const nowYear = new Date().getFullYear();
// top sorts by usage; here TIME+ (years of experience) runs highest-first.
const procs = skillSeed
  .map((s) => ({ ...s, years: nowYear - s.since }))
  .sort((a, b) => b.years - a.years);
const today = new Date().toLocaleDateString("en-CA");

// Classic shell greeting for the whoami session (rendered at build/SSR time).
const _lg = new Date();
const _lgDays = "Sun Mon Tue Wed Thu Fri Sat".split(" ");
const _lgMonths = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(" ");
const _lgH = String(_lg.getHours()).padStart(2, "0");
const _lgM = String(_lg.getMinutes()).padStart(2, "0");
const lastLogin = `${_lgDays[_lg.getDay()]} ${_lgMonths[_lg.getMonth()]} ${_lg.getDate()} ${_lgH}:${_lgM}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Colin Cheung · Senior Software Engineer</title>
    <meta
      name="description"
      content="Colin Cheung, Senior Software Engineer in Glasgow. Tech lead at EDF Energy, leading AI adoption. I make systems boring on purpose."
    />
    <link rel="canonical" href="https://colincheung.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://colincheung.dev/" />
    <meta
      property="og:title"
      content="Colin Cheung · Senior Software Engineer"
    />
    <meta
      property="og:description"
      content="Senior Software Engineer in Glasgow. Tech lead at EDF Energy, leading AI adoption."
    />
    <meta property="og:image" content="https://colincheung.dev/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://colincheung.dev/og.png" />
  </head>
  <body>
    <main class="t">
      <!-- Ambient background behind the hero: contour lines, still until the
           mouse moves over them. Drawn by JS; without it (or with reduced
           motion) only the still dot grid shows. -->
      <canvas class="t-bg" aria-hidden="true"></canvas>
      <nav class="t-nav">
        <a class="t-mark" href="/">colin<span>@</span>glasgow<b>:~$</b></a>
        <div class="t-nav__links">
          <a href="/blog">BLOG</a>
          <a href="/cv">CV</a>
        </div>
      </nav>

      <!-- Hero — name + social icons -->
      <section class="kin" aria-label="Colin Cheung, Senior Software Engineer">
        <p class="kin__eyebrow">Senior Software Engineer</p>
        <h1 class="kin__name">
          <span class="kin__word"><span>COLIN</span></span>
          <span class="kin__word"><span>CHEUNG</span></span>
        </h1>
        <p class="kin__rot">
          <span
            data-quip
            data-quips={JSON.stringify(quips)}
            set:html={quips[0]}
          />
        </p>
        <div class="kin__social">
          <a class="kin__ico" href={github} aria-label="GitHub"
            ><svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path></svg
            ></a
          >
          <a class="kin__ico" href={linkedin} aria-label="LinkedIn"
            ><svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
              ></path></svg
            ></a
          >
        </div>
      </section>

      <section
        class="term"
        aria-label="Colin at a glance, as a terminal session"
      >
        <div class="term__bar">
          <span class="term__dots" aria-hidden="true"
            ><i></i><i></i><i></i></span
          >
          <span class="term__name">~/ColinOS - tmux</span>
        </div>

        <div class="term__panes">
          <!-- Left (full height) — who Colin is, plain words -->
          <article class="pane pane--who">
            <h2 class="pane__bar"><span class="pane__idx">0</span>whoami</h2>
            <div class="pane__body">
              <div
                class="who__session"
                aria-label="Colin, as a terminal session"
              >
                <p class="who__login">Last login: {lastLogin} on ttys001</p>
                <p class="term-cmd">
                  <span class="who__prompt">$</span>
                  <span class="who__typed js-cmd">whoami</span><span
                    class="who__caret"></span>
                </p>
                <div class="term-out js-out">
                  <p class="who__name">
                    {name}
                    <span class="cjk" lang="zh-Hant">{nameCjk}</span>
                  </p>
                  <p class="who__sub">{whoLine}</p>
                </div>

                <p class="term-cmd">
                  <span class="who__prompt">$</span>
                  <span class="who__typed js-cmd">top -u colin</span><span
                    class="who__caret"></span>
                </p>
                <div class="term-out js-out who__mon">
                  <div class="who__cols">
                    <span>COMMAND</span><span>SINCE</span><span>TIME+</span>
                  </div>
                  {
                    procs.map((p) => (
                      <div class="who__proc">
                        <span class="who__pname">{p.name}</span>
                        <span class="who__psince">{p.since}</span>
                        <span class="who__ptime">{p.years}y</span>
                      </div>
                    ))
                  }
                </div>

                <p class="term-cmd">
                  <span class="who__prompt">$</span>
                  <span class="who__typed js-cmd">cat now.md</span><span
                    class="who__caret"></span>
                </p>
                <div class="term-out js-out">
                  <p class="who__now">{nowLine}</p>
                </div>

                <p class="term-cmd">
                  <span class="who__prompt">$</span>
                  <span class="who__typed js-cmd">weather</span><span
                    class="who__caret"></span>
                </p>
                <div class="term-out js-out">
                  <p class="who__wx" data-weather>Glasgow</p>
                </div>

                <p class="term-cmd">
                  <span class="who__prompt">$</span>
                  <span class="who__typed js-cmd">ls ~/contact</span><span
                    class="who__caret"></span>
                </p>
                <div class="term-out js-out who__links">
                  <a href={github}
                    ><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"
                      ><path
                        d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                      ></path></svg
                    >github.com/ColinCee</a
                  >
                  <a href={linkedin}
                    ><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"
                      ><path
                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
                      ></path></svg
                    >linkedin.com/in/colin-cheung</a
                  >
                </div>

                <p class="term-cmd term-cmd--rest">
                  <span class="who__prompt">$</span>
                  <span class="who__caret"></span>
                </p>
              </div>
            </div>
          </article>

          <!-- Right-top — improvements shipped; bars drawn to scale -->
          <article class="pane pane--ship is-active">
            <h2 class="pane__bar"><span class="pane__idx">1</span>shipped</h2>
            <div class="pane__body">
              <ul class="ships">
                {
                  shipped.map((s) => (
                    <li>
                      <a class="ship" href={s.href}>
                        <span class="ship__head">
                          <span class="ship__what">{s.what}</span>
                          <span class="ship__meta">
                            {s.where} · {s.when}
                          </span>
                        </span>
                        <span class="ship__bar">
                          <span class="ship__label">before</span>
                          <span class="ship__track">
                            <i class="ship__fill" style="--w: 1" />
                            <b>{s.before}</b>
                          </span>
                        </span>
                        <span class="ship__bar ship__bar--after">
                          <span class="ship__label">after</span>
                          <span class="ship__track">
                            <i
                              class="ship__fill"
                              style={`--w: ${s.ratio.toFixed(4)}`}
                            />
                            <b>{s.after}</b>
                          </span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </article>

          <!-- Right-bottom — latest writing -->
          <article class="pane pane--writing">
            <h2 class="pane__bar"><span class="pane__idx">2</span>writing</h2>
            <div class="pane__body">
              <ul class="posts">
                {
                  posts.map((p) => (
                    <li>
                      <a
                        class:list={["post", { "post--all": p.all }]}
                        href={p.href}
                      >
                        <span class="post__title">{p.title}</span>
                        {p.date && <span class="post__date">{p.date}</span>}
                        <span class="post__go" aria-hidden="true">
                          →
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </article>
        </div>

        <div class="term__status" aria-hidden="true">
          <span class="term__tabs"
            ><b>[colin]</b> 0:whoami <em>1:shipped*</em> 2:writing</span
          >
          <span class="term__ticker">
            {build.hash && (
              <span class="term__build" title={build.subject} data-build={build.when}>
                built <span data-build-rel>{build.when.slice(0, 10)}</span> · <b>{build.hash}</b>
              </span>
            )}
            <span data-date>{today}</span>
            <span class="term__clock" data-clock>--:--:--</span>
          </span>
        </div>
      </section>

      <section class="strip" aria-label="Companies I have worked at">
        <span class="strip__label">// worked at</span>
        <div class="strip__view" aria-hidden="true">
          <div class="strip__track">
            {
              [...companies, ...companies, ...companies].map((c) => (
                <span class="strip__item">
                  <b class="strip__yr">{c.year}</b>
                  {c.name}
                  <i>/</i>
                </span>
              ))
            }
          </div>
        </div>
        <button class="strip__toggle" type="button" aria-pressed="false" data-strip-toggle hidden>pause</button>
        <ul class="sr-only">
          {
            companies.map((c) => (
              <li>
                {c.name}, {c.year}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Projects — side work, as quiet tiles; the accent appears on hover -->
      <section class="work" aria-label="Side projects" data-reveal>
        <p class="work__tag">// projects</p>
        <ul class="work__list" data-live-tiles>
          <li class="tile tile--wide" style="--i: 0">
            <a class="tile__head" href="https://github.com/ColinCee/GVGAI-Dissertation">
              <span class="proj__path tile__path"><i aria-hidden="true" /><span class="tile__home">~/projects/dissertation</span><span class="tile__repo">github.com/ColinCee/GVGAI-Dissertation</span><span class="proj__go" aria-hidden="true">↗</span></span>
              <span class="proj__name">dissertation</span>
              <span class="proj__desc">game-playing agents, trained in 2018 and again in 2026</span>
            </a>
            <div class="tile__live"><AgentPane compact rate={0.3} /></div>
          </li>
          <li class="tile" style="--i: 1">
            <a class="tile__head" href={flightDemo}>
              <span class="proj__path tile__path"><i aria-hidden="true" /><span class="tile__home">~/projects/flight-tracker</span><span class="tile__repo">flight-tracker-at-home.pages.dev</span><span class="proj__go" aria-hidden="true">↗</span></span>
              <span class="proj__name">flight-tracker</span>
              <span class="proj__desc">the London airspace; the real one is live</span>
            </a>
            <div class="tile__live"><RadarPane /></div>
          </li>
          <li class="tile" style="--i: 2">
            <a class="tile__head" href={projects[0].href}>
              <span class="proj__path tile__path"><i aria-hidden="true" /><span class="tile__home">~/projects/home-lab</span><span class="tile__repo">github.com/ColinCee/homelab</span><span class="proj__go" aria-hidden="true">↗</span></span>
              <span class="proj__name">home-lab</span>
              <span class="proj__desc">one mini-PC, five Compose stacks</span>
            </a>
            <div class="tile__live">
              <p class="stack__cmd"><span class="who__prompt">$</span> docker compose ls</p>
              <ul class="stack">
                {homelabStacks.map((s, r) => (
                  <li style={`--r: ${r}`}><b>{s.name}</b><span>{s.services}</span></li>
                ))}
              </ul>
            </div>
          </li>
          <li class="tile" style="--i: 3">
            <a class="tile__head" href={projects[1].href}>
              <span class="proj__path tile__path"><i aria-hidden="true" /><span class="tile__home">~/projects/anki-chinese</span><span class="tile__repo">github.com/ColinCee/anki-chinese</span><span class="proj__go" aria-hidden="true">↗</span></span>
              <span class="proj__name">anki-chinese</span>
              <span class="proj__desc">the Mandarin deck I'm learning from</span>
            </a>
            <div class="tile__live">
              <button type="button" class="card" data-anki data-cards={JSON.stringify(ankiCards)} aria-label="Flip the flashcard; flip again for another">
                <span class="card__inner">
                  <span class="card__face card__front">
                    <span class="card__hanzi" lang="zh-Hans" data-anki-hanzi>{ankiCards[0].hanzi}</span>
                    <span class="card__hint">flip</span>
                  </span>
                  <span class="card__face card__back">
                    <span class="card__py" data-anki-py>{ankiCards[0].pinyin}</span>
                    <span class="card__jp"><span data-anki-jp>{ankiCards[0].jyutping}</span> · Cantonese</span>
                    <span class="card__mean" data-anki-mean>{ankiCards[0].meaning}</span>
                    <span class="card__hint">tap · next card</span>
                  </span>
                </span>
              </button>
            </div>
          </li>
          <li class="tile" style="--i: 4">
            <a class="tile__head" href={projects[2].href}>
              <span class="proj__path tile__path"><i aria-hidden="true" /><span class="tile__home">~/projects/colincheung.dev</span><span class="tile__repo">github.com/ColinCee/astro-blog</span><span class="proj__go" aria-hidden="true">↗</span></span>
              <span class="proj__name">colincheung.dev</span>
              <span class="proj__desc">this site, deployed from every commit</span>
            </a>
            <div class="tile__live">
              {build.hash ? (
                <div class="site" data-build={build.when}>
                  <ol class="pipe" aria-label="The deploy this page is running from">
                    <li class="is-done"><b>commit</b><a href={`https://github.com/ColinCee/astro-blog/commit/${build.hash}`}>{build.hash}</a></li>
                    <li class="is-done"><b>build</b><span>astro + wrangler</span></li>
                    <li class="is-now"><b>live</b><span data-build-rel>{build.when.slice(0, 10)}</span></li>
                  </ol>
                  <p class="site__msg" title={build.subject}>“{build.subject}”</p>
                </div>
              ) : (
                <p class="site__none">built outside git</p>
              )}
            </div>
          </li>
        </ul>
      </section>

      <!-- Writing — newest post as a lead panel, the rest as rows -->
      <section class="feat" aria-label="Latest writing" data-reveal>
        <p class="feat__tag">// writing</p>
        <div class="feat__grid">
          {
            lead && (
              <a class="lead" href={lead.href}>
                {leadFig && <span class="lead__fig" aria-hidden="true">{leadFig}</span>}
                <span class="lead__meta">
                  <span class="lead__new">latest</span>
                  {lead.date}
                </span>
                <span class="lead__title">{lead.title}</span>
                {lead.subtitle && <span class="lead__desc">{lead.subtitle}</span>}
                <span class="lead__foot">
                  {lead.stat && <span class="chip">{lead.stat}</span>}
                  <span class="feat__go">
                    read <span aria-hidden="true">→</span>
                  </span>
                </span>
              </a>
            )
          }
          <ul class="rows">
            {
              rest.map((p) => (
                <li>
                  <a class="row" href={p.href}>
                    <span class="row__date">{p.date}</span>
                    <span class="row__body">
                      <span class="row__title">{p.title}</span>
                      {p.subtitle && <span class="row__desc">{p.subtitle}</span>}
                    </span>
                    {p.stat && <span class="chip">{p.stat}</span>}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="row row--all" href="/blog">
                <span class="row__date" />
                <span class="row__body">
                  <span class="row__title">All posts</span>
                </span>
                <span class="feat__go">
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          </ul>
        </div>
      </section>

      <!-- Contact — closing call to connect -->
      <section class="reach" id="contact" aria-label="Get in touch" data-reveal>
        <p class="reach__tag">// reach out</p>
        <p class="reach__line">
          Best way to reach me is <a href={linkedin}
            >LinkedIn <span aria-hidden="true">↗</span></a
          >
        </p>
        <p class="reach__alt">
          or read the code on <a href={github}
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </p>
      </section>

      <footer class="t-foot">
        <span>COLIN CHEUNG</span>
        <span>
          © 2026 · BUILT IN GLASGOW{build.hash && (
            <Fragment>
              {" "}· <a class="t-foot__build" href={`https://github.com/ColinCee/astro-blog/commit/${build.hash}`} title={build.subject}>LAST DEPLOY {build.hash}</a>
            </Fragment>
          )}
        </span>
      </footer>
    </main>

    <script>
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // The companies strip scrolls by itself; this stops and restarts it. Under reduced
      // motion the strip stands still, so the button stays hidden.
      const stripToggle = document.querySelector<HTMLButtonElement>("[data-strip-toggle]");
      if (stripToggle && !reduce) {
        stripToggle.hidden = false;
        stripToggle.addEventListener("click", () => {
          const paused = stripToggle.closest(".strip")!.classList.toggle("is-paused");
          stripToggle.setAttribute("aria-pressed", String(paused));
          stripToggle.textContent = paused ? "play" : "pause";
        });
      }

      // Sections below the terminal rise in as they scroll into view. Armed by
      // JS only, so without it (or with reduced motion) they are simply visible.
      const reveals = Array.from(
        document.querySelectorAll<HTMLElement>("[data-reveal]"),
      );
      if (reveals.length && !reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            });
          },
          { threshold: 0.15 },
        );
        reveals.forEach((el) => {
          el.classList.add("is-armed");
          io.observe(el);
        });
      }

      // Live date + clock in the tmux status bar.
      const clocks = Array.from(
        document.querySelectorAll<HTMLElement>("[data-clock]"),
      );
      const dates = Array.from(
        document.querySelectorAll<HTMLElement>("[data-date]"),
      );
      function tickClock() {
        const now = new Date();
        const time = now.toLocaleTimeString("en-GB", { hour12: false });
        clocks.forEach((c) => (c.textContent = time));
        const date = now.toLocaleDateString("en-CA");
        dates.forEach((d) => (d.textContent = date));
      }
      tickClock();
      if (!reduce) setInterval(tickClock, 1000);

      // Live Glasgow weather in the terminal (open-meteo, no API key).
      const wxEl = document.querySelector<HTMLElement>("[data-weather]");
      if (wxEl) {
        type WeatherResponse = {
          current?: {
            temperature_2m?: unknown;
            weather_code?: number;
          };
        };
        const wxCodes: Record<number, string> = {
          0: "clear",
          1: "mainly clear",
          2: "partly cloudy",
          3: "overcast",
          45: "fog",
          48: "fog",
          51: "light drizzle",
          53: "drizzle",
          55: "heavy drizzle",
          56: "freezing drizzle",
          57: "freezing drizzle",
          61: "light rain",
          63: "rain",
          65: "heavy rain",
          66: "freezing rain",
          67: "freezing rain",
          71: "light snow",
          73: "snow",
          75: "heavy snow",
          77: "snow grains",
          80: "light showers",
          81: "showers",
          82: "heavy showers",
          85: "snow showers",
          86: "snow showers",
          95: "thunderstorm",
          96: "thunderstorm",
          99: "thunderstorm",
        };
        const wxIcon: Record<number, string> = {
          0: "☀️",
          1: "🌤️",
          2: "⛅",
          3: "☁️",
          45: "🌫️",
          48: "🌫️",
          51: "🌦️",
          53: "🌦️",
          55: "🌧️",
          56: "🌧️",
          57: "🌧️",
          61: "🌧️",
          63: "🌧️",
          65: "🌧️",
          66: "🌧️",
          67: "🌧️",
          71: "🌨️",
          73: "🌨️",
          75: "❄️",
          77: "🌨️",
          80: "🌦️",
          81: "🌧️",
          82: "🌧️",
          85: "🌨️",
          86: "🌨️",
          95: "⛈️",
          96: "⛈️",
          99: "⛈️",
        };
        fetch(
          "https://api.open-meteo.com/v1/forecast?latitude=55.8642&longitude=-4.2518&current=temperature_2m,weather_code",
        )
          .then((r) => r.json())
          .then((d: WeatherResponse) => {
            const c = d.current;
            if (
              !c ||
              typeof c.temperature_2m !== "number" ||
              typeof c.weather_code !== "number"
            ) {
              return;
            }
            const temp = Math.round(c.temperature_2m);
            const desc = wxCodes[c.weather_code] || "";
            const icon = wxIcon[c.weather_code] || "";
            wxEl.textContent = `Glasgow · ${icon ? icon + " " : ""}${temp}°C${desc ? " · " + desc : ""}`;
          })
          .catch(() => {});
      }

      // "built 2h ago", from the commit date baked in at build.
      document.querySelectorAll<HTMLElement>("[data-build]").forEach((buildEl) => {
        const rel = buildEl.querySelector<HTMLElement>("[data-build-rel]")!;
        const then = new Date(buildEl.dataset.build!).valueOf();
        const fmt = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
        const tick = () => {
          const s = Math.round((then - Date.now()) / 1000);
          const a = Math.abs(s);
          rel.textContent =
            a < 3600 ? fmt.format(Math.round(s / 60), "minute")
            : a < 86400 ? fmt.format(Math.round(s / 3600), "hour")
            : fmt.format(Math.round(s / 86400), "day");
        };
        tick();
        setInterval(tick, 60_000);
      });

      // The tiles' live parts boot in once, a beat apart, as the section arrives.
      const tiles = document.querySelector<HTMLElement>("[data-live-tiles]");
      if (tiles && !reduce && "IntersectionObserver" in window) {
        tiles.classList.add("is-armed");
        const io = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          tiles.classList.add("is-live");
        }, { threshold: 0.15 });
        io.observe(tiles);
      }

      // A random real card from the deck. Flip to read it, flip again for another.
      document.querySelectorAll<HTMLElement>("[data-anki]").forEach((card) => {
        const cards = JSON.parse(card.dataset.cards || "[]") as { hanzi: string; pinyin: string; jyutping: string; meaning: string }[];
        let at = Math.floor(Math.random() * cards.length);
        const show = () => {
          const c = cards[at];
          if (!c) return;
          card.querySelector("[data-anki-hanzi]")!.textContent = c.hanzi;
          card.querySelector("[data-anki-py]")!.textContent = c.pinyin;
          card.querySelector("[data-anki-jp]")!.textContent = c.jyutping;
          card.querySelector("[data-anki-mean]")!.textContent = c.meaning;
        };
        show();
        card.addEventListener("click", () => {
          const flipped = card.classList.toggle("is-flipped");
          if (!flipped) setTimeout(() => { at = (at + 1) % cards.length; show(); }, 300);
        });
        card.addEventListener("mouseleave", () => card.classList.remove("is-flipped"));
      });

      // Rotating dry one-liners (reduced motion shows the first, at rest).
      document
        .querySelectorAll<HTMLElement>("[data-quip]")
        .forEach((quipEl) => {
          if (reduce) return;
          const quipList = JSON.parse(quipEl.dataset.quips || "[]") as string[];
          if (quipList.length < 2) return;
          let timers: number[] = [];
          // Start the opt-in behaviours of whichever quip is now showing.
          const animate = () => {
            timers.forEach((t) => window.clearTimeout(t));
            timers = [];
            const flip = quipEl.querySelector<HTMLElement>("[data-flip]");
            if (flip) {
              const [from, to] = (flip.dataset.flip || "").split(",");
              flip.textContent = from;
              timers.push(
                window.setTimeout(() => {
                  flip.classList.add("is-flipping");
                  timers.push(
                    window.setTimeout(() => (flip.textContent = to), 160),
                  );
                }, 1300),
              );
            }
            const odo = quipEl.querySelector<HTMLElement>("[data-odo]");
            if (odo) {
              let n = Number(odo.dataset.odo);
              const tick = () => {
                n += 10_000 + Math.floor(Math.random() * 90_000);
                odo.textContent = n.toLocaleString("en-GB");
                timers.push(window.setTimeout(tick, 120));
              };
              tick();
            }
          };
          animate();
          let qi = 0;
          setInterval(() => {
            qi = (qi + 1) % quipList.length;
            quipEl.style.opacity = "0";
            window.setTimeout(() => {
              quipEl.innerHTML = quipList[qi];
              quipEl.style.opacity = "1";
              animate();
            }, 380);
          }, 3600);
        });

      // Boot the whoami session: reveal each prompt, type its command, then reveal the
      // output — one block at a time, like a real shell. All content is in the DOM (SSR);
      // no-JS / reduced-motion shows the finished session, so nothing is gated.
      const session = document.querySelector<HTMLElement>(".who__session");
      if (session && !reduce) {
        const cmds = Array.from(
          session.querySelectorAll<HTMLElement>(".js-cmd"),
        );
        const outs = Array.from(
          session.querySelectorAll<HTMLElement>(".js-out"),
        );
        const lines = cmds.map((c) => c.closest<HTMLElement>(".term-cmd"));
        const rest = session.querySelector<HTMLElement>(".term-cmd--rest");
        session.classList.add("is-booting");
        cmds.forEach((c) => {
          c.dataset.text = c.textContent || "";
          c.textContent = "";
        });
        const finish = () => {
          session.classList.remove("is-booting");
          cmds.forEach((c) => (c.textContent = c.dataset.text || ""));
          lines.forEach((l) => l?.classList.add("is-in"));
          outs.forEach((o) => o.classList.add("is-in"));
          rest?.classList.add("is-in");
        };
        const failsafe = window.setTimeout(finish, 9000);
        let step = 0;
        const run = () => {
          if (step >= cmds.length) {
            window.clearTimeout(failsafe);
            rest?.classList.add("is-in");
            session.classList.remove("is-booting");
            return;
          }
          const cmd = cmds[step];
          const line = lines[step];
          line?.classList.add("is-in");
          line?.classList.add("is-typing");
          const full = cmd.dataset.text || "";
          let i = 0;
          const type = () => {
            cmd.textContent = full.slice(0, (i += 1));
            if (i < full.length) {
              window.setTimeout(type, 60);
              return;
            }
            line?.classList.remove("is-typing");
            const out = outs[step];
            if (out) {
              window.setTimeout(() => {
                out.classList.add("is-in");
                step += 1;
                window.setTimeout(run, 260);
              }, 150);
            } else {
              step += 1;
              window.setTimeout(run, 220);
            }
          };
          window.setTimeout(type, 220);
        };
        run();
      }

      // Ambient background: contour lines behind the hero. Still until the mouse
      // moves over the hero; then the field drifts for a moment and the cursor
      // presses a dip into it. Off under reduced motion (still grid).
      const bg = document.querySelector<HTMLCanvasElement>(".t-bg");
      const page = document.querySelector<HTMLElement>(".t");
      if (bg && page && !reduce) {
        const ctx = bg.getContext("2d")!;
        let W = 0, H = 0, ink = "#000", accent = "#c33";
        let visible = true, running = false, raf = 0, prev = 0;
        let vt = 0, awake = 0, press = 0, mx = -1e4, my = -1e4, drawn = false;
        const mul = 1;
        const ga = (v: number) => (ctx.globalAlpha = Math.min(1, v) * mul);

        const colors = () => {
          const cs = getComputedStyle(page);
          ink = cs.getPropertyValue("--ink").trim() || ink;
          accent = cs.getPropertyValue("--accent").trim() || accent;
        };
        const resize = () => {
          const dpr = Math.min(devicePixelRatio || 1, 2);
          W = bg.clientWidth;
          H = bg.clientHeight;
          bg.width = Math.round(W * dpr);
          bg.height = Math.round(H * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          drawn = false;
        };
        const dip = (x: number, y: number) => {
          if (press < 0.002) return 0;
          const dx = x - mx, dy = y - my;
          return -0.2 * press * Math.exp(-(dx * dx + dy * dy) / 26000);
        };

        // --- value noise (for the contours) ---
        const hash = (i: number, j: number, k: number) => {
          let h = Math.imul(i, 374761393) ^ Math.imul(j, 668265263) ^ Math.imul(k, 1013904223);
          h = Math.imul(h ^ (h >>> 13), 1274126177);
          return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
        };
        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
        const noise = (x: number, y: number, z: number) => {
          const xi = Math.floor(x), yi = Math.floor(y), zi = Math.floor(z);
          let fx = x - xi, fy = y - yi, fz = z - zi;
          fx = fx * fx * (3 - 2 * fx);
          fy = fy * fy * (3 - 2 * fy);
          fz = fz * fz * (3 - 2 * fz);
          const c = (dz: number) =>
            lerp(
              lerp(hash(xi, yi, zi + dz), hash(xi + 1, yi, zi + dz), fx),
              lerp(hash(xi, yi + 1, zi + dz), hash(xi + 1, yi + 1, zi + dz), fx),
              fy,
            );
          return lerp(c(0), c(1), fz);
        };
        const fbm = (x: number, y: number, z: number) =>
          0.65 * noise(x, y, z) + 0.35 * noise(x * 2.1 + 7, y * 2.1 + 3, z * 1.4);

        // --- contour lines from a field (marching squares) ---
        const drawContours = (t: number) => {
          const S = 12, cols = Math.ceil(W / S) + 1, rows = Math.ceil(H / S) + 1;
          const f = new Float32Array(cols * rows);
          for (let j = 0; j < rows; j++)
            for (let i = 0; i < cols; i++)
              f[j * cols + i] = fbm(i * S * 0.0035, j * S * 0.0035, t * 0.05) + dip(i * S, j * S);
          const levels = [0.36, 0.42, 0.48, 0.54, 0.6, 0.66];
          ctx.lineWidth = 1;
          levels.forEach((lv, L) => {
            const hot = L === 3;
            ctx.strokeStyle = hot ? accent : ink;
            ga(hot ? 0.45 : 0.12);
            ctx.beginPath();
            for (let j = 0; j < rows - 1; j++)
              for (let i = 0; i < cols - 1; i++) {
                const a = f[j * cols + i], b = f[j * cols + i + 1];
                const c = f[(j + 1) * cols + i + 1], d = f[(j + 1) * cols + i];
                const idx = +(a > lv) | (+(b > lv) << 1) | (+(c > lv) << 2) | (+(d > lv) << 3);
                if (idx === 0 || idx === 15) continue;
                const x = i * S, y = j * S;
                const top = [x + (S * (lv - a)) / (b - a), y];
                const right = [x + S, y + (S * (lv - b)) / (c - b)];
                const bot = [x + (S * (lv - d)) / (c - d), y + S];
                const left = [x, y + (S * (lv - a)) / (d - a)];
                const seg = (p: number[], q: number[]) => {
                  ctx.moveTo(p[0], p[1]);
                  ctx.lineTo(q[0], q[1]);
                };
                switch (idx) {
                  case 1: case 14: seg(left, top); break;
                  case 2: case 13: seg(top, right); break;
                  case 3: case 12: seg(left, right); break;
                  case 4: case 11: seg(right, bot); break;
                  case 5: seg(left, top); seg(right, bot); break;
                  case 6: case 9: seg(top, bot); break;
                  case 7: case 8: seg(left, bot); break;
                  case 10: seg(top, right); seg(left, bot); break;
                }
              }
            ctx.stroke();
          });
        };

        // One frame: advance the clock only while awake, draw only if something
        // changed, and stop scheduling frames once the field is still again.
        const loop = (ms: number) => {
          running = true;
          const t = ms / 1000, dt = Math.min(0.05, prev ? t - prev : 0.016);
          prev = t;
          const want = mx > -1e3 ? 1 : 0;
          press += (want - press) * Math.min(1, dt * 4);
          awake = Math.max(0, awake - dt / 1.6);
          vt += dt * awake * 3;
          const still = awake <= 0 && Math.abs(want - press) < 0.002;
          if (still && drawn) { running = false; return; }
          drawn = true;
          ctx.clearRect(0, 0, W, H);
          drawContours(vt);
          ctx.globalAlpha = 1;
          if (visible) raf = requestAnimationFrame(loop);
          else running = false;
        };
        const kick = () => {
          if (!visible || running) return;
          prev = 0;
          raf = requestAnimationFrame(loop);
        };
        page.addEventListener("pointermove", (e) => {
          const r = bg.getBoundingClientRect();
          mx = e.clientX - r.left;
          my = e.clientY - r.top;
          if (my > H) { mx = -1e4; return; }
          awake = 1;
          kick();
        });
        page.addEventListener("pointerleave", () => { mx = -1e4; kick(); });

