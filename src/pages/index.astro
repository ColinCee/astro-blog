---
// The homepage, on the shared shell at its wider poster width. Each section
// is a component in src/components/home/; its data is in src/data/.

import Hero from "../components/home/Hero.astro";
import Projects from "../components/home/Projects.astro";
import Reach from "../components/home/Reach.astro";
import Terminal from "../components/home/Terminal.astro";
import WorkedAt from "../components/home/WorkedAt.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Colin Cheung · Senior Software Engineer"
  description="Colin Cheung, Senior Software Engineer in Glasgow. Tech lead at EDF Energy, leading AI adoption. I make systems boring on purpose."
  ogDescription="Senior Software Engineer in Glasgow. Tech lead at EDF Energy, leading AI adoption."
  home
>
  <Hero />
  <Terminal />
  <WorkedAt />
  <Projects />
  <Reach />
</Base>

<style is:global>
  html {
    -webkit-text-size-adjust: 100%;
  }
  /* The homepage sets its own spacing: no default margins on headings,
     paragraphs and lists, and lists without bullets. */
  :where(.shell--home) :where(h1, h2, p, ul) {
    margin: 0;
  }
  :where(.shell--home) :where(ul) {
    padding: 0;
    list-style: none;
  }
  /* Sections below the terminal rise in as they scroll into view. */
  [data-reveal].is-armed {
    opacity: 0;
    transform: translateY(16px);
  }
  [data-reveal].is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
</style>

<script>
  // Armed by JS only, so without it (or with reduced motion) the sections are
  // simply visible.
  const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (
    reveals.length &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        });
      },
      { threshold: 0.15 },
    );
    reveals.forEach((el) => {
      el.classList.add("is-armed");
      io.observe(el);
    });
  }
</script>
