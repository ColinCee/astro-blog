        content: "—";
        position: absolute;
        left: 0;
        color: var(--faint);
        font-weight: 400;
      }
      .take b {
        font-weight: 500;
        color: var(--accent-soft);
      }

      /* ---------------- motion ---------------- */
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes slide {
        to {
          transform: translateX(-33.3333%);
        }
      }

      /* ---------------- responsive ---------------- */
      @media (max-width: 920px) {
        .term__panes {
          grid-template-columns: 1fr;
          grid-template-areas: "who" "hl" "writing";
        }
      }
      @media (max-width: 560px) {
        .t-nav__links {
          display: none;
        }
        /* reserve 2 lines so a wrapped subtitle doesn't shift the page */
        .kin__rot {
          min-height: 3em;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .t *,
        .t *::before,
        .t *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .strip__view {
          overflow: visible;
          -webkit-mask-image: none;
          mask-image: none;
        }
        .strip__track {
          flex-wrap: wrap;
          width: auto;
          gap: 0.2rem 0;
        }
      }
    </style>
  </body>
</html>
