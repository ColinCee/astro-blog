      }
      .strip__label {
        flex: none;
        font-family: var(--mono);
        font-size: 0.6875rem;
        letter-spacing: 0.12em;
        color: var(--muted);
      }
      .strip__view {
        flex: 1;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(
          90deg,
          transparent,
          #000 6%,
          #000 94%,
          transparent
        );
        mask-image: linear-gradient(
          90deg,
          transparent,
          #000 6%,
          #000 94%,
          transparent
        );
      }
      .strip__track {
        display: flex;
        width: max-content;
        animation: slide 42s linear infinite;
      }
      .strip:hover .strip__track,
      .strip:focus-within .strip__track,
      .strip.is-paused .strip__track {
        animation-play-state: paused;
      }
      /* WCAG 2.2.2: the strip moves on its own, so it can be stopped by keyboard and touch too. */
      .strip__toggle {
        flex: none;
        min-width: 3.4rem;
        min-height: 1.75rem;
        padding: 0 0.6rem;
        font-family: var(--mono);
        font-size: 0.6875rem;
        letter-spacing: 0.12em;
        color: var(--muted);
        background: none;
        border: 1px solid var(--line);
        border-radius: 999px;
        cursor: pointer;
        transition:
          color var(--dur-fast) var(--ease),
          border-color var(--dur-fast) var(--ease);
      }
      .strip__toggle:hover {
        color: var(--ink);
        border-color: var(--accent);
      }
      .strip__item {
        display: inline-flex;
        align-items: baseline;
        font-family: var(--grotesk);
        font-weight: 700;
        font-size: clamp(1rem, 1.5vw, 1.25rem);
        letter-spacing: -0.01em;
        color: var(--ink);
        white-space: nowrap;
      }
      .strip__yr {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.6875rem;
        letter-spacing: 0.02em;
        color: var(--muted);
        margin-right: 0.55rem;
      }
      .strip__item i {
        color: color-mix(in oklch, var(--accent) 55%, transparent);
        padding: 0 2rem;
        font-style: normal;
        font-weight: 400;
      }

      /* ---------------- reach out ---------------- */
      .reach {
        max-width: var(--w-poster);
        margin: 0 auto;
        padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(0.5rem, 2vw, 1rem);
        scroll-margin-top: clamp(1.5rem, 5vw, 3rem);
      }
      .reach__tag {
        font-family: var(--mono);
        font-size: 0.74rem;
        letter-spacing: 0.14em;
        color: var(--muted);
        margin: 0 0 clamp(1rem, 2.5vw, 1.6rem);
      }
      .reach__line {
        font-family: var(--grotesk);
        font-weight: 600;
        font-size: clamp(1.8rem, 4.6vw, 3.4rem);
        line-height: 1.08;
        letter-spacing: -0.03em;
        color: var(--ink);
        margin: 0;
        max-width: 18ch;
        text-wrap: balance;
      }
      .reach__line a {
        color: var(--accent);
        border-bottom: 1px solid var(--accent-line);
        transition: border-color var(--dur-fast) var(--ease);
      }
      .reach__line a span,
      .reach__alt a span {
        display: inline-block;
        font-size: 0.9em;
        margin-left: 0.1em;
        transition: transform var(--dur-fast) var(--ease);
      }
      .reach__line a:hover span,
      .reach__alt a:hover span {
        transform: translate(3px, -3px);
      }
      .reach__alt {
        margin: 1rem 0 0;
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--muted);
      }
      .reach__alt a {
        color: var(--ink);
        border-bottom: 1px solid var(--accent-line);
      }
      .reach__alt a:hover {
        border-color: var(--accent);
      }
      .reach__line a:hover {
        border-color: var(--accent);
      }

      /* ---------------- footer ---------------- */
      .t-foot {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        max-width: var(--w-poster);
        margin: clamp(2.5rem, 6vw, 4rem) auto 0;
        padding-top: 1.4rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      /* ---------------- projects ---------------- */
      .work,
      .feat {
        max-width: var(--w-poster);
        margin: 0 auto;
        padding: clamp(2.5rem, 5vw, 4rem) 0 0;
      }
      .work__tag,
      .feat__tag {
        font-family: var(--mono);
        font-size: 0.74rem;
        letter-spacing: 0.14em;
        color: var(--muted);
        margin: 0 0 clamp(0.9rem, 2vw, 1.3rem);
      }
      .work__list {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(0.7rem, 1.4vw, 1rem);
      }
      /* Five tiles: 1, 2 or 3 columns; the first spans two. */
      @media (min-width: 640px) {
        .work__list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (min-width: 1100px) {
        .work__list {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
      @media (min-width: 640px) {
        .tile--wide {
          grid-column: span 2;
        }
      }
      .work__list li {
        display: grid;
      }
      /* Flat neutral tile: a header that links out, then the live part. At rest
         the only colour is the small accent dot; hover turns the border and
         arrow accent and swaps the home path for where the project really lives. */
      .tile {
        display: grid;
        grid-template-rows: auto 1fr;
        gap: 0.9rem;
        padding: 1rem 1.1rem 1.1rem;
        background: var(--pane);
        border: 1px solid var(--line);
        border-radius: 10px;
        transition: border-color var(--dur-fast) var(--ease);
      }
      .tile:hover {
        border-color: var(--accent);
      }
      .tile__head {
        display: grid;
        gap: 0.3rem;
      }
      .tile:hover .proj__go {
        color: var(--accent);
        transform: translate(3px, -3px);
      }
      .tile__path {
        position: relative;
      }
      .tile__home,
      .tile__repo {
        transition: opacity var(--dur-fast) var(--ease);
      }
      .tile__repo {
        position: absolute;
        left: 1rem;
        max-width: calc(100% - 2.6rem);
        opacity: 0;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .tile:hover .tile__home {
        opacity: 0;
      }
      .tile:hover .tile__repo {
        opacity: 1;
      }
      .tile__live {
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .tile__live > :last-child {
        flex: 1;
      }
      /* The live parts boot in once, a beat apart, when the section arrives. */
      .work__list.is-armed .tile__live {
        opacity: 0;
        transform: translateY(8px);
        transition:
          opacity 0.5s ease-out calc(var(--i) * 90ms + 120ms),
          transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 90ms + 120ms);
      }
      .work__list.is-armed .stack li {
        opacity: 0;
        transform: translateX(-4px);
        transition:
          opacity 0.35s ease-out calc(var(--i) * 90ms + 320ms + var(--r) * 70ms),
          transform 0.35s ease-out calc(var(--i) * 90ms + 320ms + var(--r) * 70ms);
      }
      .work__list.is-armed .pipe li {
        opacity: 0;
        transition: opacity 0.35s ease-out calc(var(--i) * 90ms + 320ms + var(--r, 0) * 160ms);
      }
      .work__list.is-armed .pipe li:nth-child(2) {
        --r: 1;
      }
      .work__list.is-armed .pipe li:nth-child(3) {
        --r: 2;
      }
      .work__list.is-armed.is-live .tile__live,
      .work__list.is-armed.is-live .stack li,
      .work__list.is-armed.is-live .pipe li {
        opacity: 1;
        transform: none;
      }
      /* home-lab: the stacks, as a compose listing */
      .stack__cmd {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--muted);
        margin-bottom: 0.4rem;
      }
      .stack {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        font-family: var(--mono);
        font-size: 0.7rem;
      }
      .stack li {
        display: grid;
        grid-template-columns: 7.2rem 1fr;
        gap: 0.6rem;
        align-items: baseline;
      }
      .stack b {
        color: var(--ink);
        font-weight: 500;
      }
      .stack span {
        color: var(--faint);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      /* anki: one real card; hover or tap flips it, flipping back deals the next */
      .card {
        display: block;
        width: 100%;
        min-height: 9.5rem;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
        perspective: 900px;
        text-align: center;
        font: inherit;
        color: inherit;
      }
      .card__inner {
        position: relative;
        display: block;
        height: 100%;
        min-height: 9.5rem;
        transform-style: preserve-3d;
        transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .card:hover .card__inner,
      .card:focus-visible .card__inner,
      .card.is-flipped .card__inner {
        transform: rotateY(180deg);
      }
      .card__face {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        gap: 0.3rem;
        border: 1px solid var(--line);
        border-radius: 7px;
        background: var(--panel);
        backface-visibility: hidden;
      }
      .card:hover .card__face {
        border-color: color-mix(in oklch, var(--accent) 50%, var(--line));
      }
      .card__back {
        transform: rotateY(180deg);
      }
      .card__hanzi {
        font-family: var(--cjk);
        font-size: 3.4rem;
        line-height: 1;
        color: var(--ink);
      }
      .card__hint {
        font-family: var(--mono);
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        color: var(--faint);
      }
      .card__back .card__hint {
        margin-top: 0.3rem;
      }
      .card__py {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--accent);
      }
      .card__jp {
        font-family: var(--mono);
        font-size: 0.6875rem;
        color: var(--faint);
      }
      .card__mean {
        color: var(--muted);
        font-size: 0.9rem;
        padding: 0 0.8rem;
      }
      /* this site: commit → build → live, in the site's node style */
      .site {
        display: grid;
        align-content: start;
        gap: 0.2rem;
      }
      .site__none {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--faint);
      }
      .pipe {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        position: relative;
        margin: 0.3rem 0 0.9rem;
        font-family: var(--mono);
        font-size: 0.6875rem;
      }
      .pipe::before {
        content: "";
        position: absolute;
        left: 0.3rem;
        right: 0.3rem;
        top: 0.3rem;
        height: 1px;
        background: var(--line);
      }
      .pipe li {
        position: relative;
        display: grid;
        gap: 0.25rem;
        padding-top: 0.9rem;
        min-width: 0;
      }
      .pipe li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--pane);
        border: 2px solid var(--faint);
        box-sizing: content-box;
        transform: translate(-1px, -2px);
      }
      .pipe li.is-done::before {
        background: var(--faint);
      }
      .pipe li.is-now::before {
        border-color: var(--accent);
        background: var(--accent);
        box-shadow: var(--ring);
      }
      .pipe b {
        color: var(--faint);
        font-weight: 500;
        letter-spacing: 0.04em;
      }
      .pipe span,
      .pipe a {
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .pipe a {
        color: var(--accent);
      }
      .pipe li.is-now span {
        font-weight: 600;
      }
      .site__msg {
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--muted);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .proj__path {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.6875rem;
        letter-spacing: 0.04em;
        color: var(--faint);
        margin-bottom: 0.4rem;
      }
      .proj__path i {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--accent);
      }
      .proj__go {
        margin-left: auto;
        font-size: 0.95rem;
        color: var(--faint);
        transition:
          transform var(--dur-fast) var(--ease),
          color var(--dur-fast) var(--ease);
      }
      .proj__name {
        font-weight: 700;
        font-size: clamp(1.3rem, 2vw, 1.7rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--ink);
        overflow-wrap: anywhere;
      }
      .proj__desc {
        color: var(--muted);
      }
      /* ---------------- writing (lead panel + rows) ---------------- */
      /* The lead post's result, outlined behind its text. */
      .lead__fig {
        position: absolute;
        right: -0.04em;
        bottom: -0.2em;
        font-family: var(--grotesk);
        font-weight: 800;
        font-size: clamp(4.5rem, 7.5vw, 7rem);
        line-height: 1;
        letter-spacing: -0.04em;
        white-space: nowrap;
        color: transparent;
        -webkit-text-stroke: 1.5px color-mix(in oklch, var(--ink) 16%, transparent);
        font-variant-numeric: tabular-nums;
        pointer-events: none;
      }
      .lead > :not(.lead__fig) {
        position: relative;
      }
      .feat__grid {
        display: grid;
        gap: clamp(1rem, 2.5vw, 2rem) clamp(1.6rem, 4vw, 3.5rem);
        align-items: start;
      }
      @media (min-width: 900px) {
        .feat__grid {
          grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        }
      }
      /* The stat chip: the post's headline number as a mono readout. */
      .chip {
        flex: none;
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        color: var(--accent-soft);
        background: color-mix(in oklch, var(--accent) 10%, transparent);
        border: 1px solid color-mix(in oklch, var(--accent) 22%, transparent);
        border-radius: 999px;
        padding: 0.18rem 0.7rem;
      }
      .feat__go {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent-soft);
      }
      .feat__go span {
        display: inline-block;
        transition: transform var(--dur-fast) var(--ease);
      }
      a:hover > .feat__go span,
      a:hover .lead__foot .feat__go span {
        transform: translateX(4px);
      }

      .lead {
        position: relative;
        overflow: hidden;
        display: grid;
        gap: 0.8rem;
        padding: clamp(1.2rem, 2.6vw, 2rem);
        background: var(--pane);
        border: 1px solid var(--line);
        border-radius: 14px;
        transition:
          transform var(--dur-fast) var(--ease),
          border-color var(--dur-fast) var(--ease);
      }
      .lead:hover {
        transform: translateY(-3px);
        border-color: var(--accent);
      }
      .lead__meta,
      .row__date {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
      }
      .lead__meta {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }
      .lead__new {
        color: var(--accent-ink);
        background: var(--accent);
        border-radius: 4px;
        padding: 0.1rem 0.45rem;
      }
      .lead__title {
        font-weight: 600;
        font-size: clamp(1.6rem, 3.2vw, 2.5rem);
        line-height: 1.08;
        letter-spacing: -0.025em;
        color: var(--ink);
        text-wrap: balance;
        margin-top: clamp(0.6rem, 2vw, 1.6rem);
      }
      .lead__desc {
        color: var(--muted);
        font-size: clamp(1rem, 1.3vw, 1.1rem);
        max-width: 46ch;
        text-wrap: pretty;
      }
      .lead__foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.4rem;
      }

      .rows {
        display: grid;
        border-top: 1px solid var(--line);
      }
      .row {
        display: grid;
        grid-template-columns: 5.2rem minmax(0, 1fr) auto;
        gap: 0.3rem 1rem;
        align-items: baseline;
        padding: 1.05rem 0.6rem;
        border-bottom: 1px solid var(--line);
        transition: background-color var(--dur-fast) var(--ease);
      }
      .row:hover {
        background: color-mix(in oklch, var(--accent) 7%, transparent);
      }
      .row__body {
        display: grid;
        gap: 0.2rem;
      }
      .row__title {
        font-weight: 600;
        font-size: clamp(1.05rem, 1.5vw, 1.2rem);
        line-height: 1.25;
        letter-spacing: -0.01em;
        color: var(--ink);
      }
      .row__desc {
        color: var(--muted);
        font-size: 0.95rem;
      }
      .row--all .row__title {
        color: var(--accent-soft);
      }
      @media (max-width: 560px) {
        .row {
          grid-template-columns: minmax(0, 1fr) auto;
        }
        .row__date {
          grid-column: 1 / -1;
        }
        .row__date:empty {
          display: none;
        }
      }

      /* ---------------- scroll reveal ---------------- */
      [data-reveal].is-armed {
        opacity: 0;
        transform: translateY(16px);
      }
      [data-reveal].is-in {
        opacity: 1;
        transform: none;
        transition:
          opacity 0.6s var(--ease-out),
          transform 0.6s var(--ease-out);
      }

      /* ---------------- motion ---------------- */
      @keyframes slide {
        to {
          transform: translateX(-33.3333%);
        }
      }

      /* ---------------- responsive ---------------- */
      @media (max-width: 900px) {
        .term__panes {
          grid-template-columns: 1fr;
          grid-template-areas: "who" "hl" "writing";
        }
      }
      @media (max-width: 560px) {
        .t-nav__links {
          display: none;
        }
        /* reserve 2 lines so a wrapped subtitle doesn't shift the page */
        .kin__rot {
          min-height: 4.5em;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .t *,
        .t *::before,
        .t *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        .strip__view {
          overflow: visible;
          -webkit-mask-image: none;
          mask-image: none;
        }
        .strip__track {
          flex-wrap: wrap;
          width: auto;
          gap: 0.2rem 0;
        }
      }
    </style>
  </body>
</html>
