---
// The homepage, on the shared shell at its wider poster width. Each section
// is a component in src/components/home/; its data is in src/data/.

import Hero from "../components/home/Hero.astro";
import Reach from "../components/home/Reach.astro";
import Window from "../components/home/Window.astro";
import WorkedAt from "../components/home/WorkedAt.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Colin Cheung · Senior Software Engineer"
  description="Colin Cheung, Senior Software Engineer in Glasgow. Tech lead at EDF Energy, leading AI adoption. I make systems boring on purpose."
  ogDescription="Senior Software Engineer in Glasgow. Tech lead at EDF Energy, leading AI adoption."
  home
>
  <Hero />
  <Window />
  <WorkedAt />
  <Reach />
</Base>

<style is:global>
  html {
    -webkit-text-size-adjust: 100%;
  }
  /* The homepage sets its own spacing: no default margins on headings,
     paragraphs, lists and figures, and lists without bullets or numbers. */
  :where(.shell--home) :where(h1, h2, p, ul, ol, dl, dd, figure) {
    margin: 0;
  }
  :where(.shell--home) :where(ul, ol) {
    padding: 0;
    list-style: none;
  }
  /* Read aloud, not shown: what a drawing or a bare number leaves unsaid. */
  .shell--home .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  /* Sections below the window rise in as they scroll into view. */
  [data-reveal].is-armed {
    opacity: 0;
    transform: translateY(12px);
  }
  [data-reveal].is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }
</style>

<script>
  import { onceSeen, still } from "../motion/in-view";

  // Armed by JS only, so without it (or with reduced motion) the sections are
  // simply visible.
  const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (!still) {
    for (const el of reveals) el.classList.add("is-armed");
    onceSeen(reveals, (el) => el.classList.add("is-in"), { threshold: 0.15 });
  }
</script>
