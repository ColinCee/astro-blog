<script>
  // The square-a-day sample: 60 days, the last 9 lit.
  const days = document.querySelector<HTMLElement>("[data-days]");
  if (days)
    days.innerHTML = Array.from(
      { length: 60 },
      (_, i) =>
        `<i style="aspect-ratio:1;border-radius:1px;background:var(${i < 9 ? "--accent-solid" : "--n6"})"></i>`,
    ).join("");
  // Swatches drawn from the tokens, so this page can never disagree with them.
  const labels: Record<string, string> = {
    "accent-wash": "wash · tint",
    "accent-solid": "solid · filled marks",
    accent: "accent · bars, big results",
    "accent-text": "text · links, small results",
  };
  const fill = (k: string, keys: string[]) => {
    const el = document.querySelector<HTMLElement>(`[data-sw="${k}"]`);
    if (el)
      el.innerHTML = keys
        .map(
          (n) =>
            `<div style="background:var(--${n})"><span>${labels[n] ?? n.replace(/^n(\d)/, "$1")}</span></div>`,
        )
        .join("");
  };
  const steps = (p: string) =>
    Array.from({ length: 12 }, (_, i) => p + (i + 1));
  fill("n", steps("n"));
  fill("a", ["accent-wash", "accent-solid", "accent", "accent-text"]);
  fill(
    "s",
    ["ok", "warn", "danger"].flatMap((h) => [h + 3, h + 9, h + 11]),
  );
</script>
