---
// CV — terminal-native résumé for colincheung.dev.
// Same dark shell, cyan accent, Bricolage + JetBrains Mono as the rest of the
// site (see src/styles/terminal.css and DESIGN.md). Content lives here as typed
// data so the markup can highlight the metric in every line — the number is the
// accent, the prose stays muted. Prints clean to ink-on-white via @media print.
import Base from "../layouts/Base.astro";

const name = "Colin Cheung";
const role = "Senior Software Engineer · 9+ years · Glasgow, UK · remote";
const lede =
  "Senior Software Engineer with 9+ years building backend, platform and full-stack systems, currently focused on AWS serverless workflow automation and AI-assisted developer workflows in the energy sector. Strongest in TypeScript/Node.js, event-driven architecture, CI/CD and engineering productivity, with a track record of owning business-critical systems, raising coding standards and shortening delivery feedback loops.";

const contact = [
  { label: "colincheung25@gmail.com", href: "mailto:colincheung25@gmail.com" },
  {
    label: "linkedin.com/in/colin-cheung",
    href: "https://www.linkedin.com/in/colin-cheung/",
  },
  { label: "github.com/ColinCee", href: "https://github.com/ColinCee" },
];

type Point = { pre: string; hl?: string; post?: string };
type Ym = { mon: string; yr: string };
type Role = {
  co: string;
  pos: string;
  from: Ym;
  to?: Ym;
  current?: boolean;
  ctx: string;
  points: Point[];
  stack: string[];
};

const experience: Role[] = [
  {
    co: "EDF Energy",
    pos: "Senior Software Engineer · Contract",
    from: { mon: "Apr", yr: "2023" },
    current: true,
    ctx: "Tech lead for the Retail/Debt team, driving architecture and delivery.",
    points: [
      {
        pre: "Design and deliver services on a ",
        hl: "national-scale debt-collection platform serving millions of customer accounts",
        post: ".",
      },
      {
        pre: "Initiated and led a major architectural simplification to an event-sourced shared-state model, replacing mutable duplicated state with a full audit trail, cutting distributed-monolith complexity and accelerating new-service delivery.",
      },
      {
        pre: "Closed a critical operational-visibility gap by driving OBD business metrics and log ingestion into Dynatrace, unlocking dashboards for operational health and failure patterns.",
      },
      {
        pre: "Led migration of a large monorepo from AWS CodePipeline to GitHub Actions with Turborepo, ",
        hl: "cutting build + test cycles from 30 → 5 minutes",
        post: ".",
      },
      {
        pre: "Raised team coding standards through TypeScript migration patterns and Zod runtime validation, plus review, documentation and reusable examples for safer delivery.",
      },
      {
        pre: "Drove Copilot and AI-assisted development adoption via reusable skills, repo instructions and demos, ",
        hl: "delivering a comparable project with 3 developers in 1 month vs 6 over 2 months",
        post: ".",
      },
    ],
    stack: [
      "TypeScript",
      "Node.js",
      "AWS",
      "Event Sourcing",
      "EventBridge",
      "Dynatrace",
      "Zod",
      "GitHub Actions",
    ],
  },
  {
    co: "BBC",
    pos: "Senior Software Engineer · Contract",
    from: { mon: "Nov", yr: "2022" },
    to: { mon: "Apr", yr: "2023" },
    ctx: "Lifted developer productivity by improving internal engineering tooling.",
    points: [
      {
        pre: "Built a serverless data pipeline with AWS CDK to track build-failure statistics, enabling data-driven CI/CD optimization.",
      },
      {
        pre: "Automated PR comments with code-coverage reports, ",
        hl: "cutting CI-log debugging time by up to 90%",
        post: ".",
      },
    ],
    stack: ["Node.js", "React", "AWS CDK", "DynamoDB", "CI/CD"],
  },
  {
    co: "Hopper",
    pos: "Software Engineer",
    from: { mon: "Mar", yr: "2022" },
    to: { mon: "Oct", yr: "2022" },
    ctx: "Scaled customer-service platforms through hyper-growth.",
    points: [
      {
        pre: "Launched cross-vertical VIP support features, ",
        hl: "lifting service visibility >200% and driving a 50% revenue uplift",
        post: ".",
      },
      {
        pre: "Built and maintained Scala backend microservices serving ",
        hl: "100k+ daily requests",
        post: " over gRPC.",
      },
      {
        pre: "Implemented multi-tenancy with gRPC and GCP Pub/Sub for scalable async messaging.",
      },
      {
        pre: "Established SLOs, monitoring and alerting in Datadog via Terraform (IaC) for high availability.",
      },
    ],
    stack: [
      "Scala",
      "Kubernetes",
      "GCP Pub/Sub",
      "gRPC",
      "React",
      "Terraform",
      "Datadog",
    ],
  },
  {
    co: "Hometree",
    pos: "Senior Software Engineer",
    from: { mon: "Jun", yr: "2021" },
    to: { mon: "Mar", yr: "2022" },
    ctx: "Led full-stack initiatives and mentored engineers in a fast-paced startup.",
    points: [
      {
        pre: "",
        hl: "Led the greenfield rebuild of a business-critical legacy checkout",
        post: " in React (Hooks) + TypeScript, improving UX, performance and maintainability.",
      },
      {
        pre: "Embedded modern practices: E2E testing (Cypress), IaC via Serverless Stack, CloudWatch alarms and Buildkite CI/CD.",
      },
      {
        pre: "Migrated to AWS RDS Proxy and MikroORM, hardening database security and transaction management.",
      },
    ],
    stack: [
      "React",
      "Node.js",
      "TypeScript",
      "AWS",
      "Cypress",
      "Buildkite",
      "MikroORM",
    ],
  },
  {
    co: "Skyscanner",
    pos: "Software Engineer",
    from: { mon: "Feb", yr: "2020" },
    to: { mon: "Apr", yr: "2021" },
    ctx: "Built HR automation tooling over sensitive employee data.",
    points: [
      {
        pre: "Engineered HRMS → Active Directory sync (Lambda, SQS), ",
        hl: "cutting update times from 8 hours → 2 minutes",
        post: ".",
      },
      {
        pre: "Built an AWS serverless Slack chatbot for structured HR feedback.",
      },
    ],
    stack: ["Python", "React", "Docker", "AWS"],
  },
  {
    co: "PodFather",
    pos: "Software Engineer",
    from: { mon: "Jul", yr: "2017" },
    to: { mon: "Feb", yr: "2020" },
    ctx: "Full-stack development for a mobile ePOD app with 10k+ daily drivers.",
    points: [
      {
        pre: "Optimized Android image capture, ",
        hl: "improving processing speed 300%",
        post: ".",
      },
      {
        pre: "Migrated ",
        hl: "terabytes of image data",
        post: " from MySQL BLOBs to AWS S3.",
      },
    ],
    stack: [
      "PHP",
      "Android · Kotlin",
      "MySQL",
      "TypeScript",
      "Node.js",
      "AWS S3",
    ],
  },
];

const skills: { label: string; items: string[] }[] = [
  { label: "Core stack", items: ["TypeScript", "Node.js", "Python", "React"] },
  {
    label: "Cloud & platform",
    items: ["Lambda", "API Gateway", "EventBridge", "DynamoDB", "Docker"],
  },
  { label: "Systems", items: ["Event-driven", "Distributed systems", "APIs"] },
  {
    label: "DevOps",
    items: ["CI/CD", "GitHub Actions", "Observability", "Terraform"],
  },
];

const education = {
  school: "University of Strathclyde",
  meta: "Glasgow, UK · 2013 - 2018",
  degree: "BEng (Hons) Computer & Electronic Systems",
  honours: "1st Class Honours",
  note: 'Dissertation: "Investigating learning-type algorithms for video games" (AI and machine learning).',
};

const projects = [
  {
    name: "Self-Hosted Platform & AI Automation",
    desc: "Docker Compose homelab with GitHub Actions deploys and Grafana/Prometheus/Loki observability. Runs AI delivery workflows (Copilot CLI + FastAPI workers) and pgvector semantic search over my notes with incremental Markdown/PDF ingestion.",
    stack: "Docker · GitHub Actions · pgvector · FastAPI · Grafana",
  },
  {
    name: "Electron Chess App",
    desc: "Cross-platform desktop app with a live side-by-side move-analysis overlay for online chess, powered by the Leela Chess Zero (Lc0) engine over UCI.",
    stack: "Electron · React · Lc0",
  },
  {
    name: "TypeScript Discord Bot",
    desc: "Feature-rich Discord bot (discord.js) with real-time, chat-triggered voice-clip playback, self-hosted on a Raspberry Pi.",
    stack: "TypeScript · Node.js · Raspberry Pi",
  },
];
---

<Base
  title="CV · Colin Cheung"
  description="Colin Cheung, Senior Software Engineer with 9+ years across TypeScript, Node.js, React and AWS. Experience, skills, education and projects."
>
  <article class="cv">
    <header class="cv__head">
      <p class="cv__kicker">// curriculum vitae</p>
      <h1 class="cv__name">{name}</h1>
      <p class="cv__role">{role}</p>
      <p class="cv__lede">{lede}</p>
      <div class="cv__actions">
        <nav class="cv__contact" aria-label="Contact">
          {contact.map((c) => <a href={c.href}>{c.label}</a>)}
        </nav>
      </div>
    </header>

    <section class="cv__sec" aria-labelledby="xp-h">
      <h2 class="cv__sec-head" id="xp-h">// experience</h2>
      <ol class="xp__list">
        {
          experience.map((r) => (
            <li class:list={["xp__item", { "role--current": r.current }]}>
              <article class="role">
                <span class="role__node" aria-hidden="true" />
                <div class="role__when">
                  <span class="role__date role__date--end">
                    {r.current ? (
                      <b class="role__now">now</b>
                    ) : (
                      r.to && (
                        <>
                          <span class="role__mon">{r.to.mon}</span>
                          <span class="role__yr">{r.to.yr}</span>
                        </>
                      )
                    )}
                  </span>
                  <span class="role__link" aria-hidden="true" />
                  <span class="role__date role__date--start">
                    <span class="role__mon">{r.from.mon}</span>
                    <span class="role__yr">{r.from.yr}</span>
                  </span>
                </div>
                <div class="role__body">
                  <h3 class="role__co">{r.co}</h3>
                  <p class="role__pos">{r.pos}</p>
                  <p class="role__ctx">{r.ctx}</p>
                  <ul class="role__points">
                    {r.points.map((p) => (
                      <li class="role__point">
                        {p.pre}
                        {p.hl && <b class="hl">{p.hl}</b>}
                        {p.post}
                      </li>
                    ))}
                  </ul>
                  <p class="role__stack">{r.stack.join("  ·  ")}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv__sec" aria-labelledby="sk-h">
      <h2 class="cv__sec-head" id="sk-h">// skills</h2>
      <div class="skills">
        {
          skills.map((g) => (
            <div class="skill">
              <span class="skill__label">{g.label}</span>
              <ul class="skill__items">
                {g.items.map((it) => (
                  <li class="tag">{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <div class="cv__lower">
      <section class="cv__sec" aria-labelledby="ed-h">
        <h2 class="cv__sec-head" id="ed-h">// education</h2>
        <div class="edu">
          <h3 class="edu__school">{education.school}</h3>
          <p class="edu__meta">{education.meta}</p>
          <p class="edu__degree">
            {education.degree}
            <b class="hl">{education.honours}</b>
          </p>
          <p class="edu__note">{education.note}</p>
        </div>
      </section>

      <section class="cv__sec" aria-labelledby="pr-h">
        <h2 class="cv__sec-head" id="pr-h">// projects</h2>
        <ul class="proj">
          {
            projects.map((p) => (
              <li class="proj__item">
                <h3 class="proj__name">{p.name}</h3>
                <p class="proj__desc">{p.desc}</p>
                <p class="proj__stack">{p.stack}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <p class="cv__end">
      <span>Open to remote roles · Glasgow, UK</span>
      <a href="https://www.linkedin.com/in/colin-cheung/"
        >Let's talk <span aria-hidden="true">↗</span></a
      >
    </p>
  </article>
</Base>

<style>
  .cv {
    max-width: var(--w-page);
    margin: 0 auto;
  }

  /* ---------------- masthead ---------------- */
  .cv__head {
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }
  .cv__kicker {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-soft);
  }
  .cv__name {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 800;
    font-size: clamp(2.4rem, 8vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .cv__role {
    margin: 0.9rem 0 0;
    font-family: var(--mono);
    font-size: clamp(0.8rem, 1.4vw, 0.9rem);
    letter-spacing: 0.03em;
    color: var(--muted);
  }
  .cv__lede {
    margin: 1.6rem 0 0;
    max-width: 74ch;
    font-family: var(--grotesk);
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .cv__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin: 2rem 0 0;
  }
  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.01em;
  }
  .cv__contact a {
    padding-bottom: 2px;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .cv__contact a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* ---------------- section scaffold ---------------- */
  .cv__sec {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .cv__sec-head {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--accent-soft);
  }

  /* ---------------- experience timeline ---------------- */
  .xp__list {
    --rail: 5.75rem;
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xp__list::before {
    content: "";
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: var(--rail);
    width: 1px;
    background: var(--line);
  }
  .role {
    --pad: clamp(1.4rem, 3vw, 2.1rem);
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    padding: var(--pad) 0;
  }
  .xp__item:first-child .role {
    padding-top: 0.2rem;
  }
  .role__node {
    position: absolute;
    left: var(--rail);
    top: calc(var(--pad) + 0.5rem);
    width: 9px;
    height: 9px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--faint);
    z-index: 1;
  }
  .xp__item:first-child .role__node {
    top: 0.7rem;
  }
  .role--current .role__node {
    border-color: var(--accent);
    box-shadow: var(--ring);
  }
  .role__when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    padding-top: 0.02rem;
    padding-right: 0.95rem;
    font-variant-numeric: tabular-nums;
  }
  .role__date {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .role__mon {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .role__yr {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent-soft);
  }
  .role__now {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
  }
  .role__date--start .role__yr {
    font-size: 0.62rem;
    font-weight: 400;
    color: var(--muted);
  }
  .role__link {
    display: none;
    width: 1px;
    height: 0.6rem;
    margin: 0.05rem 0;
    background: var(--line);
  }
  .role__body {
    min-width: 0;
  }
  .role__co {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .role__pos {
    margin: 0.25rem 0 0;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .role__ctx {
    margin: 0.75rem 0 0;
    max-width: 72ch;
    font-family: var(--grotesk);
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .role__points {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  .role__point {
    position: relative;
    padding-left: 1.15rem;
    max-width: 74ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }
  .role__point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: color-mix(in oklch, var(--accent) 65%, transparent);
  }
  .hl {
    color: var(--accent-soft);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .role__stack {
    margin: 0.95rem 0 0;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }

  /* ---------------- skills ---------------- */
  .skills {
    display: grid;
    gap: 0;
  }
  .skill {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding: clamp(0.7rem, 1.6vw, 0.95rem) 0;
    border-top: 1px solid var(--line);
  }
  .skill:last-child {
    border-bottom: 1px solid var(--line);
  }
  .skill__label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--accent-soft);
  }
  .skill__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    padding: 0.18rem 0.62rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* ---------------- lower: education + projects ---------------- */
  .cv__lower {
    display: grid;
    gap: clamp(0.5rem, 2vw, 1rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (min-width: 900px) {
    .cv__lower {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .edu__school {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .edu__meta {
    margin: 0.35rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .edu__degree {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin: 1rem 0 0;
    font-family: var(--grotesk);
    font-weight: 500;
    font-size: 1rem;
    color: var(--ink);
  }
  .edu__note {
    margin: 0.75rem 0 0;
    max-width: 48ch;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .proj {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(1.3rem, 2.5vw, 1.8rem);
  }
  .proj__name {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .proj__desc {
    margin: 0.35rem 0 0;
    max-width: 54ch;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .proj__stack {
    margin: 0.45rem 0 0;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }

  /* ---------------- end cap ---------------- */
  .cv__end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }
  .cv__end a {
    color: var(--accent-soft);
    border-bottom: 1px solid var(--accent-line);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .cv__end a:hover {
    border-color: var(--accent);
  }

  /* ---------------- responsive ---------------- */
  @media (max-width: 640px) {
    .xp__list::before {
      left: 4px;
    }
    .role {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding-left: 1.4rem;
    }
    .role__node,
    .xp__item:first-child .role__node {
      left: 4px;
      top: 0.5rem;
    }
    .role__when {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      padding-right: 0;
    }
    .role__date--start {
      order: 0;
    }
    .role__link {
      order: 1;
      display: block;
      height: 0.75rem;
    }
    .role__date--end {
      order: 2;
    }
