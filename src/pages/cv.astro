    color: var(--muted);
    text-wrap: pretty;
  }
  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: 1.2rem 0 0;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.01em;
  }
  .cv__contact a {
    padding-bottom: 2px;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .cv__contact a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* ---------------- section scaffold ---------------- */
  .cv__sec {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .cv__sec--ledger {
    margin-top: 0;
  }
  .cv__sec-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.9rem;
  }
  .cv__sec-head {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .cv__sec-bar .cv__sec-head {
    margin: 0;
  }
  .cv__toggle {
    margin: 0;
    padding: 0.1rem 0;
    border: 0;
    border-bottom: 1px solid var(--accent-line);
    background: none;
    font: inherit;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .cv__toggle:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* ---------------- the ledger ----------------
     One row per role. Closed, the row is the evidence: dates, company, title
     and the headline result. Open, it unfolds the detail in place. */
  .ledger {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .row {
    --col-when: 8.5rem;
    border-bottom: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }
  .row__sum {
    position: relative;
    display: grid;
    grid-template-columns: var(--col-when) minmax(0, 1fr) auto 1rem;
    align-items: center;
    gap: 0 1.25rem;
    padding: 0.95rem 0.5rem 0.95rem 1.5rem;
    margin: 0 -0.5rem;
    border-radius: var(--r-row, 7px);
    list-style: none;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .row__sum::-webkit-details-marker {
    display: none;
  }
  @media (hover: hover) {
    .row__sum:hover {
      background: var(--panel);
    }
  }
  .row__sum:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .row__node {
    position: absolute;
    left: 0.5rem;
    top: 50%;
    width: 9px;
    height: 9px;
    translate: 0 -50%;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--faint);
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .is-current .row__node {
    border-color: var(--accent);
    box-shadow: var(--ring);
  }
  .row[open] .row__node {
    background: var(--faint);
  }
  .is-current .row[open] .row__node {
    background: var(--accent);
  }
  .row__when {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--faint);
    white-space: nowrap;
  }
  .row__dash {
    margin: 0 0.3rem;
  }
  .row__now {
    font-weight: 600;
    color: var(--accent-text);
  }
  .row__who {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.9rem;
    min-width: 0;
  }
  .row__co {
    font-family: var(--grotesk);
    font-weight: 650;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .row__pos {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .row__pill {
    padding: 0.12rem 0.55rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    border: 1px solid var(--faint);
    border-radius: 999px;
    align-self: center;
  }
  .row__result {
    font-family: var(--grotesk);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    color: var(--accent-text);
    text-align: right;
    white-space: nowrap;
  }
  .row__chev {
    color: var(--faint);
    transition: rotate 0.3s var(--ease-out);
  }
  .row[open] .row__chev {
    rotate: 180deg;
  }

  /* The one authored motion: a row unfolding. Browsers without
     ::details-content open it instantly. */
  .row::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size 0.4s var(--ease-out),
      opacity 0.3s var(--ease-out),
      content-visibility 0.4s allow-discrete;
  }
  .row[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
  .row__body {
    padding: 0.25rem 0 1.6rem calc(var(--col-when) + 2.25rem);
  }
  .row__ctx {
    margin: 0;
    max-width: 68ch;
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }
  .row__points {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .row__point {
    position: relative;
    padding-left: 1.15rem;
    max-width: 70ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }
  .row__point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--faint);
  }
  /* A metric inside a bullet: bold ink. The accent is spent on the current
     row's node, so repeating it here would bury the signal. */
  .hl {
    color: var(--ink);
    font-weight: 600;
  }
  .row__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* ---------------- skills ---------------- */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.1rem clamp(1.5rem, 4vw, 3rem);
    margin: 0;
  }
  .skill__label {
    margin: 0 0 0.2rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  .skill__items {
    margin: 0;
