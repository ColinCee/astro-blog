---

<Base
  title="CV · Colin Cheung"
  description="Colin Cheung, Senior Software Engineer and hands-on technical lead: nine years across TypeScript, Node.js and event-driven AWS serverless. Experience, skills, education and projects."
>
  <article class="cv">
    <header class="cv__head">
      <h1 class="cv__name">{name}</h1>
      <p class="cv__role">{role}</p>
      <p class="cv__lede">{lede}</p>
      <nav class="cv__contact" aria-label="Contact">
        {contact.map((c) => <a href={c.href}>{c.label}</a>)}
      </nav>
    </header>

    <section class="cv__sec cv__sec--ledger" aria-labelledby="xp-h">
      <div class="cv__sec-bar">
        <h2 class="cv__sec-head" id="xp-h">// experience</h2>
        <button
          class="cv__toggle"
          type="button"
          aria-pressed="false"
          data-cv-toggle
          hidden
        >
          open all
        </button>
      </div>
      <ol class="ledger">
        {experience.map((r) => (
          <li class:list={["ledger__item", { "is-current": r.current }]}>
            <details class="row" data-cv-row>
              <summary class="row__sum">
                <span class="row__node" aria-hidden="true" />
                <span class="row__when">
                  {r.from.mon} {r.from.yr}
                  <span class="row__dash" aria-hidden="true">
                    –
                  </span>
                  {r.current ? (
                    <b class="row__now">now</b>
                  ) : (
                    r.to && `${r.to.mon} ${r.to.yr}`
                  )}
                </span>
                <span class="row__who">
                  <span class="row__co">{r.co}</span>
                  <span class="row__pos">{r.pos}</span>
                  {r.contract && <span class="row__pill">contract</span>}
                </span>
                <span class="row__result">{r.result}</span>
                <svg
                  class="row__chev"
                  viewBox="0 0 16 16"
                  width="16"
                  height="16"
                  aria-hidden="true"
                >
                  <path
                    d="M4 6l4 4 4-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <div class="row__body">
                <p class="row__ctx">{r.ctx}</p>
                <ul class="row__points">
                  {r.points.map((p) => (
                    <li class="row__point">
                      {[p.pre, p.hl && <b class="hl">{p.hl}</b>, p.post]}
                    </li>
                  ))}
                </ul>
                <ul class="row__stack" aria-label="Stack">
                  {r.stack.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section class="cv__sec" aria-labelledby="sk-h">
      <h2 class="cv__sec-head" id="sk-h">// skills</h2>
      <dl class="skills">
        {skills.map((g) => (
          <div class="skill">
            <dt class="skill__label">{g.label}</dt>
            <dd class="skill__items">{g.items.join(" · ")}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="cv__lower">
      <section class="cv__sec" aria-labelledby="ed-h">
        <h2 class="cv__sec-head" id="ed-h">// education</h2>
        <div class="edu">
          <h3 class="edu__school">{education.school}</h3>
          <p class="edu__meta">{education.meta}</p>
          <p class="edu__degree">
            {education.degree}
            <b class="hl">{education.honours}</b>
          </p>
          <p class="edu__note">{education.note}</p>
        </div>
      </section>

      <section class="cv__sec" aria-labelledby="pr-h">
        <h2 class="cv__sec-head" id="pr-h">// projects</h2>
        <ul class="proj">
          {projects.map((p) => (
            <li class="proj__item">
              <h3 class="proj__name">
                <a href={p.href} rel="noopener">
                  {p.name}
                </a>
              </h3>
              <p class="proj__desc">{p.desc}</p>
              <p class="proj__stack">{p.stack}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <p class="cv__end">
      <span>Open to remote roles · Glasgow, UK</span>
      <a href="https://www.linkedin.com/in/colin-cheung/">
        Let's talk <span aria-hidden="true">↗</span>
      </a>
    </p>
  </article>
</Base>

<script>
  // "open all" / "close all" for the ledger, and every row open for print.
  // Without JS the rows still open one at a time, natively.
  const rows = [
    ...document.querySelectorAll<HTMLDetailsElement>("[data-cv-row]"),
  ];
  const toggle = document.querySelector<HTMLButtonElement>("[data-cv-toggle]");
  if (toggle && rows.length) {
    toggle.hidden = false;
    const sync = () => {
      const all = rows.every((r) => r.open);
      toggle.textContent = all ? "close all" : "open all";
      toggle.setAttribute("aria-pressed", String(all));
    };
    toggle.addEventListener("click", () => {
      const open = !rows.every((r) => r.open);
      rows.forEach((r) => {
        r.open = open;
      });
      sync();
    });
    rows.forEach((r) => r.addEventListener("toggle", sync));
    sync();
  }
  let wasOpen: boolean[] = [];
  addEventListener("beforeprint", () => {
    wasOpen = rows.map((r) => r.open);
    rows.forEach((r) => {
      r.open = true;
    });
  });
  addEventListener("afterprint", () => {
    rows.forEach((r, i) => {
      r.open = wasOpen[i] ?? false;
    });
  });
</script>

<style>
  .cv {
