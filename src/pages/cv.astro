---
// CV — terminal-native résumé for colincheung.dev.
// Same light shell, tomato accent, Bricolage + JetBrains Mono as the rest of the
// site (see src/styles/terminal.css and DESIGN.md). Content lives here as typed
// data so the markup can highlight the metric in every line — the number is the
// accent, the prose stays muted. Prints clean to ink-on-white via @media print.
import Base from "../layouts/Base.astro";

const name = "Colin Cheung";
const role = "Senior Software Engineer · Technical Lead · Glasgow, UK · remote";
const lede =
  "Senior engineer who leads projects end to end as a hands-on IC, from solo delivery to technical lead for 3–4 engineer sub-teams, on EDF Energy's debt platform (1.6M accounts a day). Nine years across energy, media and travel, strongest in TypeScript/Node.js and event-driven AWS serverless. Known for simplifying architecture, shortening feedback loops and making teams measurably faster with AI-assisted development.";

const contact = [
  { label: "colincheung25@gmail.com", href: "mailto:colincheung25@gmail.com" },
  {
    label: "linkedin.com/in/colin-cheung",
    href: "https://www.linkedin.com/in/colin-cheung/",
  },
  { label: "github.com/ColinCee", href: "https://github.com/ColinCee" },
];

type Point = { pre: string; hl?: string; post?: string };
type Ym = { mon: string; yr: string };
type Role = {
  co: string;
  pos: string;
  from: Ym;
  to?: Ym;
  current?: boolean;
  ctx: string;
  points: Point[];
  stack: string[];
};

const experience: Role[] = [
  {
    co: "EDF Energy",
    pos: "Senior Software Engineer · Contract",
    from: { mon: "Apr", yr: "2023" },
    current: true,
    ctx: "Hands-on technical lead on the Retail/Debt platform.",
    points: [
      {
        pre: "Senior engineer on the 8-person Retail/Debt team: technical lead for project sub-teams of three or four, and the team's lead on engineering standards and technical direction, on a platform processing ",
        hl: "1.6M accounts daily",
        post: ".",
      },
      {
        pre: "Initiated and led the move from service-owned staging tables and event handlers to an event-sourced shared-state model: ",
        hl: "every account change is now auditable",
        post: ", day-to-day operations and incident investigation are simpler, and new services build on one source of truth instead of a distributed monolith.",
      },
      {
        pre: "Migrated a large monorepo from AWS CodePipeline to GitHub Actions with Turborepo, ",
        hl: "cutting build and test cycles from 30 → 5 minutes",
        post: ".",
      },
      {
        pre: "Led AI-assisted development adoption (Copilot, reusable agent skills, repository instructions, PR review experiments). Proof point: a like-for-like workflow project shipped with ",
        hl: "3 engineers in 1 month; the previous one took 6 engineers 2 months",
        post: ".",
      },
      {
        pre: "Built operational visibility from scratch: business metrics and structured logs into Dynatrace with dashboards for health, resilience and failure patterns, plus a Bolt.js Slack bot reporting batch-job status in real time from the event stream.",
      },
      {
        pre: "Raised team standards through TypeScript migration patterns, Zod runtime validation and documented examples; automated DynamoDB backup policies, ",
        hl: "cutting storage spend",
        post: ".",
      },
    ],
    stack: [
      "TypeScript",
      "Node.js",
      "Python",
      "AWS Lambda",
      "EventBridge",
      "DynamoDB",
      "GitHub Actions",
      "Turborepo",
      "Terraform",
    ],
  },
  {
    co: "BBC",
    pos: "Senior Software Engineer · Contract",
    from: { mon: "Nov", yr: "2022" },
    to: { mon: "Apr", yr: "2023" },
    ctx: "Developer tooling for a BBC engineering team.",
    points: [
      {
        pre: "Built a serverless AWS CDK pipeline tracking build-failure statistics, giving the team data to target CI/CD improvements.",
      },
      {
        pre: "Automated pull-request coverage reporting, ",
        hl: "cutting time spent digging through CI logs by up to 90%",
        post: ".",
      },
    ],
    stack: ["Node.js", "React", "AWS CDK", "Serverless"],
  },
  {
    co: "Hopper",
    pos: "Senior Software Engineer",
    from: { mon: "Mar", yr: "2022" },
    to: { mon: "Oct", yr: "2022" },
    ctx: "Backend services for post-booking customer support.",
    points: [
      {
        pre: "Shipped cross-vertical VIP support in the post-booking journey, ",
        hl: "increasing related-service visibility by 200%",
        post: ".",
      },
      {
        pre: "Built Scala microservices handling ",
        hl: "100k+ daily requests",
        post: " with multi-tenant workflows over gRPC and Pub/Sub, plus Terraform-managed Datadog SLOs and alerts.",
      },
    ],
    stack: [
      "Scala",
      "GCP",
      "Kubernetes",
      "gRPC",
      "Pub/Sub",
      "Terraform",
      "Datadog",
    ],
  },
  {
    co: "Hometree",
    pos: "Senior Software Engineer",
    from: { mon: "Jun", yr: "2021" },
    to: { mon: "Mar", yr: "2022" },
    ctx: "Full-stack lead in a fast-moving home-services startup.",
    points: [
      {
        pre: "",
        hl: "Led the React and TypeScript redesign of a business-critical checkout flow",
        post: ", and introduced Cypress E2E testing, CloudWatch alarms, Buildkite CI/CD, RDS Proxy and MikroORM.",
      },
    ],
    stack: ["React", "TypeScript", "Node.js", "AWS", "Cypress", "Buildkite"],
  },
  {
    co: "Skyscanner",
    pos: "Software Engineer",
    from: { mon: "Feb", yr: "2020" },
    to: { mon: "Apr", yr: "2021" },
    ctx: "HR automation and internal tooling.",
    points: [
      {
        pre: "Built Lambda/SQS automation syncing HRMS data to Active Directory, ",
        hl: "cutting sync time from 8 hours → 2 minutes",
        post: "; built a serverless Slack bot for interactive employee feedback.",
      },
    ],
    stack: ["Python", "React", "AWS Lambda", "SQS", "Docker"],
  },
  {
    co: "PodFather",
    pos: "Software Engineer",
    from: { mon: "Jul", yr: "2017" },
    to: { mon: "Feb", yr: "2020" },
    ctx: "Android and backend for an electronic proof-of-delivery platform.",
    points: [
      {
        pre: "Developed Android and backend features for a platform used by ",
        hl: "10k+ drivers",
        post: "; improved image capture performance by 300% and migrated terabytes of image data from MySQL to AWS S3.",
      },
    ],
    stack: ["PHP", "Android", "MySQL", "TypeScript", "Node.js", "Docker"],
  },
];

const skills: { label: string; items: string[] }[] = [
  { label: "Languages", items: ["TypeScript", "Node.js", "Python", "Scala", "SQL"] },
  {
    label: "AWS & cloud",
    items: [
      "Lambda",
      "API Gateway",
      "EventBridge",
      "SQS",
      "DynamoDB",
      "CDK",
      "Terraform",
      "Docker",
      "Cloudflare",
    ],
  },
  {
    label: "Architecture",
    items: [
      "Event-driven",
      "Event sourcing",
      "Distributed workflows",
      "REST",
      "gRPC",
      "Zod",
    ],
  },
  {
    label: "Delivery & ops",
    items: [
      "GitHub Actions",
      "Turborepo",
      "CI/CD",
      "Dynatrace",
      "Datadog",
      "Grafana",
      "Prometheus",
      "Loki",
    ],
  },
  {
    label: "AI-assisted engineering",
    items: [
      "GitHub Copilot",
      "Claude Code",
      "Agent skills",
      "Repository instructions",
      "Gemini API",
    ],
  },
  {
    label: "Frontend & testing",
    items: ["React", "Astro", "Vite", "Tailwind", "Playwright", "Cypress", "Vitest"],
  },
];

const education = {
  school: "University of Strathclyde",
  meta: "Glasgow, UK · 2013 - 2018",
  degree: "BEng Computer & Electronic Systems",
  honours: "1st Class Honours",
  note: "Dissertation on reinforcement learning for video games: DQN, Double DQN, prioritised experience replay and dueling networks in GVGAI.",
};

const projects = [
  {
    name: "anki-chinese",
    href: "https://github.com/ColinCee/anki-chinese",
    desc: "Python CLI and terminal UI (~20k lines, 55 test files) that builds Anki decks from canonical character data: pinyin and jyutping generation, Gemini-generated example sentences, pluggable TTS providers with rate limiting and retries, and preview-first live card activation over AnkiConnect. Built for my own Mandarin study.",
    stack: "Python · Typer · Textual · Gemini · AnkiConnect",
  },
  {
    name: "colincheung.dev",
    href: "https://github.com/ColinCee/astro-blog",
    desc: "This site: Astro on Cloudflare Workers with GitHub Actions deploys. Writing on real problems, including shrinking a 4.5 GB JSONL dataset to 221 MB with Parquet and cutting ts-jest test times.",
    stack: "Astro · Cloudflare Workers · GitHub Actions",
  },
];
---

<Base
  title="CV · Colin Cheung"
  description="Colin Cheung, Senior Software Engineer and hands-on technical lead: nine years across TypeScript, Node.js and event-driven AWS serverless. Experience, skills, education and projects."
>
  <article class="cv">
    <header class="cv__head">
      <p class="cv__kicker">// curriculum vitae</p>
      <h1 class="cv__name">{name}</h1>
      <p class="cv__role">{role}</p>
      <p class="cv__lede">{lede}</p>
      <div class="cv__actions">
        <nav class="cv__contact" aria-label="Contact">
          {contact.map((c) => <a href={c.href}>{c.label}</a>)}
        </nav>
      </div>
    </header>

    <section class="cv__sec" aria-labelledby="xp-h">
      <h2 class="cv__sec-head" id="xp-h">// experience</h2>
      <ol class="xp__list">
        {
          experience.map((r) => (
            <li class:list={["xp__item", { "role--current": r.current }]}>
              <article class="role">
                <span class="role__node" aria-hidden="true" />
                <div class="role__when">
                  <span class="role__date role__date--end">
                    {r.current ? (
                      <b class="role__now">now</b>
                    ) : (
                      r.to && (
                        <>
                          <span class="role__mon">{r.to.mon}</span>
                          <span class="role__yr">{r.to.yr}</span>
                        </>
                      )
                    )}
                  </span>
                  <span class="role__link" aria-hidden="true" />
                  <span class="role__date role__date--start">
                    <span class="role__mon">{r.from.mon}</span>
                    <span class="role__yr">{r.from.yr}</span>
                  </span>
                </div>
                <div class="role__body">
                  <h3 class="role__co">{r.co}</h3>
                  <p class="role__pos">{r.pos}</p>
                  <p class="role__ctx">{r.ctx}</p>
                  <ul class="role__points">
                    {r.points.map((p) => (
                      <li class="role__point">
                        {p.pre}
                        {p.hl && <b class="hl">{p.hl}</b>}
                        {p.post}
                      </li>
                    ))}
                  </ul>
                  <p class="role__stack">{r.stack.join("  ·  ")}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv__sec" aria-labelledby="sk-h">
      <h2 class="cv__sec-head" id="sk-h">// skills</h2>
      <div class="skills">
        {
          skills.map((g) => (
            <div class="skill">
              <span class="skill__label">{g.label}</span>
              <ul class="skill__items">
                {g.items.map((it) => (
                  <li class="tag">{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <div class="cv__lower">
      <section class="cv__sec" aria-labelledby="ed-h">
        <h2 class="cv__sec-head" id="ed-h">// education</h2>
        <div class="edu">
          <h3 class="edu__school">{education.school}</h3>
          <p class="edu__meta">{education.meta}</p>
          <p class="edu__degree">
            {education.degree}
            <b class="hl">{education.honours}</b>
          </p>
          <p class="edu__note">{education.note}</p>
        </div>
      </section>

      <section class="cv__sec" aria-labelledby="pr-h">
        <h2 class="cv__sec-head" id="pr-h">// projects</h2>
        <ul class="proj">
          {
            projects.map((p) => (
              <li class="proj__item">
                <h3 class="proj__name">
                  <a href={p.href} rel="noopener">{p.name}</a>
                </h3>
                <p class="proj__desc">{p.desc}</p>
                <p class="proj__stack">{p.stack}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <p class="cv__end">
      <span>Open to remote roles · Glasgow, UK</span>
      <a href="https://www.linkedin.com/in/colin-cheung/"
        >Let's talk <span aria-hidden="true">↗</span></a
      >
    </p>
  </article>
</Base>

<style>
  .cv {
    max-width: var(--w-page);
    margin: 0 auto;
  }

  /* ---------------- masthead ---------------- */
  .cv__head {
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }
  .cv__kicker {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent-soft);
  }
  .cv__name {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 800;
    font-size: clamp(2.4rem, 8vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .cv__role {
    margin: 0.9rem 0 0;
    font-family: var(--mono);
    font-size: clamp(0.8rem, 1.4vw, 0.9rem);
    letter-spacing: 0.03em;
    color: var(--muted);
  }
  .cv__lede {
    margin: 1.6rem 0 0;
    max-width: 74ch;
    font-family: var(--grotesk);
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .cv__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin: 2rem 0 0;
  }
  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.01em;
  }
  .cv__contact a {
    padding-bottom: 2px;
    color: var(--muted);
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .cv__contact a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* ---------------- section scaffold ---------------- */
  .cv__sec {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .cv__sec-head {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--accent-soft);
  }

  /* ---------------- experience timeline ---------------- */
  .xp__list {
    --rail: 5.75rem;
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xp__list::before {
    content: "";
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: var(--rail);
    width: 1px;
    background: var(--line);
  }
  .role {
    --pad: clamp(1.4rem, 3vw, 2.1rem);
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    padding: var(--pad) 0;
  }
  .xp__item:first-child .role {
    padding-top: 0.2rem;
  }
  .role__node {
    position: absolute;
    left: var(--rail);
    top: calc(var(--pad) + 0.5rem);
    width: 9px;
    height: 9px;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--faint);
    z-index: 1;
  }
  .xp__item:first-child .role__node {
    top: 0.7rem;
  }
  .role--current .role__node {
    border-color: var(--accent);
    box-shadow: var(--ring);
  }
  .role__when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    padding-top: 0.02rem;
    padding-right: 0.95rem;
    font-variant-numeric: tabular-nums;
  }
  .role__date {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .role__mon {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .role__yr {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent-soft);
  }
  .role__now {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
  }
  .role__date--start .role__yr {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--muted);
  }
  .role__link {
    display: none;
    width: 1px;
    height: 0.6rem;
    margin: 0.05rem 0;
    background: var(--line);
  }
  .role__body {
    min-width: 0;
  }
  .role__co {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .role__pos {
    margin: 0.25rem 0 0;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .role__ctx {
    margin: 0.75rem 0 0;
    max-width: 72ch;
    font-family: var(--grotesk);
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .role__points {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  .role__point {
    position: relative;
    padding-left: 1.15rem;
    max-width: 74ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }
  .role__point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: color-mix(in oklch, var(--accent) 65%, transparent);
  }
  .hl {
    color: var(--accent-soft);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .role__stack {
    margin: 0.95rem 0 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }

  /* ---------------- skills ---------------- */
  .skills {
    display: grid;
    gap: 0;
  }
  .skill {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1.25rem;
    align-items: baseline;
    padding: clamp(0.7rem, 1.6vw, 0.95rem) 0;
    border-top: 1px solid var(--line);
  }
  .skill:last-child {
    border-bottom: 1px solid var(--line);
  }
  .skill__label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--accent-soft);
  }
  .skill__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    padding: 0.18rem 0.62rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* ---------------- lower: education + projects ---------------- */
  .cv__lower {
    display: grid;
    gap: clamp(0.5rem, 2vw, 1rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (min-width: 900px) {
    .cv__lower {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .edu__school {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .edu__meta {
    margin: 0.35rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .edu__degree {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin: 1rem 0 0;
    font-family: var(--grotesk);
    font-weight: 500;
    font-size: 1rem;
    color: var(--ink);
  }
  .edu__note {
    margin: 0.75rem 0 0;
    max-width: 48ch;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .proj {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(1.3rem, 2.5vw, 1.8rem);
  }
  .proj__name {
    margin: 0;
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .proj__name a {
    color: inherit;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .proj__name a:hover {
    border-color: var(--accent);
  }
  .proj__desc {
    margin: 0.35rem 0 0;
    max-width: 54ch;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .proj__stack {
    margin: 0.45rem 0 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }

  /* ---------------- end cap ---------------- */
  .cv__end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }
  .cv__end a {
    color: var(--accent-soft);
    border-bottom: 1px solid var(--accent-line);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .cv__end a:hover {
    border-color: var(--accent);
