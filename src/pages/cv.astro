---
// CV — terminal-native résumé for colincheung.dev.
// Same dark shell, cyan accent, Bricolage + JetBrains Mono as the rest of the
// site (see src/styles/terminal.css and DESIGN.md). Content lives here as typed
// data so the markup can highlight the metric in every line — the number is the
// accent, the prose stays muted. Prints clean to ink-on-white via @media print.
import Base from "../layouts/Base.astro";

const name = "Colin Cheung";
const role = "Senior Software Engineer · 8+ years · Glasgow, UK — remote";
const lede =
  "I architect scalable, high-impact full-stack systems in TypeScript, Node.js, React and AWS. I lead migrations, mentor engineers, and make systems boring on purpose — resilient, observable, and cheap to run.";

const contact = [
  { label: "colincheung25@gmail.com", href: "mailto:colincheung25@gmail.com" },
  { label: "linkedin.com/in/colin-cheung", href: "https://www.linkedin.com/in/colin-cheung/" },
  { label: "github.com/ColinCee", href: "https://github.com/ColinCee" },
];

type Point = { pre: string; hl?: string; post?: string };
type Role = {
  co: string;
  pos: string;
  yr: string;
  span: string;
  current?: boolean;
  ctx: string;
  points: Point[];
  stack: string[];
};

const experience: Role[] = [
  {
    co: "EDF Energy",
    pos: "Senior Software Engineer · Contract",
    yr: "2023",
    span: "Apr 2023 — Now",
    current: true,
    ctx: "Scaling solutions across Customer Complaints and Debt Collection.",
    points: [
      {
        pre: "Led the CI/CD migration from AWS CodePipeline to GitHub Actions for a large Turborepo monorepo, ",
        hl: "cutting build + test cycles from 20 → 5 minutes",
        post: ".",
      },
      {
        pre: "Migrated the codebase from JavaScript to TypeScript and added Zod runtime validation, ",
        hl: "eliminating a class of runtime errors",
        post: " with strict static and data checks.",
      },
      {
        pre: "Extended the debt-recovery state machine with new customer journeys via its internal DSL, ",
        hl: "directly contributing to significant debt recovered",
        post: ".",
      },
      {
        pre: "Built a secure, high-performance React self-service portal over critical ETL outputs, ",
        hl: "eliminating hours of daily ad-hoc dev requests",
        post: ".",
      },
      {
        pre: "Architected event-driven microservices for B2B Debt Collection Agency integrations, automating the full data-exchange cycle to ",
        hl: "engage high-debt customers end-to-end",
        post: ".",
      },
      {
        pre: "Enabled DynamoDB Point-in-Time Recovery and drove cost optimization, ",
        hl: "saving several thousand USD / month",
        post: " on AWS spend.",
      },
    ],
    stack: ["TypeScript", "Node.js", "AWS", "React", "React Query", "Zod", "GitHub Actions"],
  },
  {
    co: "BBC",
    pos: "Senior Software Engineer · Contract",
    yr: "2022",
    span: "Nov 2022 — Apr 2023",
    ctx: "Lifted developer productivity by improving internal engineering tooling.",
    points: [
      {
        pre: "Built a serverless data pipeline with AWS CDK to track build-failure statistics, ",
        hl: "enabling data-driven CI/CD optimization",
        post: ".",
      },
      {
        pre: "Automated PR comments with code-coverage reports, ",
        hl: "cutting CI-log debugging time by up to 90%",
        post: ".",
      },
    ],
    stack: ["Node.js", "React", "AWS CDK", "DynamoDB", "CI/CD"],
  },
  {
    co: "Hopper",
    pos: "Software Engineer",
    yr: "2022",
    span: "Mar 2022 — Oct 2022",
    ctx: "Scaled customer-service platforms through hyper-growth.",
    points: [
      {
        pre: "Launched cross-vertical VIP support features, ",
        hl: "lifting service visibility >200% and driving a 50% revenue uplift",
        post: ".",
      },
      {
        pre: "Built and maintained Scala backend microservices serving ",
        hl: "100k+ daily requests",
        post: " over gRPC.",
      },
      {
        pre: "Implemented multi-tenancy with gRPC and GCP Pub/Sub for scalable async messaging.",
      },
      {
        pre: "Established SLOs, monitoring and alerting in Datadog via Terraform (IaC) for high availability.",
      },
    ],
    stack: ["Scala", "Kubernetes", "GCP Pub/Sub", "gRPC", "React", "Terraform", "Datadog"],
  },
  {
    co: "Hometree",
    pos: "Senior Software Engineer",
    yr: "2021",
    span: "Jun 2021 — Mar 2022",
    ctx: "Led full-stack initiatives and mentored engineers in a fast-paced startup.",
    points: [
      {
        pre: "",
        hl: "Led the greenfield rebuild of a business-critical legacy checkout",
        post: " in React (Hooks) + TypeScript, improving UX, performance and maintainability.",
      },
      {
        pre: "Embedded modern practices — E2E testing (Cypress), IaC via Serverless Stack, CloudWatch alarms and Buildkite CI/CD.",
      },
      {
        pre: "Migrated to ",
        hl: "AWS RDS Proxy and MikroORM",
        post: ", hardening database security and transaction management.",
      },
    ],
    stack: ["React", "Node.js", "TypeScript", "AWS", "Cypress", "Buildkite", "MikroORM"],
  },
  {
    co: "Skyscanner",
    pos: "Software Engineer",
    yr: "2020",
    span: "Feb 2020 — Apr 2021",
    ctx: "Built HR automation tooling over sensitive employee data.",
    points: [
      {
        pre: "Engineered HRMS → Active Directory sync (Lambda, SQS), ",
        hl: "cutting update times from 8 hours → 2 minutes",
        post: ".",
      },
      { pre: "Built an AWS serverless Slack chatbot for structured HR feedback." },
    ],
