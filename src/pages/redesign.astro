			.t-row__desc { color: var(--muted); line-height: 1.55; max-width: 60ch; }
			.t-row__date { font-family: var(--mono); font-size: 0.74rem; color: var(--muted); white-space: nowrap; }
			.t-foot { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; max-width: 1100px; margin: 0 auto; padding: 1.6rem 0 2.6rem; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 0.74rem; color: var(--muted); }

			/* ===================== 03 · SWITCHBOARD ===================== */
			.concept--sb {
				--bg: oklch(0.96 0.022 285); --surface: oklch(0.99 0.01 285);
				--ink: oklch(0.23 0.04 290); --muted: oklch(0.45 0.04 290);
				--line: oklch(0.86 0.03 285); --accent: oklch(0.64 0.2 18);
				--accent2: oklch(0.55 0.16 280); --accent-ink: oklch(0.99 0.02 18);
				background: radial-gradient(60rem 40rem at 80% -10%, color-mix(in oklch, var(--accent2) 18%, transparent), transparent 60%), var(--bg);
				color: var(--ink); min-height: 100vh; padding: 1.4rem clamp(1rem, 5vw, 4rem) 0;
			}
			.s-nav { display: flex; align-items: center; justify-content: space-between; max-width: 1040px; margin: 0 auto; padding-bottom: clamp(2rem, 6vw, 4rem); }
