			.t-writing__head a { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); }
			.t-row { display: grid; grid-template-columns: auto 1fr auto; gap: 1.4rem; align-items: baseline; padding: 1.8rem 0; border-top: 1px solid var(--line); transition: background-color 0.2s ease; }
			.t-row:hover { background: color-mix(in oklch, var(--accent) 6%, transparent); }
			.t-row__i { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); }
