			.t-cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; }
			.t-btn { background: var(--ink); color: var(--bg); font-weight: 600; padding: 0.85rem 1.5rem; border-radius: 10px; transition: transform 0.18s ease; }
			.t-btn:hover { transform: translateY(-2px); }
			.t-link { font-family: var(--mono); font-size: 0.82rem; color: var(--muted); }
			.t-link:hover { color: var(--accent); }
			.t-band { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1100px; margin: clamp(2rem, 5vw, 3.5rem) auto; border-block: 1px solid var(--line); }
			.t-band__cell { padding: clamp(1.4rem, 3vw, 2.2rem) 0.5rem; text-align: left; }
			.t-band__cell + .t-band__cell { border-left: 1px solid var(--line); padding-left: clamp(1rem, 2vw, 1.6rem); }
			.t-band__n { display: block; font-weight: 800; font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: -0.03em; }
			.t-band__l { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.12em; color: var(--muted); }
			.t-writing { max-width: 1100px; margin: 0 auto; padding-bottom: clamp(3rem, 7vw, 5rem); }
