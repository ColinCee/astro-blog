			.s-cta { color: var(--accent-ink); background: var(--ink); padding: 0.5rem 1rem; border-radius: 999px; }
			.s-hero { position: relative; max-width: 1040px; margin: 0 auto; padding-bottom: clamp(2rem, 5vw, 3.5rem); animation: riseIn 0.6s ease-out both; }
			.s-pill { display: inline-block; font-family: var(--mono); font-size: 0.74rem; background: var(--surface); border: 1px solid var(--line); padding: 0.45rem 0.9rem; border-radius: 999px; margin-bottom: 1.6rem; }
			.s-title { font-weight: 800; font-size: clamp(2.6rem, 8.5vw, 5.2rem); line-height: 0.96; letter-spacing: -0.035em; text-wrap: balance; max-width: 16ch; }
			.s-title em { font-style: italic; color: var(--accent); }
			.s-lede { margin: 1.6rem 0 2rem; max-width: 48ch; font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.6; color: var(--muted); }
			.s-cta-row { display: flex; flex-wrap: wrap; gap: 0.7rem; }
			.s-btn { background: var(--surface); border: 1px solid var(--line); padding: 0.8rem 1.3rem; border-radius: 999px; font-weight: 600; transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1); }
			.s-btn:hover { transform: translateY(-3px); }
			.s-btn--primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
			.s-dialpad { position: absolute; top: 0; right: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; width: 168px; }
			.s-key { display: grid; place-items: center; aspect-ratio: 1; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; font-family: var(--mono); font-size: 0.9rem; color: var(--muted); transition: transform 0.16s ease, background-color 0.16s ease, color 0.16s ease; }
			.s-key:hover { transform: translateY(-2px) rotate(-3deg); background: var(--accent); color: var(--accent-ink); }
			.s-chips { display: flex; flex-wrap: wrap; gap: 0.7rem; max-width: 1040px; margin: 1.5rem auto clamp(2.5rem, 6vw, 4rem); }
			.s-chip { display: inline-flex; align-items: baseline; gap: 0.5rem; background: var(--surface); border: 1px solid var(--line); padding: 0.6rem 1rem; border-radius: 999px; font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.08em; color: var(--muted); }
			.s-chip b { font-family: var(--grotesk); font-size: 1.2rem; letter-spacing: -0.02em; color: var(--accent2); }
			.s-writing { max-width: 1040px; margin: 0 auto; padding-bottom: clamp(3rem, 7vw, 5rem); }
			.s-writing h2 { font-weight: 800; font-size: clamp(1.5rem, 3.5vw, 2.2rem); letter-spacing: -0.02em; margin-bottom: 1.4rem; }
			.s-posts { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
			.s-card { display: flex; flex-direction: column; gap: 0.6rem; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 1.5rem; transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1); }
			.s-card:hover { transform: translateY(-4px); }
			.s-card__tag { align-self: flex-start; font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.1em; color: var(--accent-ink); background: var(--accent2); padding: 0.25rem 0.55rem; border-radius: 6px; }
			.s-card__title { font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; line-height: 1.15; }
			.s-card__desc { color: var(--muted); line-height: 1.55; font-size: 0.95rem; }
			.s-card__foot { display: flex; justify-content: space-between; margin-top: auto; padding-top: 0.5rem; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }
			.s-card__foot i { font-style: normal; color: var(--accent); }
			.s-foot { max-width: 1040px; margin: 0 auto; padding: 1.6rem 0 2.6rem; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 0.74rem; color: var(--muted); text-align: center; }

			/* ===================== responsive ===================== */
			@media (max-width: 860px) {
				.d-hero { grid-template-columns: 1fr; }
				.d-stats { grid-template-columns: repeat(2, 1fr); }
				.t-band { grid-template-columns: repeat(2, 1fr); }
				.t-band__cell:nth-child(3) { border-left: 0; padding-left: 0.5rem; }
				.s-dialpad { display: none; }
				.d-links, .d-badge { display: none; }
			}
			@media (max-width: 520px) {
