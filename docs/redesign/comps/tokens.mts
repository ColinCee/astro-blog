// OKLCH -> sRGB hex, with gamut clamp by reducing chroma
const lin=(c)=>c<=.0031308?12.92*c:1.055*Math.pow(c,1/2.4)-.055;
function oklch2rgb(L,C,h){const a=C*Math.cos(h*Math.PI/180),b=C*Math.sin(h*Math.PI/180);
 const l_=L+.3963377774*a+.2158037573*b,m_=L-.1055613458*a-.0638541728*b,s_=L-.0894841775*a-1.291485548*b;
 const l=l_**3,m=m_**3,s=s_**3;
 return [4.0767416621*l-3.3077115913*m+.2309699292*s,-1.2684380046*l+2.6097574011*m-.3413193965*s,-.0041960863*l-.7034186147*m+1.707614701*s];}
function hex(L,C,h){let c=C;for(let i=0;i<60;i++){const rgb=oklch2rgb(L,c,h);if(rgb.every(v=>v>=-0.0005&&v<=1.0005))return '#'+rgb.map(v=>Math.round(Math.min(1,Math.max(0,lin(v)))*255).toString(16).padStart(2,'0')).join('');c*=.95;}return '#000000';}
const lum=h=>{const c=[1,3,5].map(i=>parseInt(h.slice(i,i+2),16)/255).map(v=>v<=.03928?v/12.92:((v+.055)/1.055)**2.4);return .2126*c[0]+.7152*c[1]+.0722*c[2]};
const cr=(a,b)=>{const [x,y]=[lum(a),lum(b)].sort((p,q)=>q-p);return (x+.05)/(y+.05)};

// accent: violet chosen 30 Oct 2026 over blue 262, indigo 278, sky 235, tomato 35 and orange 55; purple 308 since 31 Oct
const NH=255, AH=298, OKH=150, WH=70, DH=25;
// neutral: [L light, L dark, chroma]
const N=[[.993,.16,.003],[.982,.195,.003],[.962,.23,.004],[.94,.26,.005],[.915,.29,.006],[.885,.325,.007],[.84,.385,.008],[.76,.47,.010],[.62,.62,.012],[.49,.72,.012],[.43,.78,.012],[.22,.95,.015]];
// accent: one purple spectrum, 6 even steps from a dark purple up to the accent itself, shared
// by both themes; each theme picks its jobs from it in tokens.css. It stops at the accent: the
// greys need a white end, the accent never does (31 Oct 2026: 12 steps had 8 unused; pale tints
// read pink or white). Hue 308, moved from violet 296 the same day: violet loses its colour as it
// lightens and read muted lavender in dark; 308 keeps the most colour in both themes of the hues
// clear of the status colours (blue keeps less, and reads as a default link). Each step takes the
// same share of 308's possible chroma that the violet steps took of violet's. Any other hue must
// stay outside h20-180 (research/status-accent-research.md). [L, C, H]
const V=[[.25,.066,308],[.33,.114,308],[.41,.151,308],[.49,.179,308],[.57,.216,308],[.65,.223,308]];
// status: green ok, amber warn, red danger (round 29), each at steps 3 (wash) / 9 (dot) / 11 (text)
const S={ok:[OKH,[[.955,.23,.05],[.62,.62,.17],[.47,.80,.13]]],warn:[WH,[[.96,.25,.06],[.64,.76,.16],[.50,.86,.13]]],danger:[DH,[[.955,.24,.04],[.60,.62,.20],[.50,.80,.15]]]};
// code: five syntax hues at one lightness per theme, so no token shouts over another; keywords
// share the accent's hue. Each passes 4.5:1 on the code pane. [hue, chroma], light gets 15% more
// chroma at its lower lightness (31 Oct 2026: all-grey code read as missing its colours)
const SYN={kw:[308,.17],fn:[250,.11],str:[150,.12],num:[60,.12],type:[195,.10]};
const SL={light:.50,dark:.78};
const out={light:{},dark:{}};
N.forEach(([l,d,c],i)=>{out.light['n'+(i+1)]=hex(l,c,NH);out.dark['n'+(i+1)]=hex(d,c,NH)});
V.forEach(([l,c,h],i)=>{out.light['v'+(i+1)]=out.dark['v'+(i+1)]=hex(l,c,h)});
for(const [k,[h,c]] of Object.entries(SYN)){out.light['syn-'+k]=hex(SL.light,c*1.15,h);out.dark['syn-'+k]=hex(SL.dark,c,h)}
for(const [k,[h,steps]] of Object.entries(S)){[3,9,11].forEach((s,i)=>{const [l,d,c]=steps[i];out.light[k+s]=hex(l,c,h);out.dark[k+s]=hex(d,c,h)})}
// checks: text at 4.5:1; bars and marks only need 3:1, so they are not listed
const chk=[];
for(const m of ['light','dark']){const t=out[m];
 chk.push([m,'n12 on n1',cr(t.n12,t.n1)],[m,'n11 on n2',cr(t.n11,t.n2)],[m,'n11 on n3',cr(t.n11,t.n3)],[m,'n10 on n1',cr(t.n10,t.n1)],[m,'n10 on n3',cr(t.n10,t.n3)],[m,'n10 on n5',cr(t.n10,t.n5)],...(m==='dark'?[[m,'v6 text on n1',cr(t.v6,t.n1)],[m,'v6 text on n3',cr(t.v6,t.n3)]]:[[m,'v4 text on n3',cr(t.v4,t.n3)],[m,'v4 text on n5',cr(t.v4,t.n5)]]),[m,'ok11 on ok3',cr(t.ok11,t.ok3)],[m,'ok11 on n1',cr(t.ok11,t.n1)],[m,'warn11 on warn3',cr(t.warn11,t.warn3)],[m,'warn11 on n1',cr(t.warn11,t.n1)],[m,'danger11 on danger3',cr(t.danger11,t.danger3)],[m,'danger11 on n1',cr(t.danger11,t.n1)],[m,'white on v4',cr('#ffffff',t.v4)],...Object.keys(SYN).map(k=>[m,'syn-'+k+' on pane',cr(t['syn-'+k],m==='dark'?t.n3:t.n2)]));}
chk.forEach(([m,n,v])=>console.log((v>=4.5?'ok  ':'FAIL')+' '+m.padEnd(5)+n.padEnd(16)+v.toFixed(2)));
// the site's copy: dark is the default, light is the toggle (src/styles/tokens.css names the roles)
const block=(t)=>Object.entries(t).map(([k,v])=>`  --${k}: ${v};`).join('\n');
// Paper is always light, whatever the screen's theme.
const site=`/* Generated by docs/redesign/comps/tokens.mts; do not edit by hand. */
:root {
${block(out.dark)}
}
:root[data-theme="light"] {
${block(out.light)}
}
@media print {
  :root:root {
${block(out.light).replace(/^/gm,'  ')}
  }
}
`;
// the comps keep their frozen scales.css and scales.json from before the accent became four shades
import('node:fs').then(fs=>{fs.writeFileSync('../../../src/styles/scales.css',site);console.log('written');});
