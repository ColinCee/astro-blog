{
  "name": "colincheung-dev",
  "description": "Colin Cheung's terminal-native personal site and engineering blog (colincheung.dev).",
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "astro-expressive-code": "0.44.3",
    "cookie": "2.0.1",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "wrangler": "4.152.0"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "check": "pnpm typecheck && biome ci . && node scripts/wrap.ts --check && astro build && wrangler deploy --dry-run && playwright test && playwright test -c playwright.speed.config.ts",
    "format": "biome check --write . && node scripts/wrap.ts",
    "test": "playwright test",
    "speed": "astro build && playwright test -c playwright.speed.config.ts",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "og": "node scripts/og/render.ts",
    "record": "node scripts/capture.ts",
    "compare": "node scripts/compare.ts",
    "screenshot": "node scripts/capture.ts --still",
    "chart": "node scripts/chart.ts",
    "typecheck": "astro sync && astro-check && tsc"
  },
  "type": "module",
  "volta": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.15.0"
}
