{
  "name": "colincheung-dev",
  "description": "Colin Cheung's terminal-native personal site and engineering blog (colincheung.dev).",
  "dependencies": {
    "@astrojs/sitemap": "3.2.1",
    "astro": "5.1.3",
    "astro-expressive-code": "^0.40.2",
    "typescript": "5.7.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "wrangler": "^4.7.0"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
