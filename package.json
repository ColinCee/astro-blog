{
  "name": "colincheung-dev",
  "description": "Colin Cheung's terminal-native personal site and engineering blog (colincheung.dev).",
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "astro-expressive-code": "0.44.3",
    "cookie": "2.0.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "wrangler": "4.152.0"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && biome check . && astro build && wrangler deploy --dry-run && playwright test",
    "format": "biome check --write .",
    "test": "playwright test",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "og": "node scripts/og/render.mjs",
    "record": "node scripts/capture.mjs",
    "compare": "node scripts/compare.mjs",
    "screenshot": "node scripts/capture.mjs --still"
  },
  "type": "module",
  "volta": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@12.15.0"
}
