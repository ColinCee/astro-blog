{
  "name": "colincheung-dev",
  "description": "Colin Cheung's terminal-native personal site and engineering blog (colincheung.dev).",
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "astro-expressive-code": "0.44.3",
    "cookie": "2.0.1",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "modern-web-guidance": "1.0.0",
    "postcss-html": "2.0.0",
    "stylelint": "18.0.0",
    "wrangler": "4.152.0"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "check": "pnpm typecheck && biome ci . && pnpm lint:css && node checks/wrap.ts --check && node checks/no-js.ts && node checks/folders.ts && pnpm legacy-scan && astro build && wrangler deploy --dry-run && playwright test && playwright test -c playwright.speed.config.ts",
    "lint:css": "stylelint \"src/**/*.{astro,css,mdx}\"",
    "format": "biome check --write . && node checks/wrap.ts",
    "test": "astro build && playwright test",
    "speed": "astro build && playwright test -c playwright.speed.config.ts",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "og": "node og/render.ts",
    "record": "node pr-media/capture.ts",
    "compare": "node pr-media/compare.ts",
    "screenshot": "node pr-media/capture.ts --still",
    "chart": "node pr-media/chart.ts",
    "legacy-scan": "modern-web-guidance legacy-scan . --json | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{if(JSON.parse(s).totalFindings!==0){console.error(s);process.exit(1)}})\"",
    "typecheck": "astro sync && astro-check && tsc"
  },
  "type": "module",
  "volta": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.15.0"
}
