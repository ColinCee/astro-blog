# Cache rules for Cloudflare. Files in /_astro/ have a content hash in their name,
# so a changed file is a new URL and the old one can be kept forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Game clips, posters and their data: they change rarely, and a day old is fine.
/blog/gvgai/*
  Cache-Control: public, max-age=86400
